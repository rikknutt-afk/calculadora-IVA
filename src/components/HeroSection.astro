---
import { useTranslations } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'es' } = Astro.props;
const { t } = useTranslations(locale);
---

<section class="hero" id="hero">
  <div class="hero-content">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-bold uppercase tracking-wider mb-2.5 shadow-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>{t('siteName', 'Calculadora IVA')} • Oficial</span>
    </div>

    <h1 class="hero-title" id="heroTitle" set:html={t('heroTitle')} />

    <p class="hero-subtitle" id="heroSubtitle" set:html={t('heroSubtitle')} />
  </div>
</section>

