---
import { useTranslations } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'es' } = Astro.props;
const { t } = useTranslations(locale);
---

<section class="content-section" id="calcular-iva">
  <div class="section-container">
    <h2 class="section-title" set:html={t('calcularIvaTitle', 'Calcular <span class="gradient-text">IVA</span>')} />
    <p class="section-subtitle">
      {t('calcularIvaSubtitle', 'La calculadora de IVA permite calcular el Impuesto al Valor Agregado (IVA) de 3 formas: añadir IVA a un precio sin IVA, quitar IVA de un precio con IVA incluido, o calcular el IVA inverso desde un total')}
    </p>

    <!-- Interactive 3-Method Flow Diagram -->
    <div class="methods-grid" id="methodsGrid">
      <!-- Method 1: Add IVA -->
      <div class="method-card" id="methodAdd" data-method="add">
        <div class="method-icon-wrapper">
          <div class="method-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          <span class="method-number">01</span>
        </div>
        <h3 class="method-title">{t('method1Title', 'Añadir IVA a un precio')}</h3>
        <p class="method-desc">
          {t('method1Desc', 'Parte de un precio sin IVA (base imponible) y suma el Impuesto al Valor Agregado para obtener el precio con IVA incluido.')}
        </p>
        <div class="method-formula">
          <span class="method-formula-var">{t('amountWithoutVat', 'Precio sin IVA')}</span>
          <span class="method-formula-op">×</span>
          <span class="method-formula-var">1,21</span>
          <span class="method-formula-op">=</span>
          <span class="method-formula-result">{t('amountWithVat', 'Precio con IVA')}</span>
        </div>
        <div class="method-example">
          <span class="method-example-label">Ejemplo</span>
          <span>100 € × 1,21 = <strong>121,00 €</strong></span>
        </div>
      </div>

      <!-- Method 2: Remove IVA -->
      <div class="method-card" id="methodRemove" data-method="remove">
        <div class="method-icon-wrapper">
          <div class="method-icon method-icon-remove">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          <span class="method-number">02</span>
        </div>
        <h3 class="method-title">{t('method2Title', 'Quitar IVA de un precio')}</h3>
        <p class="method-desc">
          {t('method2Desc', 'Parte de un precio con IVA incluido y extrae la base imponible y el monto de IVA por separado. Se usa para calcular IVA inverso.')}
        </p>
        <div class="method-formula">
          <span class="method-formula-var">{t('amountWithVat', 'Precio con IVA')}</span>
          <span class="method-formula-op">÷</span>
          <span class="method-formula-var">1,21</span>
          <span class="method-formula-op">=</span>
          <span class="method-formula-result">{t('basePrice', 'Base imponible')}</span>
        </div>
        <div class="method-example">
          <span class="method-example-label">Ejemplo</span>
          <span>121 € ÷ 1,21 = <strong>100,00 €</strong></span>
        </div>
      </div>

      <!-- Method 3: Invoice Breakdown -->
      <div class="method-card" id="methodDesglose" data-method="desglose">
        <div class="method-icon-wrapper">
          <div class="method-icon method-icon-desglose">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
          </div>
          <span class="method-number">03</span>
        </div>
        <h3 class="method-title">{t('method3Title', 'Desglose de IVA en factura')}</h3>
        <p class="method-desc">
          {t('method3Desc', 'Calcula el desglose de IVA para factura electrónica: base imponible, monto de IVA al tipo correspondiente e importe total con IVA.')}
        </p>
        <div class="method-formula">
          <span class="method-formula-var">{t('basePrice', 'Base')}</span>
          <span class="method-formula-op">×</span>
          <span class="method-formula-var">21/100</span>
          <span class="method-formula-op">=</span>
          <span class="method-formula-result">{t('vatAmount', 'Monto IVA')}</span>
        </div>
        <div class="method-example">
          <span class="method-example-label">Ejemplo</span>
          <span>1.000 € × 0,21 = <strong>210,00 €</strong></span>
        </div>
      </div>
    </div>
  </div>
</section>
