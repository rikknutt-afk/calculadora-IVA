---
import siteConfig from '../config/site.json';
import { useTranslations, supportedLocales, getLocalizedUrl } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'es' } = Astro.props;
const { t } = useTranslations(locale);
const currentYear = new Date().getFullYear();
const homeUrl = getLocalizedUrl('/', locale);
---

<footer class="footer" id="mainFooter">
  <div class="footer-container">
    <div class="footer-main">
      <!-- Brand / Logo Column -->
      <div class="footer-brand-col">
        <a href={homeUrl} class="footer-logo">
          <div class="logo-icon">
            <svg width="22" height="22" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="2" width="24" height="24" rx="6" stroke="url(#logoGradFooter)" stroke-width="2.5"/>
              <text x="14" y="19" text-anchor="middle" fill="url(#logoGradFooter)" font-size="14" font-weight="700" font-family="Inter">%</text>
              <defs>
                <linearGradient id="logoGradFooter" x1="0" y1="0" x2="28" y2="28">
                  <stop stop-color="#4f46e5"/>
                  <stop offset="1" stop-color="#7c3aed"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <span class="logo-text">Calculadora <span class="logo-accent">IVA</span></span>
        </a>
        <p class="footer-tagline">Cálculo de IVA rápido y gratuito para España y Latinoamérica.</p>
      </div>

      <!-- Footer Navigation Grid -->
      <div class="footer-grid">
        <!-- Col 1: Herramientas -->
        <div class="footer-col" id="footerInterest">
          <h4 class="footer-col-title">Herramientas</h4>
          <ul class="footer-link-list">
            <li><a href={`${homeUrl}#calculator`} class="footer-link">Calculadora de IVA</a></li>
            <li><a href={`${homeUrl}#calcular-iva`} class="footer-link">Calcular IVA online</a></li>
            <li><a href={`${homeUrl}#formula-iva`} class="footer-link">Fórmula de IVA</a></li>
            <li><a href={`${homeUrl}#como-funciona`} class="footer-link">Cómo funciona</a></li>
            <li><a href={`${homeUrl}#iva-porcentaje`} class="footer-link">Tipos por país</a></li>
            <li><a href={`${homeUrl}#faq`} class="footer-link">FAQ</a></li>
          </ul>
        </div>

        <!-- Col 2: Por País -->
        <div class="footer-col" id="footerCountries">
          <h4 class="footer-col-title">Por País</h4>
          <ul class="footer-link-list">
            <li><a href={`${homeUrl}#iva-porcentaje`} class="footer-link">España (21%)</a></li>
            <li><a href={`${homeUrl}#iva-porcentaje`} class="footer-link">México (16%)</a></li>
            <li><a href={`${homeUrl}#iva-porcentaje`} class="footer-link">Argentina (21%)</a></li>
            <li><a href={`${homeUrl}#iva-porcentaje`} class="footer-link">Chile (19%)</a></li>
            <li><a href={`${homeUrl}#iva-porcentaje`} class="footer-link">Colombia (19%)</a></li>
            <li><a href={`${homeUrl}#iva-porcentaje`} class="footer-link">Perú (18%)</a></li>
          </ul>
        </div>

        <!-- Col 3: Destacados -->
        <div class="footer-col" id="footerHighlights">
          <h4 class="footer-col-title">Destacados</h4>
          <ul class="footer-link-list">
            <li><a href={`${homeUrl}#formula-iva`} class="footer-link">Fórmula del IVA</a></li>
            <li><a href={`${homeUrl}#calcular-iva`} class="footer-link">Añadir / Quitar IVA</a></li>
            <li><a href={`${homeUrl}#quickTable`} class="footer-link">Tabla rápida 21%</a></li>
            <li><a href={`${homeUrl}#spainRates`} class="footer-link">Tipos de IVA España</a></li>
            <li><a href={getLocalizedUrl('/blog/', locale)} class="footer-link">Blog & Guías</a></li>
          </ul>
        </div>

        <!-- Col 4: Legal & Idiomas -->
        <div class="footer-col" id="footerLegal">
          <h4 class="footer-col-title">Legal & Info</h4>
          <ul class="footer-link-list mb-3">
            <li><a href={getLocalizedUrl('/about-us/', locale)} class="footer-link">Sobre Nosotros</a></li>
            <li><a href={getLocalizedUrl('/contact-us/', locale)} class="footer-link">Contacto</a></li>
            <li><a href={getLocalizedUrl('/privacy/', locale)} class="footer-link">Privacidad</a></li>
            <li><a href={getLocalizedUrl('/terms/', locale)} class="footer-link">Términos</a></li>
            <li><a href={getLocalizedUrl('/sitemap/', locale)} class="footer-link">Mapa del Sitio</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Language Selector Pills -->
    {supportedLocales.length > 1 && (
      <div class="pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between flex-wrap gap-2">
        <span class="text-xs font-bold text-[var(--text-tertiary)] uppercase tracking-wider">{t('language')}:</span>
        <div class="flex items-center gap-1.5 flex-wrap">
          {supportedLocales.map((loc) => (
            <a
              href={getLocalizedUrl('/', loc.code)}
              class={`text-[11px] px-2 py-0.5 rounded transition-colors ${
                loc.code === locale
                  ? 'bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 font-bold border border-indigo-500/30'
                  : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-slate-500/10'
              }`}
            >
              {loc.name}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Bottom Copyright & Disclaimer -->
    <div class="footer-bottom">
      <p class="footer-copyright">&copy; {currentYear} Calculadora IVA. {t('footer.rights')}</p>
      <p class="footer-disclaimer">
        {t('footer.disclaimer')}
      </p>
    </div>
  </div>
</footer>
