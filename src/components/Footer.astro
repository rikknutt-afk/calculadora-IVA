---
import siteConfig from '../config/site.json';
import navConfig from '../config/navigation.json';
import { useTranslations, supportedLocales, getLocalizedUrl } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const { t } = useTranslations(locale);
const currentYear = new Date().getFullYear();

// Social links presence check
const hasSocial = Boolean(
  siteConfig.social?.facebook ||
  siteConfig.social?.twitter ||
  siteConfig.social?.linkedin ||
  siteConfig.social?.pinterest
);
---

<footer class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--bg-secondary)] relative z-10 transition-colors" id="mainFooter">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12 mb-12">
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-4">
        <a href={getLocalizedUrl('/', locale)} class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-base shadow-sm">
            %
          </div>
          <span class="font-display font-bold text-xl tracking-tight text-[var(--text-primary)]">
            Calculadora <span class="gradient-text font-extrabold">IVA</span>
          </span>
        </a>
        <p class="text-sm text-[var(--text-secondary)] max-w-sm leading-relaxed">
          {t('footer.desc')}
        </p>

        <!-- Conditional Social Block -->
        {hasSocial && (
          <div class="flex items-center gap-3 pt-2">
            {siteConfig.social?.facebook && (
              <a href={siteConfig.social.facebook} target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-tertiary)] text-[var(--text-secondary)] hover:text-indigo-600 hover:border-[var(--border-accent)] transition-all" aria-label="Facebook">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
              </a>
            )}
            {siteConfig.social?.twitter && (
              <a href={siteConfig.social.twitter} target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-tertiary)] text-[var(--text-secondary)] hover:text-indigo-600 hover:border-[var(--border-accent)] transition-all" aria-label="Twitter / X">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            )}
            {siteConfig.social?.linkedin && (
              <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-tertiary)] text-[var(--text-secondary)] hover:text-indigo-600 hover:border-[var(--border-accent)] transition-all" aria-label="LinkedIn">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
            )}
            {siteConfig.social?.pinterest && (
              <a href={siteConfig.social.pinterest} target="_blank" rel="noopener noreferrer" class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-tertiary)] text-[var(--text-secondary)] hover:text-indigo-600 hover:border-[var(--border-accent)] transition-all" aria-label="Pinterest">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.291 1.199-.334 1.357-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.546.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
              </a>
            )}
          </div>
        )}
      </div>

      <!-- Navigation links -->
      <div>
        <h4 class="font-display font-bold text-sm text-[var(--text-primary)] uppercase tracking-wider mb-4">
          {t('nav.sitemap')}
        </h4>
        <ul class="space-y-2.5">
          {navConfig.footerNav.slice(0, 5).map((item) => (
            <li>
              <a
                href={getLocalizedUrl(item.href, locale)}
                class="text-sm text-[var(--text-secondary)] hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
              >
                {t(item.key)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Language Selector Column -->
      <div>
        <h4 class="font-display font-bold text-sm text-[var(--text-primary)] uppercase tracking-wider mb-4">
          {t('language')}
        </h4>
        <div class="grid grid-cols-2 gap-1.5 max-h-48 overflow-y-auto pr-1">
          {supportedLocales.map((loc) => (
            <a
              href={getLocalizedUrl('/', loc.code)}
              class={`text-xs px-2 py-1.5 rounded border transition-colors ${
                loc.code === locale
                  ? 'border-indigo-500 bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold'
                  : 'border-[var(--border-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-accent)] hover:text-[var(--text-primary)]'
              }`}
            >
              {loc.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="pt-8 border-t border-[var(--border-subtle)] flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[var(--text-tertiary)]">
      <p>&copy; {currentYear} {siteConfig.siteName}. {t('footer.rights')}</p>
      <p class="italic text-center md:text-right max-w-lg">{t('footer.disclaimer')}</p>
    </div>
  </div>
</footer>
