---
import { useTranslations } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'es' } = Astro.props;
const { t } = useTranslations(locale);

const countries = [
  { flag: '🇺🇾', name: 'Uruguay', rate: 22, width: '100%', auth: 'DGI' },
  { flag: '🇪🇸', name: 'España', rate: 21, width: '95.5%', auth: 'AEAT' },
  { flag: '🇦🇷', name: 'Argentina', rate: 21, width: '95.5%', auth: 'AFIP' },
  { flag: '🇨🇱', name: 'Chile', rate: 19, width: '86.4%', auth: 'SII' },
  { flag: '🇨🇴', name: 'Colombia', rate: 19, width: '86.4%', auth: 'DIAN' },
  { flag: '🇵🇪', name: 'Perú', rate: 18, width: '81.8%', auth: 'SUNAT' },
  { flag: '🇩🇴', name: 'R. Dominicana', rate: 18, width: '81.8%', auth: 'DGII' },
  { flag: '🇲🇽', name: 'México', rate: 16, width: '72.7%', auth: 'SAT' },
  { flag: '🇻🇪', name: 'Venezuela', rate: 16, width: '72.7%', auth: 'SENIAT' },
  { flag: '🇪🇨', name: 'Ecuador', rate: 15, width: '68.2%', auth: 'SRI' },
  { flag: '🇭🇳', name: 'Honduras', rate: 15, width: '68.2%', auth: 'SAR' },
  { flag: '🇳🇮', name: 'Nicaragua', rate: 15, width: '68.2%', auth: 'DGI' },
  { flag: '🇧🇴', name: 'Bolivia', rate: 13, width: '59.1%', auth: 'SIN' },
  { flag: '🇨🇷', name: 'Costa Rica', rate: 13, width: '59.1%', auth: 'Ministerio de Hacienda' },
  { flag: '🇸🇻', name: 'El Salvador', rate: 13, width: '59.1%', auth: 'Ministerio de Hacienda' },
  { flag: '🇬🇹', name: 'Guatemala', rate: 12, width: '54.5%', auth: 'SAT' },
  { flag: '🇵🇾', name: 'Paraguay', rate: 10, width: '45.5%', auth: 'SET' },
  { flag: '🇵🇦', name: 'Panamá', rate: 7, width: '31.8%', auth: 'DGI' },
];
---

<section class="content-section content-section-alt" id="iva-porcentaje">
  <div class="section-container section-container-wide">
    <h2 class="section-title" set:html={t('ratesSectionTitle', 'IVA <span class="gradient-text">Percentage</span>')} />
    <p class="section-subtitle">
      {t('ratesSectionSubtitle', 'Tipos de IVA en España y Latinoamérica: porcentaje de IVA por país con las autoridades fiscales que regulan el Impuesto al Valor Agregado')}
    </p>

    <!-- Interactive Country Rate Comparison Chart -->
    <div class="rate-chart-container" id="rateChart">
      <h3 class="rate-chart-title">Comparación de tipos de IVA por país</h3>
      <div class="rate-chart-bars" id="rateChartBars">
        {countries.map((c) => (
          <div class="rate-chart-bar-item" data-country={c.name} data-rate={c.rate}>
            <span class="rate-chart-country">{c.flag} {c.name}</span>
            <div class="rate-chart-bar-track">
              <div class="rate-chart-bar-fill" style={`--bar-width: ${c.width};`} data-authority={c.auth}></div>
            </div>
            <span class="rate-chart-pct">{c.rate}%</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Spain IVA Rate Cards -->
    <div class="spain-rates-mini" id="spainRates">
      <h3 class="spain-rates-title">{t('spainRatesTitle', 'Tipos de IVA en España: todo lo que necesitas saber')}</h3>
      <div class="spain-rates-grid">
        <div class="spain-rate-card spain-rate-general">
          <div class="spain-rate-pct">21%</div>
          <div class="spain-rate-name">{t('general', 'General')} (21%)</div>
          <div class="spain-rate-desc">Electrónica, ropa, servicios profesionales, vehículos</div>
        </div>
        <div class="spain-rate-card spain-rate-reduced">
          <div class="spain-rate-pct">10%</div>
          <div class="spain-rate-name">{t('reduced', 'Reducido')} (10%)</div>
          <div class="spain-rate-desc">Alimentación, transporte, hostelería, vivienda nueva</div>
        </div>
        <div class="spain-rate-card spain-rate-super">
          <div class="spain-rate-pct">4%</div>
          <div class="spain-rate-name">{t('superReduced', 'Superreducido')} (4%)</div>
          <div class="spain-rate-desc">Pan, leche, libros, medicamentos, prótesis</div>
        </div>
      </div>
    </div>
  </div>
</section>
