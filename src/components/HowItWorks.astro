---
import { useTranslations } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'es' } = Astro.props;
const { t } = useTranslations(locale);
---

<section class="section-block" id="como-funciona">
  <div class="section-container">
    <div class="text-center">
      <span class="section-badge">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
        <span>{t('walkthroughBadge', 'Paso a Paso')}</span>
      </span>
    </div>
    <h2 class="section-title" set:html={t('howItWorksTitle', '¿Cómo funciona la calculadora de <span class="gradient-text">IVA</span>?')} />
    <p class="section-subtitle">
      {t('howItWorksSubtitle', 'La calculadora de IVA en línea funciona en 4 pasos: seleccionar el modo de cálculo, introducir el importe, elegir el porcentaje de IVA y obtener el resultado')}
    </p>

    <!-- Interactive 4-Step Walkthrough -->
    <div class="walkthrough-steps" id="walkthroughSteps">
      <!-- Step 1 -->
      <div class="walkthrough-step" data-step="1">
        <div class="walkthrough-step-connector"></div>
        <div class="walkthrough-step-number">1</div>
        <div class="walkthrough-step-content">
          <div class="walkthrough-step-icon">🔄</div>
          <h3 class="walkthrough-step-title">{t('step1Title', '1. Selecciona el modo')}</h3>
          <p class="walkthrough-step-desc">
            {t('step1Desc', 'Elige «Añadir IVA» para calcular el precio con IVA desde una base imponible, o «Quitar IVA» para extraer la base imponible de un precio con IVA incluido.')}
          </p>
          <div class="walkthrough-mini-toggle" id="miniToggle1">
            <button type="button" class="mini-toggle-btn mini-toggle-active" data-mini="add">+ {t('modeAdd', 'Añadir IVA')}</button>
            <button type="button" class="mini-toggle-btn" data-mini="remove">− {t('modeRemove', 'Quitar IVA')}</button>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="walkthrough-step" data-step="2">
        <div class="walkthrough-step-connector"></div>
        <div class="walkthrough-step-number">2</div>
        <div class="walkthrough-step-content">
          <div class="walkthrough-step-icon">💶</div>
          <h3 class="walkthrough-step-title">{t('step2Title', '2. Introduce el importe')}</h3>
          <p class="walkthrough-step-desc">
            {t('step2Desc', 'Escribe la cantidad en el campo de monto. La calculadora acepta números con coma o punto decimal.')}
          </p>
          <div class="walkthrough-mini-input">
            <span class="mini-input-label">{t('amountWithoutVat', 'Importe')}</span>
            <div class="mini-input-box">1.000,00 <span class="mini-input-currency">€</span></div>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="walkthrough-step" data-step="3">
        <div class="walkthrough-step-connector"></div>
        <div class="walkthrough-step-number">3</div>
        <div class="walkthrough-step-content">
          <div class="walkthrough-step-icon">📊</div>
          <h3 class="walkthrough-step-title">{t('step3Title', '3. Elige el porcentaje de IVA')}</h3>
          <p class="walkthrough-step-desc">
            {t('step3Desc', 'Selecciona el tipo de IVA: 4% (superreducido), 10% (reducido), 21% (general) o un porcentaje a medida.')}
          </p>
          <div class="walkthrough-mini-rates" id="miniRates">
            <button type="button" class="mini-rate-btn" data-minirate="4">4%</button>
            <button type="button" class="mini-rate-btn" data-minirate="10">10%</button>
            <button type="button" class="mini-rate-btn mini-rate-active" data-minirate="21">21%</button>
          </div>
        </div>
      </div>

      <!-- Step 4 -->
      <div class="walkthrough-step" data-step="4">
        <div class="walkthrough-step-connector"></div>
        <div class="walkthrough-step-number">4</div>
        <div class="walkthrough-step-content">
          <div class="walkthrough-step-icon">✅</div>
          <h3 class="walkthrough-step-title">{t('step4Title', '4. Obtén el resultado')}</h3>
          <p class="walkthrough-step-desc">
            {t('step4Desc', 'Visualiza la base imponible, la cuota de IVA y el precio final con IVA en tiempo real con gráfico de desglose.')}
          </p>
          <div class="walkthrough-mini-result" id="miniResult">
            <div class="mini-result-row">
              <span>{t('basePrice', 'Base')}</span>
              <span class="mini-result-value">1.000,00 €</span>
            </div>
            <div class="mini-result-row mini-result-iva">
              <span>{t('vatAmount', 'IVA')} (21%)</span>
              <span class="mini-result-value">210,00 €</span>
            </div>
            <div class="mini-result-row mini-result-total">
              <span>{t('totalPrice', 'Total con IVA')}</span>
              <span class="mini-result-value"><strong>1.210,00 €</strong></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Mini toggle interactivity
  document.querySelectorAll('.walkthrough-mini-toggle .mini-toggle-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.walkthrough-mini-toggle');
      if (parent) {
        parent.querySelectorAll('.mini-toggle-btn').forEach(b => b.classList.remove('mini-toggle-active'));
        btn.classList.add('mini-toggle-active');
      }
    });
  });

  // Mini rate buttons interactivity
  document.querySelectorAll('.walkthrough-mini-rates .mini-rate-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const parent = btn.closest('.walkthrough-mini-rates');
      if (parent) {
        parent.querySelectorAll('.mini-rate-btn').forEach(b => b.classList.remove('mini-rate-active'));
        btn.classList.add('mini-rate-active');
      }
    });
  });
</script>
