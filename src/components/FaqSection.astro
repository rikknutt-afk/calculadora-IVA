---
import { useTranslations } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'es' } = Astro.props;
const { t, faq } = useTranslations(locale);

const quickTableData = [
  { base: '10 €', iva: '2,10 €', total: '12,10 €' },
  { base: '25 €', iva: '5,25 €', total: '30,25 €' },
  { base: '50 €', iva: '10,50 €', total: '60,50 €' },
  { base: '100 €', iva: '21,00 €', total: '121,00 €' },
  { base: '150 €', iva: '31,50 €', total: '181,50 €' },
  { base: '200 €', iva: '42,00 €', total: '242,00 €' },
  { base: '300 €', iva: '63,00 €', total: '363,00 €' },
  { base: '500 €', iva: '105,00 €', total: '605,00 €' },
  { base: '1.000 €', iva: '210,00 €', total: '1.210,00 €' },
  { base: '2.000 €', iva: '420,00 €', total: '2.420,00 €' },
  { base: '3.000 €', iva: '630,00 €', total: '3.630,00 €' },
  { base: '5.000 €', iva: '1.050,00 €', total: '6.050,00 €' },
  { base: '10.000 €', iva: '2.100,00 €', total: '12.100,00 €' },
];

const items = faq?.items || [];
---

<section class="section-block" id="faq">
  <div class="section-container">
    <h2 class="section-title" set:html={faq?.faqTitle || t('faqTitle', 'Preguntas frecuentes sobre el <span class="gradient-text">IVA</span>')} />
    <p class="section-subtitle">
      {faq?.faqSubtitle || t('faqSubtitle', 'Respuestas sobre cómo calcular el IVA, calcular IVA incluido, calcular IVA excluido y ejemplos prácticos')}
    </p>

    <div class="faq-list" id="faqList">
      {items.map((item: any, idx: number) => (
        <div class="faq-item" id={`faq${idx + 1}`}>
          <button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button">
            <span>{item.question}</span>
            <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}>
            <p set:html={item.answer} />
            {item.formula && (
              <div class="faq-formula-mini">
                <div class="faq-formula-equation">
                  <span class="faq-formula-var">{item.formula.base}</span>
                  <span class="faq-formula-op">{item.formula.rate ? '×' : '−'}</span>
                  <span class="faq-formula-var">{item.formula.rate || item.formula.minus}</span>
                  <span class="faq-formula-op">=</span>
                  <span class="faq-formula-result">{item.formula.result}</span>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Quick Reference Table -->
    <div class="quick-table-wrapper" id="quickTable">
      <h3 class="quick-table-title" set:html={t('quickTableTitle', 'Tabla de cálculo rápido de IVA <span class="gradient-text">(21%)</span>')} />
      <p class="quick-table-subtitle">
        {t('quickTableSubtitle', 'Desglose de IVA del 21% para importes comunes — base imponible, monto de IVA e importe total con IVA')}
      </p>
      <div class="quick-table-container">
        <table class="quick-table" id="quickCalcTable">
          <thead>
            <tr>
              <th>{t('thBase', 'Base imponible')}</th>
              <th>{t('thVat', 'IVA (21%)')}</th>
              <th>{t('thTotal', 'Total con IVA')}</th>
            </tr>
          </thead>
          <tbody>
            {quickTableData.map((row) => (
              <tr>
                <td>{row.base}</td>
                <td>{row.iva}</td>
                <td><strong>{row.total}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-item .faq-question').forEach(button => {
    button.addEventListener('click', () => {
      const item = button.closest('.faq-item');
      if (!item) return;
      const isOpen = item.classList.contains('open');

      // Close other accordion items
      document.querySelectorAll('.faq-item').forEach(i => {
        if (i !== item) {
          i.classList.remove('open');
          const btn = i.querySelector('.faq-question');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        }
      });

      // Toggle current item
      if (isOpen) {
        item.classList.remove('open');
        button.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
