---
import navConfig from '../config/navigation.json';
import { useTranslations, supportedLocales, getLocalizedUrl } from '../i18n/utils';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;
const { t } = useTranslations(locale);
const homeUrl = getLocalizedUrl('/', locale);
const currentLocaleObj = supportedLocales.find((l) => l.code === locale) || supportedLocales[0];
---

<header class="site-header fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="mainHeader">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 h-17 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={homeUrl} class="flex items-center gap-2.5 group transition-transform duration-200 hover:scale-[1.02]" id="headerLogo">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-base shadow-sm group-hover:shadow-indigo-500/20">
        %
      </div>
      <span class="font-display font-bold text-lg tracking-tight text-[var(--text-primary)]">
        Calculadora <span class="gradient-text font-extrabold">IVA</span>
      </span>
    </a>

    <!-- Desktop Nav & Actions -->
    <div class="hidden md:flex items-center gap-2">
      <nav class="flex items-center gap-1" aria-label="Desktop Navigation">
        {navConfig.headerNav.map((item) => {
          const isAnchor = item.href.startsWith('/#');
          const finalHref = isAnchor
            ? `${homeUrl}${item.href.replace('/', '')}`
            : getLocalizedUrl(item.href, locale);
          return (
            <a
              href={finalHref}
              class="px-3 py-1.5 rounded-lg text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-indigo-500/10 transition-colors"
            >
              {t(item.key)}
            </a>
          );
        })}
      </nav>

      <!-- Language Switcher Dropdown (Desktop) -->
      <div class="relative ml-2" id="langDropdownWrapper">
        <button
          id="langDropdownBtn"
          type="button"
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-tertiary)] text-xs font-bold text-[var(--text-primary)] hover:border-[var(--border-accent)] transition-all cursor-pointer"
          aria-expanded="false"
          aria-haspopup="true"
          title={t('language', 'Idioma')}
        >
          <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="uppercase font-extrabold">{currentLocaleObj.code}</span>
          <svg class="w-3 h-3 text-[var(--text-tertiary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="langDropdownMenu"
          class="absolute right-0 top-full mt-2 w-48 max-h-72 overflow-y-auto bg-[var(--bg-card)] border border-[var(--border-medium)] rounded-xl shadow-xl p-1.5 hidden z-50 backdrop-blur-xl"
        >
          {supportedLocales.map((loc) => (
            <a
              href={getLocalizedUrl('/', loc.code)}
              class={`flex items-center justify-between px-3 py-2 rounded-lg text-xs transition-colors ${
                loc.code === locale
                  ? 'bg-indigo-500/15 text-indigo-600 dark:text-indigo-400 font-bold'
                  : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-indigo-500/10'
              }`}
            >
              <span>{loc.name}</span>
              <span class="uppercase text-[10px] opacity-60 font-semibold">{loc.code}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Theme Switcher -->
      <button
        id="themeToggleBtn"
        type="button"
        class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-tertiary)] text-[var(--text-secondary)] hover:text-indigo-600 dark:hover:text-indigo-400 hover:border-[var(--border-accent)] transition-all cursor-pointer"
        aria-label={t('theme.toggle')}
        title={t('theme.toggle')}
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="sun-icon w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="moon-icon w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Header Actions -->
    <div class="flex items-center gap-2 md:hidden">
      <!-- Mobile Language Switcher Button -->
      <a
        href="#footerLegal"
        class="px-2.5 py-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-tertiary)] text-xs font-bold text-[var(--text-primary)] flex items-center gap-1"
        aria-label="Seleccionar idioma"
      >
        <span class="uppercase text-[11px]">{currentLocaleObj.code}</span>
      </a>

      <!-- Theme Button Mobile -->
      <button
        id="themeToggleBtnMobile"
        type="button"
        class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-tertiary)] text-[var(--text-secondary)] cursor-pointer"
        aria-label={t('theme.toggle')}
      >
        <svg class="sun-icon w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle></svg>
        <svg class="moon-icon w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>

      <!-- Hamburger Button -->
      <button
        id="mobileMenuToggle"
        type="button"
        class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] transition-transform active:scale-95 cursor-pointer"
        aria-expanded="false"
        aria-controls="mobileMenuPanel"
        aria-label="Abrir menú"
      >
        <svg id="hamburgerIcon" class="w-5 h-5 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg id="closeIcon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Overlay Panel -->
  <div
    id="mobileMenuPanel"
    class="fixed inset-x-0 top-17 bottom-0 bg-[var(--bg-primary)]/95 backdrop-blur-2xl p-6 flex flex-col justify-between hidden md:hidden border-t border-[var(--border-subtle)] z-40 transition-all"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-3" aria-label="Mobile Navigation">
      {navConfig.headerNav.map((item) => {
        const isAnchor = item.href.startsWith('/#');
        const finalHref = isAnchor
          ? `${homeUrl}${item.href.replace('/', '')}`
          : getLocalizedUrl(item.href, locale);
        return (
          <a
            href={finalHref}
            class="mobile-nav-link text-lg font-bold text-[var(--text-primary)] hover:text-indigo-600 dark:hover:text-indigo-400 p-2.5 rounded-xl hover:bg-indigo-500/10 transition-colors"
          >
            {t(item.key)}
          </a>
        );
      })}
    </nav>
    <div class="pt-6 border-t border-[var(--border-subtle)]">
      <p class="text-xs font-bold uppercase text-[var(--text-tertiary)] mb-3">{t('language', 'Idioma')}:</p>
      <div class="grid grid-cols-3 gap-2 max-h-40 overflow-y-auto pr-1">
        {supportedLocales.map((loc) => (
          <a
            href={getLocalizedUrl('/', loc.code)}
            class={`text-xs px-2 py-1.5 rounded text-center border transition-colors ${
              loc.code === locale
                ? 'border-indigo-500 bg-indigo-500/15 text-indigo-600 font-bold'
                : 'border-[var(--border-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
            }`}
          >
            {loc.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Theme toggle
    const toggleBtns = [
      document.getElementById('themeToggleBtn'),
      document.getElementById('themeToggleBtnMobile'),
    ].filter(Boolean);

    toggleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        const nextTheme = currentTheme === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', nextTheme);
        localStorage.setItem('iva_calculator_theme', nextTheme);
      });
    });

    // Language Dropdown behavior
    const langBtn = document.getElementById('langDropdownBtn');
    const langMenu = document.getElementById('langDropdownMenu');

    if (langBtn && langMenu) {
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !langMenu.classList.contains('hidden');
        if (isOpen) {
          langMenu.classList.add('hidden');
          langBtn.setAttribute('aria-expanded', 'false');
        } else {
          langMenu.classList.remove('hidden');
          langBtn.setAttribute('aria-expanded', 'true');
        }
      });

      document.addEventListener('click', () => {
        langMenu.classList.add('hidden');
        langBtn.setAttribute('aria-expanded', 'false');
      });
    }

    // Mobile Menu behavior
    const menuToggle = document.getElementById('mobileMenuToggle');
    const menuPanel = document.getElementById('mobileMenuPanel');
    const hamburgerIcon = document.getElementById('hamburgerIcon');
    const closeIcon = document.getElementById('closeIcon');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    if (menuToggle && menuPanel) {
      function toggleMenu(open) {
        const isOpen = open !== undefined ? open : menuToggle.getAttribute('aria-expanded') !== 'true';
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        menuPanel.setAttribute('aria-hidden', String(!isOpen));

        if (isOpen) {
          menuPanel.classList.remove('hidden');
          hamburgerIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        } else {
          menuPanel.classList.add('hidden');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          document.body.style.overflow = '';
        }
      }

      menuToggle.addEventListener('click', () => toggleMenu());
      mobileLinks.forEach((link) => link.addEventListener('click', () => toggleMenu(false)));
    }
  });
</script>
