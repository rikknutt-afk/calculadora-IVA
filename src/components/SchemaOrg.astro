---
import siteConfig from '../config/site.json';
import navConfig from '../config/navigation.json';
import { supportedLocales } from '../i18n/utils';

interface FaqItem {
  question: string;
  answer: string;
  display?: boolean;
  formula?: any;
}

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface BlogItem {
  name: string;
  url: string;
  position: number;
}

interface HowToStepItem {
  name: string;
  text: string;
  url?: string;
}

interface Props {
  type?:
    | 'WebSite'
    | 'WebApplication'
    | 'AboutPage'
    | 'ContactPage'
    | 'Article'
    | 'Blog'
    | 'WebPage'
    | 'CollectionPage';
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  faqItems?: FaqItem[];
  breadcrumbs?: BreadcrumbItem[];
  blogItems?: BlogItem[];
  howToSteps?: HowToStepItem[];
  howToTitle?: string;
  howToDescription?: string;
  featureList?: string[];
  softwareVersion?: string;
  locale?: string;
  isCalculator?: boolean;
}

const {
  type = 'WebSite',
  title = siteConfig.defaultTitle,
  description = siteConfig.defaultDescription,
  url = siteConfig.siteUrl,
  image = `${siteConfig.siteUrl}${siteConfig.ogImage}`,
  datePublished,
  dateModified,
  authorName = siteConfig.author,
  faqItems,
  breadcrumbs,
  blogItems,
  howToSteps,
  howToTitle,
  howToDescription,
  featureList,
  softwareVersion = '2025.1.0',
  locale = 'es',
  isCalculator = false,
} = Astro.props;

// Helper to strip HTML tags if any answer contains formatting
function sanitizeText(str: string): string {
  return str.replace(/<[^>]*>?/gm, '').trim();
}

// 1. Organization Schema (Central entity graph anchor)
const socialLinks = Object.values(siteConfig.social).filter(Boolean);
const organizationId = `${siteConfig.siteUrl}/#organization`;
const websiteId = `${siteConfig.siteUrl}/#website`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'FinancialService'],
  '@id': organizationId,
  name: siteConfig.siteName,
  legalName: siteConfig.legalName,
  url: siteConfig.siteUrl,
  logo: {
    '@type': 'ImageObject',
    '@id': `${siteConfig.siteUrl}/#logo`,
    url: `${siteConfig.siteUrl}/favicon.svg`,
    contentUrl: `${siteConfig.siteUrl}/favicon.svg`,
    caption: siteConfig.siteName,
    width: 512,
    height: 512,
  },
  image: {
    '@type': 'ImageObject',
    '@id': `${siteConfig.siteUrl}/#primaryimage`,
    url: `${siteConfig.siteUrl}${siteConfig.ogImage}`,
    width: 1200,
    height: 630,
  },
  description: siteConfig.defaultDescription,
  email: siteConfig.contactEmail,
  contactPoint: {
    '@type': 'ContactPoint',
    email: siteConfig.contactEmail,
    contactType: 'customer support',
    availableLanguage: ['Spanish', 'English'],
  },
  sameAs: socialLinks,
  knowsAbout: [
    'Impuesto sobre el Valor Añadido (IVA)',
    'Cálculo de IVA',
    'Base Imponible',
    'Cuota Tributaria',
    'Recargo de Equivalencia',
    'Retención de IRPF',
    'Facturación e Impuestos',
  ],
};

// 2. WebSite Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  url: siteConfig.siteUrl,
  name: siteConfig.siteName,
  alternateName: ['Calculadora IVA', 'Calculadora de IVA', 'IVA Calculator', 'Calculadora IVA España'],
  description: siteConfig.defaultDescription,
  publisher: {
    '@id': organizationId,
  },
  inLanguage: supportedLocales.map((l) => l.code),
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteConfig.siteUrl}/#calculator`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// 3. Site Navigation Element Graph
const navLabels: Record<string, string> = {
  'nav.calculator': 'Calculadora de IVA',
  'nav.calcularIva': 'Calcular IVA',
  'nav.formulaIva': 'Fórmula del IVA',
  'nav.howItWorks': 'Cómo funciona la calculadora',
  'nav.rates': 'Porcentajes y tipos de IVA',
  'nav.tools': 'Herramientas de cálculo',
  'nav.faq': 'Preguntas Frecuentes',
  'nav.blog': 'Blog de fiscalidad',
};

const siteNavSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${siteConfig.siteUrl}/#navigation`,
  name: 'Navegación Principal',
  itemListElement: navConfig.headerNav.map((item, index) => ({
    '@type': 'SiteNavigationElement',
    position: index + 1,
    name: navLabels[item.key] || item.key,
    url: `${siteConfig.siteUrl}${item.href}`,
  })),
};

// 4. Breadcrumb Schema (Auto-generated with graceful fallback)
let computedBreadcrumbs: BreadcrumbItem[] = [];

if (breadcrumbs && breadcrumbs.length > 0) {
  computedBreadcrumbs = breadcrumbs;
} else {
  // Derive automated breadcrumbs from URL
  const currentPath = new URL(url).pathname;
  computedBreadcrumbs.push({ name: 'Inicio', url: `${siteConfig.siteUrl}/` });

  if (currentPath !== '/' && currentPath !== '') {
    const segments = currentPath.split('/').filter(Boolean);
    if (segments.length === 1) {
      computedBreadcrumbs.push({
        name: title.split('—')[0].trim() || segments[0],
        url: url,
      });
    } else if (segments.length >= 2) {
      if (segments[0] === 'blog') {
        computedBreadcrumbs.push({
          name: 'Blog',
          url: `${siteConfig.siteUrl}/blog/`,
        });
        computedBreadcrumbs.push({
          name: title.split('—')[0].trim() || segments[1],
          url: url,
        });
      } else {
        computedBreadcrumbs.push({
          name: title.split('—')[0].trim() || segments[segments.length - 1],
          url: url,
        });
      }
    }
  }
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${url}#breadcrumb`,
  itemListElement: computedBreadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: crumb.url,
  })),
};

// 5. WebApplication / SoftwareApplication Schema (For all Interactive Calculators)
const shouldRenderWebAppSchema = type === 'WebApplication' || isCalculator || url.includes('/iva-') || url === `${siteConfig.siteUrl}/` || url === siteConfig.siteUrl;

const defaultCalculatorFeatures = [
  'Cálculo instantáneo y reactivo de IVA (21%, 10%, 4%)',
  'Modos bidireccionales: Añadir IVA y Quitar IVA (IVA Inverso)',
  'Desglose exacto de Base Imponible, Cuota de IVA y Total',
  'Soporte para Recargo de Equivalencia (5,2%, 1,4%, 0,5%) e IRPF',
  'Gráficos interactivos de distribución tributaria y visualización de cuotas',
  'Generador y visualizador de desglose de facturas',
  '100% privado: procesamiento local en el navegador del usuario sin registro de datos',
];

const webAppSchema = shouldRenderWebAppSchema ? {
  '@context': 'https://schema.org',
  '@type': ['WebApplication', 'SoftwareApplication'],
  '@id': `${url}#webapp`,
  name: title,
  description: description,
  url: url,
  applicationCategory: 'FinanceApplication',
  applicationSubCategory: 'TaxCalculator',
  operatingSystem: 'All (Web Browser, iOS, Android, Windows, macOS, Linux)',
  browserRequirements: 'Requires JavaScript. Requires HTML5.',
  softwareVersion: softwareVersion,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
  featureList: featureList || defaultCalculatorFeatures,
  screenshot: image,
  provider: {
    '@id': organizationId,
  },
  inLanguage: locale,
  maintainer: {
    '@id': organizationId,
  },
} : null;

// 6. Page-Specific Schema (WebPage, AboutPage, ContactPage, Article, Blog)
let pageSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': type === 'WebApplication' ? 'WebPage' : type,
  '@id': `${url}#webpage`,
  name: title,
  description: description,
  url: url,
  isPartOf: {
    '@id': websiteId,
  },
  breadcrumb: {
    '@id': `${url}#breadcrumb`,
  },
  inLanguage: locale,
};

if (type === 'AboutPage') {
  pageSchema = {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${url}#aboutpage`,
    name: title,
    description: description,
    url: url,
    isPartOf: { '@id': websiteId },
    breadcrumb: { '@id': `${url}#breadcrumb` },
    mainEntity: { '@id': organizationId },
    inLanguage: locale,
  };
} else if (type === 'ContactPage') {
  pageSchema = {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${url}#contactpage`,
    name: title,
    description: description,
    url: url,
    isPartOf: { '@id': websiteId },
    breadcrumb: { '@id': `${url}#breadcrumb` },
    mainEntity: { '@id': organizationId },
    inLanguage: locale,
  };
} else if (type === 'Article' || type === 'Blog') {
  if (type === 'Article') {
    pageSchema = {
      '@context': 'https://schema.org',
      '@type': ['BlogPosting', 'Article'],
      '@id': `${url}#article`,
      headline: title,
      name: title,
      description: description,
      image: {
        '@type': 'ImageObject',
        url: image,
        width: 1200,
        height: 630,
      },
      datePublished: datePublished || new Date().toISOString(),
      dateModified: dateModified || datePublished || new Date().toISOString(),
      author: {
        '@type': 'Person',
        name: authorName,
      },
      publisher: {
        '@id': organizationId,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': url,
      },
      isPartOf: {
        '@id': websiteId,
      },
      inLanguage: locale,
    };
  } else {
    pageSchema = {
      '@context': 'https://schema.org',
      '@type': ['Blog', 'CollectionPage'],
      '@id': `${url}#blog`,
      name: title,
      description: description,
      url: url,
      isPartOf: { '@id': websiteId },
      inLanguage: locale,
    };
  }
}

// 7. HowTo Schema (Step-by-Step Calculation Guide)
let calculatedHowToSteps: HowToStepItem[] = [];

if (howToSteps && howToSteps.length > 0) {
  calculatedHowToSteps = howToSteps;
} else if (shouldRenderWebAppSchema) {
  // Sensible high-converting default HowTo steps for VAT calculation
  calculatedHowToSteps = [
    {
      name: 'Introduce el importe monetario',
      text: 'Escribe la cantidad numérica deseada en el campo de importe (por ejemplo, 100 € o cualquier cifra con decimales).',
    },
    {
      name: 'Selecciona el tipo impositivo de IVA',
      text: 'Elige el porcentaje de IVA aplicable: 21% (general), 10% (reducido), 4% (superreducido) o un tipo personalizado.',
    },
    {
      name: 'Elige la operación: Añadir o Quitar IVA',
      text: 'Selecciona "Añadir IVA" si partes de una base imponible neta, o "Quitar IVA" (IVA incluido) si partes de un precio final bruto.',
    },
    {
      name: 'Consulta el desglose completo',
      text: 'Visualiza al instante el importe neto, la cuota exacta de IVA calculada y el total final, junto con el gráfico interactivo.',
    },
  ];
}

const howToSchema = calculatedHowToSteps.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  '@id': `${url}#howto`,
  name: howToTitle || `¿Cómo calcular el IVA con ${title.split('—')[0].trim()}?`,
  description: howToDescription || `Instrucciones paso a paso para utilizar ${title.split('—')[0].trim()} y obtener el cálculo exacto de IVA.`,
  totalTime: 'PT1M',
  estimatedCost: {
    '@type': 'MonetaryAmount',
    currency: 'EUR',
    value: '0',
  },
  tool: [
    {
      '@type': 'HowToTool',
      name: title.split('—')[0].trim(),
    },
  ],
  step: calculatedHowToSteps.map((s, idx) => ({
    '@type': 'HowToStep',
    position: idx + 1,
    name: s.name,
    text: s.text,
    url: s.url || `${url}#step-${idx + 1}`,
  })),
} : null;

// 8. FAQ Schema (if FAQs exist)
const visibleFaqs = faqItems?.filter((f) => f.display !== false);
const faqSchema = visibleFaqs && visibleFaqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${url}#faq`,
  mainEntity: visibleFaqs.map((faq) => ({
    '@type': 'Question',
    name: sanitizeText(faq.question),
    acceptedAnswer: {
      '@type': 'Answer',
      text: sanitizeText(faq.answer),
    },
  })),
} : null;

// 9. Blog Listing ItemList Schema
const blogListSchema = blogItems && blogItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${url}#bloglist`,
  itemListElement: blogItems.map((post) => ({
    '@type': 'ListItem',
    position: post.position,
    name: post.name,
    url: post.url,
  })),
} : null;
---

<!-- Core Organization & Website Entities -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(siteNavSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

<!-- Specialized Rich Schemas -->
{webAppSchema && <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />}
{howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
{blogListSchema && <script type="application/ld+json" set:html={JSON.stringify(blogListSchema)} />}
