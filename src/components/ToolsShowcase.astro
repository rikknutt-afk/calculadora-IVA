---
/**
 * ToolsShowcase — Grid of all calculator tools with icon and title.
 * Placed on the homepage to drive discovery of specialized calculators.
 */
interface Props {
  locale?: string;
}

const { locale = 'es' } = Astro.props;

const tools = [
  {
    title: 'IVA de una Cantidad',
    href: '/iva-de-una-cantidad/',
    color: '#4f46e5',
    colorLight: 'rgba(79,70,229,0.1)',
    colorBorder: 'rgba(79,70,229,0.3)',
    icon: 'amount',
  },
  {
    title: 'IVA Incluido',
    href: '/iva-incluido/',
    color: '#7c3aed',
    colorLight: 'rgba(124,58,237,0.1)',
    colorBorder: 'rgba(124,58,237,0.3)',
    icon: 'included',
  },
  {
    title: 'IVA Porcentaje',
    href: '/iva-porcentaje/',
    color: '#0ea5e9',
    colorLight: 'rgba(14,165,233,0.1)',
    colorBorder: 'rgba(14,165,233,0.3)',
    icon: 'percent',
  },
  {
    title: 'Retención IVA',
    href: '/retencion-iva/',
    color: '#f59e0b',
    colorLight: 'rgba(245,158,11,0.1)',
    colorBorder: 'rgba(245,158,11,0.3)',
    icon: 'retention',
  },
  {
    title: 'IVA en Factura',
    href: '/iva-factura/',
    color: '#10b981',
    colorLight: 'rgba(16,185,129,0.1)',
    colorBorder: 'rgba(16,185,129,0.3)',
    icon: 'invoice',
  },
  {
    title: 'IVA Honorarios',
    href: '/iva-honorarios/',
    color: '#ec4899',
    colorLight: 'rgba(236,72,153,0.1)',
    colorBorder: 'rgba(236,72,153,0.3)',
    icon: 'honorarios',
  },
  {
    title: 'IVA e IRPF',
    href: '/iva-irpf/',
    color: '#8b5cf6',
    colorLight: 'rgba(139,92,246,0.1)',
    colorBorder: 'rgba(139,92,246,0.3)',
    icon: 'irpf',
  },
  {
    title: 'IVA e ISR',
    href: '/iva-isr/',
    color: '#06b6d4',
    colorLight: 'rgba(6,182,212,0.1)',
    colorBorder: 'rgba(6,182,212,0.3)',
    icon: 'isr',
  },
  {
    title: 'IVA a Pagar',
    href: '/iva-a-pagar/',
    color: '#ef4444',
    colorLight: 'rgba(239,68,68,0.1)',
    colorBorder: 'rgba(239,68,68,0.3)',
    icon: 'apagar',
  },
  {
    title: 'IVA Acreditable',
    href: '/iva-acreditable/',
    color: '#14b8a6',
    colorLight: 'rgba(20,184,166,0.1)',
    colorBorder: 'rgba(20,184,166,0.3)',
    icon: 'acreditable',
  },
  {
    title: 'IVA e IEPS',
    href: '/iva-ieps/',
    color: '#d946ef',
    colorLight: 'rgba(217,70,239,0.1)',
    colorBorder: 'rgba(217,70,239,0.3)',
    icon: 'ieps',
  },
  {
    title: 'Recargo Equivalencia',
    href: '/iva-recargo-equivalencia/',
    color: '#f97316',
    colorLight: 'rgba(249,115,22,0.1)',
    colorBorder: 'rgba(249,115,22,0.3)',
    icon: 'recargo',
  },
  {
    title: 'IVA RESICO',
    href: '/iva-resico/',
    color: '#0284c7',
    colorLight: 'rgba(2,132,199,0.1)',
    colorBorder: 'rgba(2,132,199,0.3)',
    icon: 'resico',
  },
];
---

<section class="section-block" id="herramientas">
  <div class="section-container section-container-wide">
    <h2 class="section-title">Todas Nuestras <span class="gradient-text">Calculadoras</span></h2>
    <p class="section-subtitle">Acceso directo a todas nuestras herramientas especializadas para calcular IVA, retenciones, IRPF e impuestos.</p>

    <div class="tools-grid" id="toolsGrid">
      {tools.map((tool, i) => (
        <a 
          href={tool.href} 
          class="tool-card group" 
          style={`--tool-color: ${tool.color}; --tool-color-light: ${tool.colorLight}; --tool-color-border: ${tool.colorBorder}; --tool-index: ${i};`}
        >
          <!-- Top accent bar -->
          <div class="tool-card-accent" aria-hidden="true"></div>

          <!-- Tool Icon -->
          <div class="tool-icon-wrapper" aria-hidden="true">
            {tool.icon === 'amount' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="20" x="4" y="2" rx="2"/>
                <line x1="8" x2="16" y1="6" y2="6"/>
                <line x1="16" x2="16" y1="14" y2="18"/>
                <path d="M8 10h.01"/><path d="M12 10h.01"/><path d="M16 10h.01"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/>
              </svg>
            )}
            {tool.icon === 'included' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/>
                <circle cx="7.5" cy="7.5" r="1.5" fill="currentColor"/>
              </svg>
            )}
            {tool.icon === 'percent' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="m15 9-6 6"/>
                <circle cx="9" cy="9" r="1" fill="currentColor"/>
                <circle cx="15" cy="15" r="1" fill="currentColor"/>
              </svg>
            )}
            {tool.icon === 'retention' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                <line x1="8" y1="12" x2="16" y2="12"/>
              </svg>
            )}
            {tool.icon === 'invoice' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/>
                <path d="M8 7h8"/><path d="M8 11h8"/><path d="M8 15h5"/>
              </svg>
            )}
            {tool.icon === 'honorarios' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
              </svg>
            )}
            {tool.icon === 'irpf' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
                <path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
              </svg>
            )}
            {tool.icon === 'isr' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="2" x2="22" y1="20" y2="20"/>
                <line x1="6" x2="6" y1="10" y2="17"/>
                <line x1="10" x2="10" y1="10" y2="17"/>
                <line x1="14" x2="14" y1="10" y2="17"/>
                <line x1="18" x2="18" y1="10" y2="17"/>
                <polygon points="12 2 20 7 4 7"/>
              </svg>
            )}
            {tool.icon === 'apagar' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/>
                <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
              </svg>
            )}
            {tool.icon === 'acreditable' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            )}
            {tool.icon === 'ieps' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 22V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v17"/>
                <path d="M15 11h2a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2v0a2 2 0 0 0 2-2V9.83a2 2 0 0 0-.59-1.42L19 5"/>
                <path d="M3 11h12"/><path d="M7 16h4"/>
              </svg>
            )}
            {tool.icon === 'recargo' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"/>
                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
                <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"/>
                <path d="M2 7h20"/>
              </svg>
            )}
            {tool.icon === 'resico' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
              </svg>
            )}
          </div>

          <!-- Tool Name -->
          <h3 class="tool-card-title">{tool.title}</h3>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* ========== Tools Showcase Grid ========== */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .tools-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .tools-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tools-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.15rem;
    }
  }

  .tool-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.15rem;
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: var(--shadow-sm);
    opacity: 0;
    transform: translateY(16px);
    animation: toolFadeIn 0.4s var(--ease-out) forwards;
    animation-delay: calc(var(--tool-index) * 0.03s);
  }

  @keyframes toolFadeIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .tool-card:hover {
    border-color: var(--tool-color-border);
    background: color-mix(in srgb, var(--tool-color-light) 40%, var(--bg-card));
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), 0 8px 20px -6px color-mix(in srgb, var(--tool-color) 20%, transparent);
  }

  /* Top colored accent bar */
  .tool-card-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--tool-color);
    opacity: 0.45;
    transition: opacity 0.3s var(--ease-out), height 0.3s var(--ease-out);
  }

  .tool-card:hover .tool-card-accent {
    opacity: 1;
    height: 4px;
  }

  /* ---- Tool Icon Wrapper ---- */
  .tool-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--tool-color-light);
    border: 1px solid var(--tool-color-border);
    color: var(--tool-color);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tool-icon-wrapper svg {
    width: 1.35rem;
    height: 1.35rem;
    transition: transform 0.3s var(--ease-out);
  }

  .tool-card:hover .tool-icon-wrapper {
    background: var(--tool-color);
    color: #ffffff;
    box-shadow: 0 4px 12px -2px color-mix(in srgb, var(--tool-color) 45%, transparent);
    transform: scale(1.06);
  }

  .tool-card:hover .tool-icon-wrapper svg {
    transform: scale(1.08);
  }

  /* ---- Tool Name ---- */
  .tool-card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.925rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    margin: 0;
    transition: color 0.25s var(--ease-out);
  }

  .tool-card:hover .tool-card-title {
    color: var(--tool-color);
  }

  /* ---- Responsive ---- */
  @media (max-width: 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .tool-card {
      padding: 0.9rem 1rem;
    }

    .tool-icon-wrapper {
      width: 2.5rem;
      height: 2.5rem;
    }

    .tool-icon-wrapper svg {
      width: 1.25rem;
      height: 1.25rem;
    }

    .tool-card-title {
      font-size: 0.885rem;
    }
  }
</style>
