---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA a Pagar — IVA a Ingresar en Hacienda";
const description = "Calculadora de IVA a pagar: resta el IVA soportado del IVA repercutido para obtener el IVA neto que debes ingresar a Hacienda. Resultado positivo = pagas, negativo = compensas.";

const faqItems = [
  { question: "¿Cómo se calcula el IVA a pagar?", answer: "El IVA a pagar es la diferencia entre el IVA repercutido (cobrado a tus clientes en facturas emitidas) y el IVA soportado (pagado a tus proveedores en facturas recibidas). Fórmula: IVA a pagar = IVA repercutido − IVA soportado. Si el resultado es positivo, debes ingresarlo a Hacienda.", display: true, formula: { base: "2.100 € rep.", rate: "− 840 € sop.", result: "1.260 € a pagar" } },
  { question: "¿Qué pasa si el IVA soportado es mayor que el repercutido?", answer: "Si el IVA soportado supera al repercutido, el resultado es negativo: tienes un saldo a tu favor. Puedes compensarlo en las siguientes declaraciones trimestrales o solicitar la devolución en la última declaración del año (4T, modelo 303 de enero).", display: true },
  { question: "¿Cuándo se presenta el modelo 303 de IVA?", answer: "El modelo 303 se presenta trimestralmente: 1T (enero-marzo) → hasta 20 de abril. 2T (abril-junio) → hasta 20 de julio. 3T (julio-septiembre) → hasta 20 de octubre. 4T (octubre-diciembre) → hasta 30 de enero. Las grandes empresas (>6M €) lo presentan mensualmente.", display: true },
  { question: "¿Todo el IVA soportado es deducible?", answer: "No. Para que el IVA soportado sea deducible, debe cumplir: estar en una factura completa y correcta, corresponder a gastos afectos a la actividad económica, estar registrado en el libro de facturas recibidas, y no haber prescrito (4 años). Gastos personales no son deducibles.", display: true },
  { question: "¿Cómo funciona la compensación de IVA a favor?", answer: "Cuando el IVA a pagar es negativo, el saldo a favor se arrastra al siguiente trimestre. Se resta automáticamente del IVA a pagar del período siguiente. Solo en el 4T (modelo 303 de enero) puedes solicitar la devolución del saldo acumulado a favor.", display: true },
  { question: "¿Qué diferencia hay entre IVA a pagar y IVA devengado?", answer: "El IVA devengado (o repercutido) es el IVA que cobras a tus clientes. El IVA a pagar es el resultado de restar el IVA soportado (deducible) del IVA devengado. El devengado siempre es positivo, mientras que el IVA a pagar puede ser negativo si soportas más del que repercutes.", display: true }
];

const ivaTable = [
  { rep: '500 €', sop: '100 €', pagar: '400 €', resultado: 'A ingresar' },
  { rep: '1.000 €', sop: '300 €', pagar: '700 €', resultado: 'A ingresar' },
  { rep: '2.100 €', sop: '840 €', pagar: '1.260 €', resultado: 'A ingresar' },
  { rep: '3.150 €', sop: '1.500 €', pagar: '1.650 €', resultado: 'A ingresar' },
  { rep: '5.000 €', sop: '4.200 €', pagar: '800 €', resultado: 'A ingresar' },
  { rep: '2.000 €', sop: '2.500 €', pagar: '−500 €', resultado: 'A compensar' },
  { rep: '1.500 €', sop: '3.000 €', pagar: '−1.500 €', resultado: 'A compensar' },
  { rep: '800 €', sop: '5.000 €', pagar: '−4.200 €', resultado: 'A devolver (4T)' },
];
---

<BaseLayout title={title} description={description} schemaType="WebSite" faqItems={faqItems} locale="es">
  <section class="hero" id="hero"><div class="hero-content"><h1 class="hero-title">Calculadora <span class="gradient-text">IVA a Pagar</span></h1><p class="hero-subtitle">Calcula la diferencia entre el IVA repercutido y el IVA soportado.<br class="hidden sm:inline" /> Descubre si debes ingresar a Hacienda o tienes saldo a compensar.</p></div></section>

  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <div id="calcBody" class="space-y-6">
          <div><label for="repInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-indigo-500 mb-2"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg><span>IVA Repercutido (cobrado a clientes)</span></label><div class="relative"><input type="text" id="repInput" class="w-full py-4 pl-5 pr-12 bg-[var(--bg-input)] border-1.5 border-indigo-500/30 rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 2.100,00" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-xl font-bold text-[var(--text-tertiary)]">€</span></div></div>

          <div><label for="sopInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-500 mb-2"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>IVA Soportado (pagado a proveedores)</span></label><div class="relative"><input type="text" id="sopInput" class="w-full py-4 pl-5 pr-12 bg-[var(--bg-input)] border-1.5 border-emerald-500/30 rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 840,00" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-xl font-bold text-[var(--text-tertiary)]">€</span></div></div>

          <div><label for="compInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/></svg><span>Compensación pendiente de trimestres anteriores (opcional)</span></label><div class="relative"><input type="text" id="compInput" class="w-full py-3 pl-5 pr-12 bg-[var(--bg-input)] border border-[var(--border-medium)] rounded-xl text-lg font-semibold text-[var(--text-primary)] outline-none focus:border-amber-500 focus:ring-4 focus:ring-amber-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 0,00" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-lg font-bold text-[var(--text-tertiary)]">€</span></div></div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group"><span class="relative z-10">Calcular IVA a Pagar</span><svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg><div class="btn-shine" aria-hidden="true"></div></button>
        </div>

        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between"><p class="font-display font-extrabold text-xl gradient-text">Liquidación de IVA</p><button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg><span>Modificar</span></button></div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/30 bg-indigo-500/5 shadow-sm"><span class="text-sm font-bold text-indigo-600 dark:text-indigo-400">IVA repercutido</span><span class="font-display font-bold text-lg text-indigo-600 dark:text-indigo-400" id="rRep">+0 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-emerald-500/30 bg-emerald-500/5 shadow-sm"><span class="text-sm font-bold text-emerald-600 dark:text-emerald-400">− IVA soportado</span><span class="font-display font-bold text-lg text-emerald-600 dark:text-emerald-400" id="rSop">−0 €</span></div>
            <div id="compRow" class="hidden flex items-center justify-between p-4 rounded-xl border border-amber-500/30 bg-amber-500/5 shadow-sm"><span class="text-sm font-bold text-amber-600 dark:text-amber-400">− Compensación anterior</span><span class="font-display font-bold text-lg text-amber-600 dark:text-amber-400" id="rComp">−0 €</span></div>
            <div id="resultBox" class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md"><span class="text-sm font-bold text-[var(--text-secondary)]" id="resultLabel">IVA a pagar</span><span class="font-display font-extrabold text-2xl gradient-text" id="rPagar">0 €</span></div>
          </div>
          <div id="statusBadge" class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold"></div>
          <div class="flex gap-3 pt-2"><button type="button" id="copyResult" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copiar</span></button><button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Nuevo</span></button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="calcular-iva"><div class="section-container"><h2 class="section-title">3 Resultados Posibles del <span class="gradient-text">IVA a Pagar</span></h2><p class="section-subtitle">La diferencia entre IVA repercutido y soportado determina tu obligación fiscal</p><div class="methods-grid">
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg></div><span class="method-number">01</span></div><h3 class="method-title">Resultado positivo → A ingresar</h3><p class="method-desc">Si el IVA repercutido supera al soportado, debes ingresar la diferencia a Hacienda antes del día 20 del mes siguiente al trimestre (o 30 de enero para el 4T).</p><div class="method-formula"><span class="method-formula-var">2.100 € rep.</span><span class="method-formula-op">−</span><span class="method-formula-var">840 € sop.</span><span class="method-formula-op">=</span><span class="method-formula-result">1.260 € a pagar</span></div><div class="method-example"><span class="method-example-label">Modelo 303</span><span>Ingreso a Hacienda = <strong>1.260 €</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-remove"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/></svg></div><span class="method-number">02</span></div><h3 class="method-title">Resultado negativo → Compensar</h3><p class="method-desc">Si soportas más IVA del que repercutes, el saldo negativo se arrastra como compensación al siguiente trimestre. No se pierde, se acumula.</p><div class="method-formula"><span class="method-formula-var">1.500 € rep.</span><span class="method-formula-op">−</span><span class="method-formula-var">3.000 € sop.</span><span class="method-formula-op">=</span><span class="method-formula-result">−1.500 € a favor</span></div><div class="method-example"><span class="method-example-label">Compensación</span><span>Se resta del IVA del siguiente trimestre</span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-desglose"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></div><span class="method-number">03</span></div><h3 class="method-title">Solicitar devolución (4T)</h3><p class="method-desc">En la declaración del 4T (enero), puedes solicitar la devolución del saldo acumulado a favor. Hacienda dispone de 6 meses para devolver, con intereses de demora si se retrasa.</p><div class="method-formula"><span class="method-formula-var">Saldo acumulado</span><span class="method-formula-op">→</span><span class="method-formula-var">Casilla 71</span><span class="method-formula-op">=</span><span class="method-formula-result">Devolución</span></div><div class="method-example"><span class="method-example-label">Devolución</span><span>Solo en el 4T (modelo 303 de enero)</span></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="formula-iva"><div class="section-container"><h2 class="section-title">Fórmula del <span class="gradient-text">IVA a Pagar</span></h2><p class="section-subtitle">La fórmula básica de liquidación del IVA y cómo funciona la compensación</p><div class="formula-builder">
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-add"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/></svg><span>IVA a ingresar (positivo)</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">IVA repercutido</span><span class="formula-builder-value">2.100 €</span></div><span class="formula-builder-op">−</span><div class="formula-builder-part"><span class="formula-builder-label">IVA soportado</span><span class="formula-builder-value">840 €</span></div><span class="formula-builder-op">=</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">A ingresar</span><span class="formula-builder-value">1.260 €</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>IVA cobrado en facturas emitidas</span><span>2.100,00 €</span></div><div class="formula-builder-breakdown-row"><span>IVA pagado en facturas recibidas</span><span>−840,00 €</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>IVA neto a pagar a Hacienda</span><span>1.260,00 €</span></div></div></div>
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-remove"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>IVA a compensar (negativo)</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">IVA repercutido</span><span class="formula-builder-value">1.500 €</span></div><span class="formula-builder-op">−</span><div class="formula-builder-part"><span class="formula-builder-label">IVA soportado</span><span class="formula-builder-value">3.000 €</span></div><span class="formula-builder-op">=</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">A compensar</span><span class="formula-builder-value">−1.500 €</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>IVA cobrado</span><span>1.500,00 €</span></div><div class="formula-builder-breakdown-row"><span>IVA pagado (más que cobrado)</span><span>−3.000,00 €</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Saldo a favor → se arrastra al siguiente trimestre</span><span>−1.500,00 €</span></div></div></div>
  </div></div></section>

  <section class="content-section" id="como-funciona"><div class="section-container"><h2 class="section-title">¿Cómo Calcular el <span class="gradient-text">IVA a Pagar</span> en 4 Pasos?</h2><p class="section-subtitle">El proceso para determinar tu obligación de IVA trimestral en España</p><div class="walkthrough-steps">
    <div class="walkthrough-step" data-step="1"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">1</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📤</div><h3 class="walkthrough-step-title">1. Suma el IVA repercutido</h3><p class="walkthrough-step-desc">Revisa todas tus facturas emitidas en el trimestre y suma el IVA que cobraste a tus clientes (21%, 10% o 4%).</p><div class="walkthrough-mini-input"><span class="mini-input-label">IVA repercutido</span><div class="mini-input-box">2.100,00 <span class="mini-input-currency">€</span></div></div></div></div>
    <div class="walkthrough-step" data-step="2"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">2</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📥</div><h3 class="walkthrough-step-title">2. Suma el IVA soportado</h3><p class="walkthrough-step-desc">Revisa tus facturas recibidas de proveedores y suma el IVA que pagaste en compras y gastos de la actividad.</p><div class="walkthrough-mini-input"><span class="mini-input-label">IVA soportado</span><div class="mini-input-box">840,00 <span class="mini-input-currency">€</span></div></div></div></div>
    <div class="walkthrough-step" data-step="3"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">3</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">➖</div><h3 class="walkthrough-step-title">3. Resta: Repercutido − Soportado</h3><p class="walkthrough-step-desc">La diferencia es tu IVA a pagar. Si es positivo, debes ingresarlo. Si es negativo, se compensa en el siguiente período.</p></div></div>
    <div class="walkthrough-step" data-step="4"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">4</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">✅</div><h3 class="walkthrough-step-title">4. Presenta el modelo 303</h3><p class="walkthrough-step-desc">Declara e ingresa el IVA en la AEAT antes de la fecha límite del trimestre.</p><div class="walkthrough-mini-result"><div class="mini-result-row" style="color:var(--accent-indigo)"><span>IVA repercutido</span><span class="mini-result-value">+2.100,00 €</span></div><div class="mini-result-row" style="color:#10b981"><span>IVA soportado</span><span class="mini-result-value">−840,00 €</span></div><div class="mini-result-row mini-result-total"><span>IVA a pagar</span><span class="mini-result-value"><strong>1.260,00 €</strong></span></div></div></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="tabla-referencia"><div class="section-container section-container-wide"><h2 class="section-title">Tabla de <span class="gradient-text">IVA a Pagar</span></h2><p class="section-subtitle">Ejemplos de liquidación de IVA con diferentes combinaciones de IVA repercutido y soportado</p><div class="quick-table-wrapper"><div class="quick-table-container"><table class="quick-table"><thead><tr><th>IVA Repercutido</th><th>IVA Soportado</th><th>IVA a Pagar</th><th>Resultado</th></tr></thead><tbody>{ivaTable.map((r) => (<tr><td>{r.rep}</td><td>{r.sop}</td><td><strong>{r.pagar}</strong></td><td>{r.resultado}</td></tr>))}</tbody></table></div></div></div></section>

  <section class="faq-section" id="faq"><div class="section-container"><h2 class="section-title">Preguntas sobre <span class="gradient-text">IVA a Pagar</span></h2><p class="section-subtitle">Todo sobre la liquidación del IVA, compensaciones y devoluciones en España</p><div class="faq-list" id="faqList">{faqItems.map((item, idx) => (<div class="faq-item" id={`faq${idx + 1}`}><button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button"><span>{item.question}</span><svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></button><div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}><p set:html={item.answer} />{item.formula && (<div class="faq-formula-mini"><div class="faq-formula-equation"><span class="faq-formula-var">{item.formula.base}</span><span class="faq-formula-op">−</span><span class="faq-formula-var">{item.formula.rate}</span><span class="faq-formula-op">=</span><span class="faq-formula-result">{item.formula.result}</span></div></div>)}</div></div>))}</div></div></section>
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded',()=>{const els={repInput:document.getElementById('repInput'),sopInput:document.getElementById('sopInput'),compInput:document.getElementById('compInput'),calcButton:document.getElementById('calcButton'),calcBody:document.getElementById('calcBody'),resultsPanel:document.getElementById('resultsPanel'),resultsClose:document.getElementById('resultsClose'),rRep:document.getElementById('rRep'),rSop:document.getElementById('rSop'),rComp:document.getElementById('rComp'),compRow:document.getElementById('compRow'),resultLabel:document.getElementById('resultLabel'),rPagar:document.getElementById('rPagar'),resultBox:document.getElementById('resultBox'),statusBadge:document.getElementById('statusBadge'),copyResult:document.getElementById('copyResult'),newCalc:document.getElementById('newCalc'),ambientCanvas:document.getElementById('ambientCanvas')};
let state={lastResult:null};
function initAmbient(){
  if(window.innerWidth<768||window.matchMedia('(prefers-reduced-motion: reduce)').matches){if(els.ambientCanvas)els.ambientCanvas.style.display='none';return;}
  const c=els.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0;function rs(){w=window.innerWidth;h=window.innerHeight;const d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];for(let i=0;i<Math.min(Math.floor(w*h/22000),50);i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn()}
if('requestIdleCallback' in window){requestIdleCallback(initAmbient,{timeout:2000});}else{setTimeout(initAmbient,1200);}
function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
function fc(v){return v.toLocaleString('es-ES',{style:'currency',currency:'EUR',minimumFractionDigits:2,maximumFractionDigits:2})}
function calculate(){const rawR=els.repInput?.value.trim();const rawS=els.sopInput?.value.trim();if(!rawR){els.repInput?.classList.add('shake');setTimeout(()=>els.repInput?.classList.remove('shake'),400);return}const rep=pn(rawR);const sop=pn(rawS)||0;const comp=pn(els.compInput?.value)||0;if(isNaN(rep)||rep<0){els.repInput?.classList.add('shake');setTimeout(()=>els.repInput?.classList.remove('shake'),400);return}
const pagar=rep-sop-comp;state.lastResult={rep,sop,comp,pagar};
els.rRep.textContent='+'+fc(rep);els.rSop.textContent='−'+fc(sop);
if(comp>0){els.compRow.classList.remove('hidden');els.rComp.textContent='−'+fc(comp)}else{els.compRow.classList.add('hidden')}
els.rPagar.textContent=fc(Math.abs(pagar));
if(pagar>0){els.resultLabel.textContent='IVA a ingresar';els.resultBox.className='flex items-center justify-between p-4 rounded-xl border border-rose-500/40 bg-rose-500/5 shadow-md';els.rPagar.className='font-display font-extrabold text-2xl text-rose-600 dark:text-rose-400';els.statusBadge.innerHTML='<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg> Debes ingresar '+fc(pagar)+' a Hacienda';els.statusBadge.className='flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold border border-rose-500/30 bg-rose-500/5 text-rose-600 dark:text-rose-400'}else if(pagar<0){els.resultLabel.textContent='Saldo a favor';els.resultBox.className='flex items-center justify-between p-4 rounded-xl border border-emerald-500/40 bg-emerald-500/5 shadow-md';els.rPagar.className='font-display font-extrabold text-2xl text-emerald-600 dark:text-emerald-400';els.statusBadge.innerHTML='<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/></svg> Saldo a favor de '+fc(Math.abs(pagar))+' para compensar';els.statusBadge.className='flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold border border-emerald-500/30 bg-emerald-500/5 text-emerald-600 dark:text-emerald-400'}else{els.resultLabel.textContent='Resultado cero';els.resultBox.className='flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md';els.rPagar.className='font-display font-extrabold text-2xl gradient-text';els.statusBadge.innerHTML='✓ IVA repercutido y soportado se compensan exactamente';els.statusBadge.className='flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold border border-indigo-500/30 bg-indigo-500/5 text-indigo-600 dark:text-indigo-400'}
els.calcBody.classList.add('hidden');els.resultsPanel.classList.remove('hidden')}
els.calcButton?.addEventListener('click',calculate);els.repInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();els.sopInput?.focus()}});els.sopInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();calculate()}});
els.resultsClose?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden')});
els.newCalc?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden');els.repInput.value='';els.sopInput.value='';els.compInput.value='';els.repInput.focus()});
els.copyResult?.addEventListener('click',()=>{if(!state.lastResult)return;const r=state.lastResult;const label=r.pagar>=0?'A ingresar':'A compensar';const t=`IVA a Pagar\nRepercutido: ${fc(r.rep)}\nSoportado: ${fc(r.sop)}${r.comp>0?'\nCompensación: '+fc(r.comp):''}\n${label}: ${fc(Math.abs(r.pagar))}`;navigator.clipboard.writeText(t).then(()=>{const ex=document.querySelector('.toast');if(ex)ex.remove();const toast=document.createElement('div');toast.className='toast show';toast.textContent='✓ IVA copiado';document.body.appendChild(toast);setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>toast.remove(),300)},2500)})});
document.querySelectorAll('.faq-item .faq-question').forEach(b=>{b.addEventListener('click',()=>{const i=b.closest('.faq-item');if(!i)return;const o=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>{if(x!==i){x.classList.remove('open');const btn=x.querySelector('.faq-question');if(btn)btn.setAttribute('aria-expanded','false')}});if(o){i.classList.remove('open');b.setAttribute('aria-expanded','false')}else{i.classList.add('open');b.setAttribute('aria-expanded','true')}})});
});
</script>
