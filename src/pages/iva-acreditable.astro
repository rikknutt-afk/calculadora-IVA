---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA Acreditable — IVA Deducible en México";
const description = "Calculadora de IVA acreditable para México. Determina el IVA deducible de tus compras y gastos para restar del IVA trasladado en tu declaración del SAT.";

const faqItems = [
  { question: "¿Qué es el IVA acreditable en México?", answer: "El IVA acreditable es el IVA que pagas en tus compras y gastos de negocio (facturas recibidas con CFDI) y que puedes restar del IVA que cobras a tus clientes (IVA trasladado). Es el equivalente mexicano del «IVA soportado deducible» español. Se acredita en la declaración mensual ante el SAT.", display: true, formula: { base: "IVA trasladado", rate: "− IVA acreditable", result: "IVA a pagar" } },
  { question: "¿Qué requisitos debe cumplir el IVA para ser acreditable?", answer: "Para que el IVA sea acreditable, la compra debe: tener un CFDI válido (factura electrónica), estar pagada efectivamente (criterio de flujo de efectivo), corresponder a gastos estrictamente indispensables para la actividad, y estar registrada en la contabilidad. Sin CFDI no hay acreditamiento.", display: true },
  { question: "¿Cómo funciona el acreditamiento proporcional del IVA?", answer: "Cuando realizas operaciones gravadas (con IVA) y exentas (sin IVA), solo puedes acreditar el IVA en proporción a tus actividades gravadas. Fórmula: Factor = Actividades gravadas ÷ Total actividades. IVA acreditable = IVA pagado × Factor de proporción.", display: true, formula: { base: "IVA pagado", rate: "× factor proporción", result: "IVA acreditable" } },
  { question: "¿Qué gastos NO generan IVA acreditable?", answer: "No generan IVA acreditable: gastos personales no relacionados con la actividad, compras sin CFDI (tickets simples), gastos en actividades exentas de IVA, automóviles (solo el 50% del IVA es acreditable), consumos en restaurantes (solo 8.5% es deducible), y obsequios no deducibles.", display: true },
  { question: "¿Cuándo se acredita el IVA: al facturar o al pagar?", answer: "En México, el IVA se acredita cuando se paga efectivamente (criterio de flujo de efectivo), no cuando se recibe la factura. Si recibes una factura en marzo pero la pagas en abril, el IVA es acreditable en abril. Excepción: importaciones, donde se acredita al momento del despacho aduanal.", display: true },
  { question: "¿Qué pasa si mi IVA acreditable supera al trasladado?", answer: "Si el IVA acreditable es mayor que el IVA trasladado, tienes un saldo a favor. Puedes solicitar la devolución al SAT (trámite en línea, resolución en 40 días) o compensarlo contra impuestos federales propios como ISR. El saldo a favor no prescribe en 5 años.", display: true }
];

const acreditableTable = [
  { gasto: 'Materia prima', monto: '50.000 MXN', iva: '8.000 MXN', acreditable: '100%', acreditado: '8.000 MXN' },
  { gasto: 'Renta de oficina', monto: '15.000 MXN', iva: '2.400 MXN', acreditable: '100%', acreditado: '2.400 MXN' },
  { gasto: 'Servicios profesionales', monto: '10.000 MXN', iva: '1.600 MXN', acreditable: '100%', acreditado: '1.600 MXN' },
  { gasto: 'Teléfono e internet', monto: '2.000 MXN', iva: '320 MXN', acreditable: '100%', acreditado: '320 MXN' },
  { gasto: 'Automóvil (compra)', monto: '300.000 MXN', iva: '48.000 MXN', acreditable: '50%', acreditado: '24.000 MXN' },
  { gasto: 'Restaurantes', monto: '5.000 MXN', iva: '800 MXN', acreditable: '8,5%', acreditado: '68 MXN' },
  { gasto: 'Gastos personales', monto: '8.000 MXN', iva: '1.280 MXN', acreditable: '0%', acreditado: '0 MXN' },
];
---

<BaseLayout
  title={title}
  description={description}
  schemaType="WebApplication"
  isCalculator={true}
  faqItems={faqItems}
  locale="es"
>
  <section class="hero" id="hero"><div class="hero-content"><h1 class="hero-title">Calculadora <span class="gradient-text">IVA Acreditable</span></h1><p class="hero-subtitle">Determina cuánto IVA de tus compras puedes acreditar contra el IVA trasladado.<br class="hidden sm:inline" /> Calcula tu saldo de IVA a pagar o a favor para tu declaración mensual del SAT.</p></div></section>

  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <div class="mb-6"><div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-teal-500/10 border border-teal-500/20"><svg class="w-4 h-4 text-teal-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span class="text-sm font-bold text-teal-600 dark:text-teal-400">IVA Acreditable — México</span></div></div>

        <div id="calcBody" class="space-y-6">
          <div><label for="trasladoInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-indigo-500 mb-2"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg><span>IVA Trasladado (cobrado a clientes)</span></label><div class="relative"><input type="text" id="trasladoInput" class="w-full py-4 pl-5 pr-16 bg-[var(--bg-input)] border-1.5 border-indigo-500/30 rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 16.000" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-lg font-bold text-[var(--text-tertiary)]">MXN</span></div></div>

          <div><label for="gastosInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-teal-500 mb-2"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>Total gastos con IVA (CFDI recibidos)</span></label><div class="relative"><input type="text" id="gastosInput" class="w-full py-4 pl-5 pr-16 bg-[var(--bg-input)] border-1.5 border-teal-500/30 rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-teal-500 focus:ring-4 focus:ring-teal-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 62.000" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-lg font-bold text-[var(--text-tertiary)]">MXN</span></div></div>

          <div><label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-teal-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg><span>Tasa de IVA en compras</span></label>
          <div class="grid grid-cols-3 gap-2.5" role="radiogroup">
            <button type="button" class="rate-btn active flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-teal-500 bg-teal-500/5 ring-3 ring-teal-500/15 shadow-sm transition-all" data-rate="16" role="radio" aria-checked="true"><span class="font-display font-bold text-base text-[var(--text-primary)]">16%</span><span class="text-[10px] font-bold text-teal-600 dark:text-teal-400 uppercase tracking-wide">General</span></button>
            <button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-teal-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="8" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">8%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Frontera</span></button>
            <button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-teal-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="0" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">0%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Tasa 0%</span></button>
          </div></div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group"><span class="relative z-10">Calcular IVA Acreditable</span><svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg><div class="btn-shine" aria-hidden="true"></div></button>
        </div>

        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between"><p class="font-display font-extrabold text-xl gradient-text">Desglose IVA Acreditable</p><button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg><span>Modificar</span></button></div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/30 bg-indigo-500/5 shadow-sm"><span class="text-sm font-bold text-indigo-600 dark:text-indigo-400">IVA trasladado (cobrado)</span><span class="font-display font-bold text-lg text-indigo-600 dark:text-indigo-400" id="rTraslado">$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-teal-500/30 bg-teal-500/5 shadow-sm"><span class="text-sm font-bold text-teal-600 dark:text-teal-400">IVA acreditable (pagado)</span><span class="font-display font-bold text-lg text-teal-600 dark:text-teal-400" id="rAcreditable">−$0</span></div>
            <div id="resultBox" class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md"><span class="text-sm font-bold text-[var(--text-secondary)]" id="resultLabel">IVA neto</span><span class="font-display font-extrabold text-2xl gradient-text" id="rNeto">$0</span></div>
          </div>
          <div id="statusBadge" class="flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold"></div>
          <div class="flex gap-3 pt-2"><button type="button" id="copyResult" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copiar</span></button><button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Nuevo</span></button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="calcular-iva"><div class="section-container"><h2 class="section-title">3 Niveles de <span class="gradient-text">Acreditamiento del IVA</span></h2><p class="section-subtitle">No todo el IVA pagado en compras se puede acreditar. Conoce los 3 niveles de deducibilidad</p><div class="methods-grid">
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div><span class="method-number">01</span></div><h3 class="method-title">100% acreditable</h3><p class="method-desc">Materia prima, renta de oficina, servicios profesionales, papelería, software, teléfono, internet. Todo gasto directamente relacionado con la actividad gravada con CFDI válido.</p><div class="method-formula"><span class="method-formula-var">50.000 MXN</span><span class="method-formula-op">×</span><span class="method-formula-var">16%</span><span class="method-formula-op">=</span><span class="method-formula-result">8.000 MXN acred.</span></div><div class="method-example"><span class="method-example-label">Resultado</span><span>IVA 100% acreditable = <strong>$8.000</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-remove"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div><span class="method-number">02</span></div><h3 class="method-title">Parcialmente acreditable</h3><p class="method-desc">Automóviles (50% del IVA), restaurantes (solo 8,5% deducible), gastos mixtos (uso personal + profesional). Se aplica un factor de proporción al IVA pagado.</p><div class="method-formula"><span class="method-formula-var">48.000 MXN IVA</span><span class="method-formula-op">×</span><span class="method-formula-var">50%</span><span class="method-formula-op">=</span><span class="method-formula-result">24.000 MXN acred.</span></div><div class="method-example"><span class="method-example-label">Auto</span><span>Solo el 50% del IVA de autos es acreditable</span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-desglose"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></div><span class="method-number">03</span></div><h3 class="method-title">No acreditable (0%)</h3><p class="method-desc">Gastos personales, compras sin CFDI, gastos relacionados con actividades exentas de IVA, obsequios y donaciones, y gastos en bienes de uso personal.</p><div class="method-formula"><span class="method-formula-var">1.280 MXN IVA</span><span class="method-formula-op">×</span><span class="method-formula-var">0%</span><span class="method-formula-op">=</span><span class="method-formula-result">0 MXN acred.</span></div><div class="method-example"><span class="method-example-label">Sin CFDI</span><span>Sin factura = sin acreditamiento</span></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="formula-iva"><div class="section-container"><h2 class="section-title">Fórmula del <span class="gradient-text">IVA Acreditable</span></h2><p class="section-subtitle">Cómo se calcula el IVA acreditable y el saldo neto de IVA en tu declaración mensual</p><div class="formula-builder">
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-add"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/></svg><span>Acreditamiento directo (100%)</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">IVA trasladado</span><span class="formula-builder-value">$16.000</span></div><span class="formula-builder-op">−</span><div class="formula-builder-part"><span class="formula-builder-label">IVA acreditable</span><span class="formula-builder-value">$9.920</span></div><span class="formula-builder-op">=</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">IVA a pagar</span><span class="formula-builder-value">$6.080</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>IVA cobrado a clientes</span><span>$16.000,00</span></div><div class="formula-builder-breakdown-row"><span>IVA pagado en compras con CFDI</span><span>−$9.920,00</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>IVA neto a enterar al SAT</span><span>$6.080,00</span></div></div></div>
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-remove"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>Acreditamiento proporcional</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">IVA pagado</span><span class="formula-builder-value">$10.000</span></div><span class="formula-builder-op">× Factor</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Acreditable</span><span class="formula-builder-value">$7.000</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>IVA pagado en compras</span><span>$10.000,00</span></div><div class="formula-builder-breakdown-row"><span>Factor de proporción (70% gravadas)</span><span>× 0,70</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>IVA efectivamente acreditable</span><span>$7.000,00</span></div></div></div>
  </div></div></section>

  <section class="content-section" id="como-funciona"><div class="section-container"><h2 class="section-title">¿Cómo Calcular el <span class="gradient-text">IVA Acreditable</span> en 4 Pasos?</h2><p class="section-subtitle">El proceso para determinar tu IVA acreditable mensual ante el SAT</p><div class="walkthrough-steps">
    <div class="walkthrough-step" data-step="1"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">1</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📄</div><h3 class="walkthrough-step-title">1. Suma tus CFDI recibidos</h3><p class="walkthrough-step-desc">Reúne todas las facturas (CFDI) de compras y gastos del mes que estén pagadas. Solo cuentan los CFDI pagados.</p><div class="walkthrough-mini-input"><span class="mini-input-label">Gastos con CFDI</span><div class="mini-input-box">62.000 <span class="mini-input-currency">MXN</span></div></div></div></div>
    <div class="walkthrough-step" data-step="2"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">2</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">✅</div><h3 class="walkthrough-step-title">2. Extrae el IVA pagado</h3><p class="walkthrough-step-desc">Calcula el IVA de esas compras al 16% (o la tasa que aplique). Este es tu IVA potencialmente acreditable.</p></div></div>
    <div class="walkthrough-step" data-step="3"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">3</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">➖</div><h3 class="walkthrough-step-title">3. Resta del IVA trasladado</h3><p class="walkthrough-step-desc">IVA a pagar = IVA trasladado (cobrado) − IVA acreditable (pagado). Si es positivo, lo pagas al SAT.</p></div></div>
    <div class="walkthrough-step" data-step="4"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">4</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">💳</div><h3 class="walkthrough-step-title">4. Declara antes del día 17</h3><p class="walkthrough-step-desc">Presenta tu declaración mensual de IVA en el SAT antes del día 17 del mes siguiente.</p><div class="walkthrough-mini-result"><div class="mini-result-row" style="color:var(--accent-indigo)"><span>IVA trasladado</span><span class="mini-result-value">$16.000</span></div><div class="mini-result-row" style="color:#14b8a6"><span>IVA acreditable</span><span class="mini-result-value">−$9.920</span></div><div class="mini-result-row mini-result-total"><span>IVA a pagar</span><span class="mini-result-value"><strong>$6.080</strong></span></div></div></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="tabla-referencia"><div class="section-container section-container-wide"><h2 class="section-title">Tabla de <span class="gradient-text">Acreditabilidad del IVA</span></h2><p class="section-subtitle">Porcentaje de IVA acreditable por tipo de gasto según la legislación fiscal mexicana</p><div class="quick-table-wrapper"><div class="quick-table-container"><table class="quick-table"><thead><tr><th>Tipo de gasto</th><th>Monto</th><th>IVA pagado</th><th>% Acreditable</th><th>IVA acreditado</th></tr></thead><tbody>{acreditableTable.map((r) => (<tr><td><strong>{r.gasto}</strong></td><td>{r.monto}</td><td>{r.iva}</td><td>{r.acreditable}</td><td><strong>{r.acreditado}</strong></td></tr>))}</tbody></table></div></div></div></section>

  <section class="faq-section" id="faq"><div class="section-container"><h2 class="section-title">Preguntas sobre <span class="gradient-text">IVA Acreditable</span></h2><p class="section-subtitle">Todo sobre el acreditamiento del IVA en México y los requisitos del SAT</p><div class="faq-list" id="faqList">{faqItems.map((item, idx) => (<div class="faq-item" id={`faq${idx + 1}`}><button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button"><span>{item.question}</span><svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></button><div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}><p set:html={item.answer} />{item.formula && (<div class="faq-formula-mini"><div class="faq-formula-equation"><span class="faq-formula-var">{item.formula.base}</span><span class="faq-formula-op">−</span><span class="faq-formula-var">{item.formula.rate}</span><span class="faq-formula-op">=</span><span class="faq-formula-result">{item.formula.result}</span></div></div>)}</div></div>))}</div></div></section>
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded',()=>{const els={trasladoInput:document.getElementById('trasladoInput'),gastosInput:document.getElementById('gastosInput'),rateButtons:document.querySelectorAll('.rate-btn'),calcButton:document.getElementById('calcButton'),calcBody:document.getElementById('calcBody'),resultsPanel:document.getElementById('resultsPanel'),resultsClose:document.getElementById('resultsClose'),rTraslado:document.getElementById('rTraslado'),rAcreditable:document.getElementById('rAcreditable'),resultLabel:document.getElementById('resultLabel'),rNeto:document.getElementById('rNeto'),resultBox:document.getElementById('resultBox'),statusBadge:document.getElementById('statusBadge'),copyResult:document.getElementById('copyResult'),newCalc:document.getElementById('newCalc'),ambientCanvas:document.getElementById('ambientCanvas')};
let state={rate:16,lastResult:null};
els.rateButtons?.forEach(btn=>{btn.addEventListener('click',()=>{els.rateButtons.forEach(b=>{b.classList.remove('border-teal-500','bg-teal-500/5','ring-3','ring-teal-500/15');b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]');b.setAttribute('aria-checked','false')});btn.classList.add('border-teal-500','bg-teal-500/5','ring-3','ring-teal-500/15');btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]');btn.setAttribute('aria-checked','true');state.rate=parseFloat(btn.dataset.rate)})});
function initAmbient(){
  if(window.innerWidth<768||window.matchMedia('(prefers-reduced-motion: reduce)').matches){if(els.ambientCanvas)els.ambientCanvas.style.display='none';return;}
  const c=els.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0;function rs(){w=window.innerWidth;h=window.innerHeight;const d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];for(let i=0;i<Math.min(Math.floor(w*h/22000),50);i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn()}
if('requestIdleCallback' in window){requestIdleCallback(initAmbient,{timeout:2000});}else{setTimeout(initAmbient,1200);}
function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
function fm(v){return '$'+v.toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2})}
function calculate(){const rawT=els.trasladoInput?.value.trim();const rawG=els.gastosInput?.value.trim();if(!rawT||!rawG){(rawT?els.gastosInput:els.trasladoInput)?.classList.add('shake');setTimeout(()=>{els.trasladoInput?.classList.remove('shake');els.gastosInput?.classList.remove('shake')},400);return}
const traslado=pn(rawT);const gastos=pn(rawG);if(isNaN(traslado)||isNaN(gastos)){els.trasladoInput?.classList.add('shake');setTimeout(()=>els.trasladoInput?.classList.remove('shake'),400);return}
const acreditable=gastos*(state.rate/100);const neto=traslado-acreditable;state.lastResult={traslado,gastos,acreditable,neto,rate:state.rate};
els.rTraslado.textContent=fm(traslado);els.rAcreditable.textContent='−'+fm(acreditable);els.rNeto.textContent=fm(Math.abs(neto));
if(neto>0){els.resultLabel.textContent='IVA a pagar al SAT';els.resultBox.className='flex items-center justify-between p-4 rounded-xl border border-rose-500/40 bg-rose-500/5 shadow-md';els.rNeto.className='font-display font-extrabold text-2xl text-rose-600 dark:text-rose-400';els.statusBadge.innerHTML='📤 Debes enterar '+fm(neto)+' al SAT';els.statusBadge.className='flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold border border-rose-500/30 bg-rose-500/5 text-rose-600 dark:text-rose-400'}else if(neto<0){els.resultLabel.textContent='Saldo a favor';els.resultBox.className='flex items-center justify-between p-4 rounded-xl border border-teal-500/40 bg-teal-500/5 shadow-md';els.rNeto.className='font-display font-extrabold text-2xl text-teal-600 dark:text-teal-400';els.statusBadge.innerHTML='✅ Saldo a favor de '+fm(Math.abs(neto))+' — solicita devolución';els.statusBadge.className='flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold border border-teal-500/30 bg-teal-500/5 text-teal-600 dark:text-teal-400'}else{els.resultLabel.textContent='Saldo cero';els.resultBox.className='flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md';els.rNeto.className='font-display font-extrabold text-2xl gradient-text';els.statusBadge.innerHTML='⚖️ IVA trasladado y acreditable se compensan exactamente';els.statusBadge.className='flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold border border-indigo-500/30 bg-indigo-500/5 text-indigo-600 dark:text-indigo-400'}
els.calcBody.classList.add('hidden');els.resultsPanel.classList.remove('hidden')}
els.calcButton?.addEventListener('click',calculate);els.trasladoInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();els.gastosInput?.focus()}});els.gastosInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();calculate()}});
els.resultsClose?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden')});
els.newCalc?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden');els.trasladoInput.value='';els.gastosInput.value='';els.trasladoInput.focus()});
els.copyResult?.addEventListener('click',()=>{if(!state.lastResult)return;const r=state.lastResult;const t=`IVA Acreditable\nIVA trasladado: ${fm(r.traslado)}\nGastos con CFDI: ${fm(r.gastos)}\nIVA acreditable (${r.rate}%): ${fm(r.acreditable)}\nIVA neto: ${fm(r.neto)}`;navigator.clipboard.writeText(t).then(()=>{const ex=document.querySelector('.toast');if(ex)ex.remove();const toast=document.createElement('div');toast.className='toast show';toast.textContent='✓ IVA copiado';document.body.appendChild(toast);setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>toast.remove(),300)},2500)})});
document.querySelectorAll('.faq-item .faq-question').forEach(b=>{b.addEventListener('click',()=>{const i=b.closest('.faq-item');if(!i)return;const o=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>{if(x!==i){x.classList.remove('open');const btn=x.querySelector('.faq-question');if(btn)btn.setAttribute('aria-expanded','false')}});if(o){i.classList.remove('open');b.setAttribute('aria-expanded','false')}else{i.classList.add('open');b.setAttribute('aria-expanded','true')}})});
});
</script>
