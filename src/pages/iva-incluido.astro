</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const elements = {
    modeAdd: document.getElementById('modeAdd'), modeRemove: document.getElementById('modeRemove'), toggleSlider: document.getElementById('toggleSlider'), amountInput: document.getElementById('amountInput'), amountLabel: document.getElementById('amountLabel'), rateButtons: document.querySelectorAll('.rate-btn'), customRateInput: document.getElementById('customRateInput'), rateCustomBtn: document.getElementById('rateCustomBtn'), calcButton: document.getElementById('calcButton'), calcBody: document.getElementById('calcBody'), resultsPanel: document.getElementById('resultsPanel'), resultsClose: document.getElementById('resultsClose'), resultBaseLabel: document.getElementById('resultBaseLabel'), resultBaseValue: document.getElementById('resultBaseValue'), resultIvaRate: document.getElementById('resultIvaRate'), resultIvaValue: document.getElementById('resultIvaValue'), resultTotalLabel: document.getElementById('resultTotalLabel'), resultTotalValue: document.getElementById('resultTotalValue'), breakdownFill: document.getElementById('breakdownFill'), breakdownIvaFill: document.getElementById('breakdownIvaFill'), breakdownCanvas: document.getElementById('breakdownCanvas'), chartCenterPercent: document.getElementById('chartCenterPercent'), chartCenterLabel: document.getElementById('chartCenterLabel'), copyResult: document.getElementById('copyResult'), newCalc: document.getElementById('newCalc'), ambientCanvas: document.getElementById('ambientCanvas'),
  };
  let state = { mode: 'remove', rate: 21, isCustom: false, lastResult: null };

  // Ambient canvas
  !function(){const c=elements.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0,d=window.devicePixelRatio||1;const m={x:null,y:null,r:140};window.addEventListener('mousemove',e=>{m.x=e.clientX;m.y=e.clientY});window.addEventListener('mouseleave',()=>{m.x=null;m.y=null});function rs(){w=window.innerWidth;h=window.innerHeight;d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];const n=Math.min(Math.floor((w*h)/22000),50);for(let i=0;i<n;i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;if(m.x!==null&&m.y!==null){const dx=m.x-p.x,dy=m.y-p.y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<m.r&&ds>0){const f=(m.r-ds)/m.r,a=Math.atan2(dy,dx);p.x-=Math.cos(a)*f*2;p.y-=Math.sin(a)*f*2}}x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn()}();

  function setMode(mode) {
    state.mode = mode;
    elements.modeAdd.setAttribute('aria-selected', String(mode === 'add'));
    elements.modeRemove.setAttribute('aria-selected', String(mode === 'remove'));
    if (mode === 'add') { elements.modeAdd.classList.add('text-indigo-600','dark:text-indigo-400','font-bold'); elements.modeAdd.classList.remove('text-[var(--text-secondary)]','font-semibold'); elements.modeRemove.classList.remove('text-indigo-600','dark:text-indigo-400','font-bold'); elements.modeRemove.classList.add('text-[var(--text-secondary)]','font-semibold'); elements.toggleSlider.style.transform='translateX(0%)'; elements.amountLabel.textContent=elements.amountLabel.getAttribute('data-label-add'); } else { elements.modeRemove.classList.add('text-indigo-600','dark:text-indigo-400','font-bold'); elements.modeRemove.classList.remove('text-[var(--text-secondary)]','font-semibold'); elements.modeAdd.classList.remove('text-indigo-600','dark:text-indigo-400','font-bold'); elements.modeAdd.classList.add('text-[var(--text-secondary)]','font-semibold'); elements.toggleSlider.style.transform='translateX(100%)'; elements.amountLabel.textContent=elements.amountLabel.getAttribute('data-label-remove'); }
  }
  elements.modeAdd?.addEventListener('click', () => setMode('add'));
  elements.modeRemove?.addEventListener('click', () => setMode('remove'));

  elements.rateButtons?.forEach(btn => { btn.addEventListener('click', () => { const rate = btn.dataset.rate; elements.rateButtons.forEach(b => { b.classList.remove('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15'); b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]'); b.setAttribute('aria-checked','false'); }); btn.classList.add('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15'); btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]'); btn.setAttribute('aria-checked','true'); if(rate==='custom'){state.isCustom=true;elements.customRateInput?.focus();const v=pn(elements.customRateInput?.value);state.rate=isNaN(v)?0:v}else{state.isCustom=false;state.rate=parseFloat(rate)} }); });
  elements.customRateInput?.addEventListener('input', () => { if(state.isCustom){const v=pn(elements.customRateInput.value);state.rate=isNaN(v)?0:v} });
  elements.customRateInput?.addEventListener('focus', () => { elements.rateCustomBtn?.click(); });

  function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
  function fc(v){return v.toLocaleString('es-ES',{style:'currency',currency:'EUR',minimumFractionDigits:2,maximumFractionDigits:2})}
  function fr(r){return r%1===0?r.toString():r.toFixed(1)}

  function calculate() {
    const raw=elements.amountInput?.value.trim();
    if(!raw){elements.amountInput?.classList.add('shake');setTimeout(()=>elements.amountInput?.classList.remove('shake'),400);return}
    const amount=pn(raw);if(isNaN(amount)||amount<=0){elements.amountInput?.classList.add('shake');setTimeout(()=>elements.amountInput?.classList.remove('shake'),400);return}
    const rate=state.rate;let base,iva,total;
    if(state.mode==='add'){base=amount;iva=amount*(rate/100);total=amount+iva}else{total=amount;base=amount/(1+rate/100);iva=total-base}
    state.lastResult={base,iva,total,rate,mode:state.mode};showResults(base,iva,total,rate);
  }
  elements.calcButton?.addEventListener('click', calculate);
  elements.amountInput?.addEventListener('keydown', e => { if(e.key==='Enter'){e.preventDefault();calculate()} });

  let crid=null;
  function animateChart(base,iva,total){const cv=elements.breakdownCanvas;if(!cv)return;const ctx=cv.getContext('2d');if(!ctx)return;if(crid)cancelAnimationFrame(crid);const dp=window.devicePixelRatio||1,sz=170;cv.width=sz*dp;cv.height=sz*dp;ctx.scale(dp,dp);const cx=sz/2,cy=sz/2,rd=sz*.38,lw=16;const br=total>0?base/total:.8,ir=total>0?iva/total:.2;elements.chartCenterPercent.textContent=`${Math.round(ir*100)}%`;elements.chartCenterLabel.textContent=`IVA (${fr(state.rate)}%)`;const st=performance.now(),du=600;function f(now){const p=Math.min((now-st)/du,1),e=1-Math.pow(1-p,3);ctx.clearRect(0,0,sz,sz);const dk=document.documentElement.getAttribute('data-theme')==='dark';ctx.beginPath();ctx.arc(cx,cy,rd,0,Math.PI*2);ctx.strokeStyle=dk?'rgba(255,255,255,0.08)':'rgba(15,23,42,0.06)';ctx.lineWidth=lw;ctx.stroke();const sa=-Math.PI/2,ta=Math.PI*2*e,ba=ta*br,ia=ta*ir;if(ba>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa,sa+ba);const g=ctx.createLinearGradient(0,0,sz,sz);g.addColorStop(0,'#4f46e5');g.addColorStop(1,'#6366f1');ctx.strokeStyle=g;ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(ia>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa+ba,sa+ba+ia);const g=ctx.createLinearGradient(0,0,sz,sz);g.addColorStop(0,'#ec4899');g.addColorStop(1,'#c084fc');ctx.strokeStyle=g;ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(p<1)crid=requestAnimationFrame(f)}crid=requestAnimationFrame(f)}

  function showResults(base,iva,total,rate){elements.resultBaseValue.textContent=fc(base);elements.resultIvaValue.textContent=fc(iva);elements.resultTotalValue.textContent=fc(total);elements.resultIvaRate.textContent=fr(rate);elements.breakdownFill.style.width=`${(base/total)*100}%`;elements.breakdownIvaFill.style.width=`${(iva/total)*100}%`;animateChart(base,iva,total);elements.calcBody.classList.add('hidden');elements.resultsPanel.classList.remove('hidden')}
  elements.resultsClose?.addEventListener('click',()=>{elements.resultsPanel.classList.add('hidden');elements.calcBody.classList.remove('hidden')});
  elements.newCalc?.addEventListener('click',()=>{elements.resultsPanel.classList.add('hidden');elements.calcBody.classList.remove('hidden');elements.amountInput.value='';elements.amountInput.focus()});

  elements.copyResult?.addEventListener('click',()=>{if(!state.lastResult)return;const{base,iva,total,rate}=state.lastResult;const t=`Calculadora IVA Incluido\nBase imponible: ${fc(base)}\nIVA incluido (${fr(rate)}%): ${fc(iva)}\nPrecio con IVA: ${fc(total)}`;navigator.clipboard.writeText(t).then(()=>{showToast(elements.copyResult?.getAttribute('data-copied-msg')||'✓ Copiado')})});
  function showToast(msg){const ex=document.querySelector('.toast');if(ex)ex.remove();const t=document.createElement('div');t.className='toast show';t.textContent=msg;document.body.appendChild(t);setTimeout(()=>{t.classList.remove('show');setTimeout(()=>t.remove(),300)},2500)}

  document.querySelectorAll('.faq-item .faq-question').forEach(button=>{button.addEventListener('click',()=>{const item=button.closest('.faq-item');if(!item)return;const isOpen=item.classList.contains('open');document.querySelectorAll('.faq-item').forEach(i=>{if(i!==item){i.classList.remove('open');const b=i.querySelector('.faq-question');if(b)b.setAttribute('aria-expanded','false')}});if(isOpen){item.classList.remove('open');button.setAttribute('aria-expanded','false')}else{item.classList.add('open');button.setAttribute('aria-expanded','true')}})});
  document.querySelectorAll('.walkthrough-mini-rates .mini-rate-btn').forEach(btn=>{btn.addEventListener('click',()=>{const p=btn.closest('.walkthrough-mini-rates');if(p){p.querySelectorAll('.mini-rate-btn').forEach(b=>b.classList.remove('mini-rate-active'));btn.classList.add('mini-rate-active')}})});
});
</script>
