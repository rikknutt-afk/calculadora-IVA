---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA Incluido — Extrae el IVA de un Precio con Impuesto";
const description = "Calculadora de IVA incluido para extraer la base imponible y la cuota de IVA de un precio bruto. Introduce un importe con IVA incluido y obtén el desglose al instante para España.";

const faqItems = [
  {
    question: "¿Cómo se calcula el IVA incluido en un precio?",
    answer: "Para extraer el IVA incluido en un precio, divide el precio bruto entre (1 + tipo/100). Con el 21%: Base = Precio con IVA ÷ 1,21. Ejemplo: 242 € ÷ 1,21 = 200 € de base imponible. El IVA incluido era: 242 − 200 = 42 €.",
    display: true,
    formula: { base: "242 €", rate: "÷ 1,21", result: "200 € base" }
  },
  {
    question: "¿Cuál es la base imponible de un precio de 121 € con IVA incluido?",
    answer: "Si el precio de 121 € ya incluye el 21% de IVA: 121 ÷ 1,21 = 100 € de base imponible. La cuota de IVA es 121 − 100 = 21 €. Así, el producto vale realmente 100 € antes de impuestos.",
    display: true,
    formula: { base: "121 €", rate: "÷ 1,21", result: "100 € base" }
  },
  {
    question: "¿Cómo saber cuánto IVA tiene un precio final?",
    answer: "Usa la fórmula del IVA inverso: IVA = Precio final − (Precio final ÷ (1 + tipo/100)). Con el 21%: IVA = Precio − (Precio ÷ 1,21). Ejemplo: un producto de 605 € con IVA incluido tiene 605 − (605 ÷ 1,21) = 605 − 500 = 105 € de IVA.",
    display: true,
    formula: { base: "605 €", rate: "÷ 1,21 =", result: "105 € IVA" }
  },
  {
    question: "¿Es lo mismo IVA incluido que IVA repercutido?",
    answer: "No exactamente. «IVA incluido» significa que el precio ya contiene el impuesto, es la perspectiva del comprador. «IVA repercutido» es el IVA que el vendedor carga al cliente en la factura. El importe es el mismo, pero el concepto fiscal difiere.",
    display: true
  },
  {
    question: "¿Cómo extraer el IVA al 10% de un precio con IVA incluido?",
    answer: "Para el tipo reducido del 10%, divide entre 1,10. Ejemplo: un billete de tren de 55 € con IVA incluido: 55 ÷ 1,10 = 50 € de base imponible. El IVA al 10% era: 55 − 50 = 5 €.",
    display: true,
    formula: { base: "55 €", rate: "÷ 1,10", result: "50 € base" }
  },
  {
    question: "¿Por qué es importante conocer el IVA incluido en un ticket?",
    answer: "Conocer el IVA incluido te permite: verificar que el comercio aplica el tipo correcto, deducir el IVA soportado si eres autónomo o empresa, reclamar devoluciones de IVA en compras intracomunitarias y llevar una contabilidad precisa.",
    display: true
  }
];

const quickTableData = [
  { total: '12,10 €', base: '10,00 €', iva: '2,10 €' },
  { total: '24,20 €', base: '20,00 €', iva: '4,20 €' },
  { total: '60,50 €', base: '50,00 €', iva: '10,50 €' },
  { total: '121,00 €', base: '100,00 €', iva: '21,00 €' },
  { total: '181,50 €', base: '150,00 €', iva: '31,50 €' },
  { total: '302,50 €', base: '250,00 €', iva: '52,50 €' },
  { total: '605,00 €', base: '500,00 €', iva: '105,00 €' },
  { total: '1.210,00 €', base: '1.000,00 €', iva: '210,00 €' },
  { total: '2.420,00 €', base: '2.000,00 €', iva: '420,00 €' },
  { total: '3.630,00 €', base: '3.000,00 €', iva: '630,00 €' },
  { total: '6.050,00 €', base: '5.000,00 €', iva: '1.050,00 €' },
  { total: '12.100,00 €', base: '10.000,00 €', iva: '2.100,00 €' },
];
---

<BaseLayout
  title={title}
  description={description}
  schemaType="WebSite"
  faqItems={faqItems}
  locale="es"
>
  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="hero-content">
      <h1 class="hero-title">Calculadora <span class="gradient-text">IVA Incluido</span></h1>
      <p class="hero-subtitle">¿Tu precio ya incluye el IVA? Extrae la base imponible y la cuota de IVA<br class="hidden sm:inline" /> de cualquier importe bruto de forma instantánea y precisa.</p>
    </div>
  </section>

  <!-- Calculator Section -->
  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <!-- Mode Toggle - Defaults to REMOVE -->
        <div class="flex relative bg-[var(--bg-toggle)] border border-[var(--border-subtle)] rounded-xl p-1 mb-8" role="tablist" aria-label="Modo de cálculo">
          <button type="button" id="modeAdd" data-mode="add" class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg text-sm font-semibold text-[var(--text-secondary)] transition-all relative z-10" role="tab" aria-selected="false">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Añadir IVA</span>
          </button>
          <button type="button" id="modeRemove" data-mode="remove" class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg text-sm font-bold text-indigo-600 dark:text-indigo-400 transition-all relative z-10" role="tab" aria-selected="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Extraer IVA incluido</span>
          </button>
          <div id="toggleSlider" class="absolute top-1 left-1 w-[calc(50%-4px)] h-[calc(100%-8px)] bg-[var(--bg-pill)] rounded-lg shadow-md transition-transform duration-300 pointer-events-none" style="transform: translateX(100%)"></div>
        </div>

        <!-- Input -->
        <div id="calcBody" class="space-y-6">
          <div>
            <label for="amountInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2">
              <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
              <span id="amountLabel" data-label-add="Importe sin IVA (Base)" data-label-remove="Precio con IVA incluido">Precio con IVA incluido</span>
            </label>
            <div class="relative">
              <input type="text" id="amountInput" class="w-full py-4 pl-5 pr-12 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 121,00" inputmode="decimal" autocomplete="off" aria-label="Precio con IVA incluido" />
              <span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-xl font-bold text-[var(--text-tertiary)]">€</span>
            </div>
          </div>

          <!-- Rate Buttons -->
          <div>
            <label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2">
              <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <span>Tipo de IVA aplicado</span>
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" role="radiogroup" aria-label="Tipo de IVA incluido">
              <button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="4" role="radio" aria-checked="false">
                <span class="font-display font-bold text-base text-[var(--text-primary)]">4%</span>
                <span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Superreducido</span>
              </button>
              <button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="10" role="radio" aria-checked="false">
                <span class="font-display font-bold text-base text-[var(--text-primary)]">10%</span>
                <span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Reducido</span>
              </button>
              <button type="button" class="rate-btn active flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-indigo-500 bg-indigo-500/5 ring-3 ring-indigo-500/15 shadow-sm transition-all" data-rate="21" role="radio" aria-checked="true">
                <span class="font-display font-bold text-base text-[var(--text-primary)]">21%</span>
                <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wide">General</span>
              </button>
              <button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" id="rateCustomBtn" data-rate="custom" role="radio" aria-checked="false">
                <span class="font-display font-bold text-base text-[var(--text-primary)] flex items-center">
                  <input type="text" id="customRateInput" class="w-8 text-center bg-transparent border-b border-[var(--text-tertiary)] focus:border-indigo-500 outline-none text-base font-bold text-[var(--text-primary)]" placeholder="?" inputmode="decimal" />%
                </span>
                <span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Personalizado</span>
              </button>
            </div>
          </div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group">
            <span class="relative z-10">Extraer IVA Incluido</span>
            <svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            <div class="btn-shine" aria-hidden="true"></div>
          </button>
        </div>

        <!-- Results Panel -->
        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between">
            <h3 class="font-display font-extrabold text-xl gradient-text">IVA Extraído del Precio</h3>
            <button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
              <span>Modificar</span>
            </button>
          </div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm">
              <span class="text-sm font-semibold text-[var(--text-secondary)]" id="resultBaseLabel">Base imponible</span>
              <span class="font-display font-bold text-lg text-[var(--text-primary)]" id="resultBaseValue">0,00 €</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm">
              <span class="text-sm font-semibold text-[var(--text-secondary)]">IVA incluido (<span id="resultIvaRate">21</span>%)</span>
              <span class="font-display font-bold text-lg text-[var(--text-primary)]" id="resultIvaValue">0,00 €</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md">
              <span class="text-sm font-bold text-[var(--text-secondary)]" id="resultTotalLabel">Precio con IVA</span>
              <span class="font-display font-extrabold text-2xl gradient-text" id="resultTotalValue">0,00 €</span>
            </div>
          </div>
          <div class="relative w-[170px] h-[170px] mx-auto flex items-center justify-center">
            <canvas id="breakdownCanvas" class="w-[170px] h-[170px] block drop-shadow-md" width="170" height="170" aria-label="Desglose IVA incluido"></canvas>
            <div class="absolute flex flex-col items-center justify-center pointer-events-none">
              <span id="chartCenterPercent" class="font-display font-extrabold text-2xl text-[var(--text-primary)] leading-none">21%</span>
              <span id="chartCenterLabel" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mt-1">IVA</span>
            </div>
          </div>
          <div class="flex h-7 rounded-full overflow-hidden bg-[var(--bg-toggle)] border border-[var(--border-subtle)] shadow-inner">
            <div id="breakdownFill" class="flex items-center justify-center bg-gradient-to-r from-indigo-600 to-indigo-500 text-white font-extrabold text-[10px] uppercase tracking-wider transition-all duration-500 min-w-[36px]">Base</div>
            <div id="breakdownIvaFill" class="flex items-center justify-center bg-gradient-to-r from-pink-500 to-purple-500 text-white font-extrabold text-[10px] uppercase tracking-wider transition-all duration-500 min-w-[28px]">IVA</div>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="button" id="copyResult" data-copied-msg="✓ Desglose copiado al portapapeles" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copiar</span>
            </button>
            <button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
              <span>Nuevo Cálculo</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Methods Section -->
  <section class="content-section" id="calcular-iva">
    <div class="section-container">
      <h2 class="section-title">¿Cómo Calcular el <span class="gradient-text">IVA Incluido</span>?</h2>
      <p class="section-subtitle">3 escenarios habituales en los que necesitas extraer el IVA de un precio que ya lo incluye: ticket de compra, presupuesto y factura recibida.</p>
      <div class="methods-grid">
        <div class="method-card">
          <div class="method-icon-wrapper">
            <div class="method-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <span class="method-number">01</span>
          </div>
          <h3 class="method-title">IVA incluido en un ticket de compra</h3>
          <p class="method-desc">El precio del producto en tienda ya incluye el IVA. Divide entre 1,21 para saber cuánto pagaste realmente por el producto y cuánto fue impuesto.</p>
          <div class="method-formula">
            <span class="method-formula-var">Precio PVP</span>
            <span class="method-formula-op">÷</span>
            <span class="method-formula-var">1,21</span>
            <span class="method-formula-op">=</span>
            <span class="method-formula-result">Precio sin IVA</span>
          </div>
          <div class="method-example">
            <span class="method-example-label">Ejemplo</span>
            <span>59,99 € ÷ 1,21 = <strong>49,58 €</strong> (IVA: 10,41 €)</span>
          </div>
        </div>

        <div class="method-card">
          <div class="method-icon-wrapper">
            <div class="method-icon method-icon-remove">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <span class="method-number">02</span>
          </div>
          <h3 class="method-title">IVA incluido en un presupuesto</h3>
          <p class="method-desc">Un presupuesto muestra el total «IVA incluido». Extrae la base para comparar ofertas de distintos proveedores sin que el impuesto distorsione la comparación.</p>
          <div class="method-formula">
            <span class="method-formula-var">Presupuesto total</span>
            <span class="method-formula-op">÷</span>
            <span class="method-formula-var">(1 + IVA/100)</span>
            <span class="method-formula-op">=</span>
            <span class="method-formula-result">Coste real</span>
          </div>
          <div class="method-example">
            <span class="method-example-label">Ejemplo</span>
            <span>3.025 € ÷ 1,21 = <strong>2.500,00 €</strong> (IVA: 525 €)</span>
          </div>
        </div>

        <div class="method-card">
          <div class="method-icon-wrapper">
            <div class="method-icon method-icon-desglose">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            </div>
            <span class="method-number">03</span>
          </div>
          <h3 class="method-title">IVA incluido en factura recibida</h3>
          <p class="method-desc">Cuando recibes una factura con el total final, necesitas desglosar base e IVA para registrar correctamente el IVA soportado en tu contabilidad fiscal.</p>
          <div class="method-formula">
            <span class="method-formula-var">Total factura</span>
            <span class="method-formula-op">−</span>
            <span class="method-formula-var">(Total ÷ 1,21)</span>
            <span class="method-formula-op">=</span>
            <span class="method-formula-result">IVA soportado</span>
          </div>
          <div class="method-example">
            <span class="method-example-label">Ejemplo</span>
            <span>1.210 € − 1.000 € = <strong>210,00 € IVA</strong></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Formula Section -->
  <section class="content-section content-section-alt" id="formula-iva">
    <div class="section-container">
      <h2 class="section-title">Fórmula para Extraer el <span class="gradient-text">IVA Incluido</span></h2>
      <p class="section-subtitle">La fórmula inversa del IVA: divide el precio bruto entre el factor (1 + tipo) para separar base imponible e impuesto</p>
      <div class="formula-builder">
        <div class="formula-builder-card">
          <div class="formula-builder-header">
            <div class="formula-builder-badge formula-builder-badge-remove">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>Extraer IVA incluido</span>
            </div>
          </div>
          <div class="formula-builder-equation">
            <div class="formula-builder-part">
              <span class="formula-builder-label">Precio con IVA</span>
              <span class="formula-builder-value">605,00 €</span>
            </div>
            <span class="formula-builder-op">÷</span>
            <div class="formula-builder-part">
              <span class="formula-builder-label">Factor IVA 21%</span>
              <span class="formula-builder-value">1,21</span>
            </div>
            <span class="formula-builder-op">=</span>
            <div class="formula-builder-part formula-builder-part-result">
              <span class="formula-builder-label">Base imponible</span>
              <span class="formula-builder-value">500,00 €</span>
            </div>
          </div>
          <div class="formula-builder-breakdown">
            <div class="formula-builder-breakdown-row">
              <span>Precio con IVA incluido</span>
              <span>605,00 €</span>
            </div>
            <div class="formula-builder-breakdown-row">
              <span>IVA extraído (21%)</span>
              <span>105,00 €</span>
            </div>
            <div class="formula-builder-breakdown-row formula-builder-breakdown-total">
              <span>Base imponible real</span>
              <span>500,00 €</span>
            </div>
          </div>
        </div>
        <div class="formula-builder-card">
          <div class="formula-builder-header">
            <div class="formula-builder-badge formula-builder-badge-add">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>Verificar: Añadir IVA</span>
            </div>
          </div>
          <div class="formula-builder-equation">
            <div class="formula-builder-part">
              <span class="formula-builder-label">Base imponible</span>
              <span class="formula-builder-value">500,00 €</span>
            </div>
            <span class="formula-builder-op">×</span>
            <div class="formula-builder-part">
              <span class="formula-builder-label">Factor IVA 21%</span>
              <span class="formula-builder-value">1,21</span>
            </div>
