  <!-- FAQ Section -->
  <section class="faq-section" id="faq">
    <div class="section-container">
      <h2 class="section-title">Preguntas sobre <span class="gradient-text">IVA Incluido</span></h2>
      <p class="section-subtitle">Dudas frecuentes sobre cómo extraer el IVA de precios que ya lo incluyen, con fórmulas y ejemplos</p>
