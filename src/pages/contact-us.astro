---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import siteConfig from '../config/site.json';
---

<BaseLayout
  title={`Contact Us — ${siteConfig.siteName}`}
  description="Contact the Calculadora IVA team for assistance, feature suggestions, or business inquiries."
  schemaType="ContactPage"
>
  <div class="max-w-2xl mx-auto py-8">
    <div class="text-center mb-10">
      <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-[var(--text-primary)] mb-3">
        Get in <span class="gradient-text">Touch</span>
      </h1>
      <p class="text-[var(--text-secondary)] text-sm sm:text-base leading-relaxed">
        Have feedback, suggestions, or need help with a complex tax calculation? Send us a message and our team will get back to you shortly.
      </p>
    </div>

    <!-- Contact Form Component -->
    <ContactForm locale="en" />
  </div>
</BaseLayout>
