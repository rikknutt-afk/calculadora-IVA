  <!-- FAQ Section -->
  <section class="faq-section" id="faq">
    <div class="section-container">
      <h2 class="section-title">Preguntas sobre el IVA de una <span class="gradient-text">Cantidad</span></h2>
      <p class="section-subtitle">Resuelve tus dudas sobre cómo calcular el IVA de cualquier cantidad, con ejemplos prácticos y fórmulas claras</p>
      <div class="faq-list" id="faqList">
        {faqItems.map((item, idx) => (
          <div class="faq-item" id={`faq${idx + 1}`}>
