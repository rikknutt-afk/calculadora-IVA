---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA de una Cantidad — Cálculo al Instante";
const description = "Calcula el IVA de cualquier cantidad al instante. Obtén la cuota de IVA, la base imponible y el total con desglose oficial para España y Latinoamérica.";

const faqItems = [
  {
    question: "¿Cómo se calcula el IVA de una cantidad?",
    answer: "Para calcular el IVA de una cantidad, multiplica el importe por el tipo de IVA en formato decimal. Por ejemplo, para una cantidad de 750 € al 21%: 750 × 0,21 = 157,50 € de IVA. El total con IVA sería 750 + 157,50 = 907,50 €.",
    display: true,
    formula: { base: "750 €", rate: "0,21", result: "157,50 € IVA" }
  },
  {
    question: "¿Cuánto IVA tiene una cantidad de 500 €?",
    answer: "El IVA de 500 € depende del tipo impositivo aplicable. Al 21% (general): 500 × 0,21 = 105 € de IVA (total 605 €). Al 10% (reducido): 500 × 0,10 = 50 € de IVA (total 550 €). Al 4% (superreducido): 500 × 0,04 = 20 € de IVA (total 520 €).",
    display: true
  },
  {
    question: "¿Cómo calcular el IVA de una cantidad con decimales?",
    answer: "El procedimiento es idéntico al de cantidades enteras. Multiplica la cantidad con decimales por el porcentaje de IVA. Ejemplo: 349,99 € × 0,21 = 73,4979 €, que se redondea a 73,50 € de IVA. Total: 349,99 + 73,50 = 423,49 €.",
    display: true,
    formula: { base: "349,99 €", rate: "0,21", result: "73,50 € IVA" }
  },
  {
    question: "¿Se puede calcular el IVA de una cantidad en otra moneda?",
    answer: "Sí. La fórmula del IVA es universal: Cantidad × Tipo de IVA = Cuota de IVA. Funciona igual con euros (€), pesos mexicanos (MXN), pesos colombianos (COP) o cualquier otra divisa. Solo cambia el tipo impositivo según el país.",
    display: true
  },
  {
    question: "¿Qué diferencia hay entre calcular el IVA de una cantidad y calcular el IVA incluido?",
    answer: "Calcular el IVA de una cantidad parte de un precio neto (sin IVA) y le suma el impuesto. Calcular el IVA incluido parte de un precio bruto (con IVA) y extrae la cuota de IVA. La fórmula inversa es: Base = Total ÷ (1 + Tipo/100).",
    display: true
  },
  {
    question: "¿Cómo calcular el IVA de una cantidad para distintos tipos de productos?",
    answer: "Identifica primero qué tipo de IVA aplica al producto: 21% para electrónica, ropa o servicios; 10% para alimentos, transporte u hostelería; 4% para pan, leche, libros o medicamentos. Luego multiplica la cantidad por el porcentaje correspondiente.",
    display: true
  }
];

const quickTableData = [
  { cantidad: '50 €', iva4: '2,00 €', total4: '52,00 €', iva10: '5,00 €', total10: '55,00 €', iva21: '10,50 €', total21: '60,50 €' },
  { cantidad: '100 €', iva4: '4,00 €', total4: '104,00 €', iva10: '10,00 €', total10: '110,00 €', iva21: '21,00 €', total21: '121,00 €' },
  { cantidad: '250 €', iva4: '10,00 €', total4: '260,00 €', iva10: '25,00 €', total10: '275,00 €', iva21: '52,50 €', total21: '302,50 €' },
  { cantidad: '500 €', iva4: '20,00 €', total4: '520,00 €', iva10: '50,00 €', total10: '550,00 €', iva21: '105,00 €', total21: '605,00 €' },
  { cantidad: '750 €', iva4: '30,00 €', total4: '780,00 €', iva10: '75,00 €', total10: '825,00 €', iva21: '157,50 €', total21: '907,50 €' },
  { cantidad: '1.000 €', iva4: '40,00 €', total4: '1.040,00 €', iva10: '100,00 €', total10: '1.100,00 €', iva21: '210,00 €', total21: '1.210,00 €' },
  { cantidad: '2.500 €', iva4: '100,00 €', total4: '2.600,00 €', iva10: '250,00 €', total10: '2.750,00 €', iva21: '525,00 €', total21: '3.025,00 €' },
  { cantidad: '5.000 €', iva4: '200,00 €', total4: '5.200,00 €', iva10: '500,00 €', total10: '5.500,00 €', iva21: '1.050,00 €', total21: '6.050,00 €' },
  { cantidad: '10.000 €', iva4: '400,00 €', total4: '10.400,00 €', iva10: '1.000,00 €', total10: '11.000,00 €', iva21: '2.100,00 €', total21: '12.100,00 €' },
  { cantidad: '25.000 €', iva4: '1.000,00 €', total4: '26.000,00 €', iva10: '2.500,00 €', total10: '27.500,00 €', iva21: '5.250,00 €', total21: '30.250,00 €' },
];
---

<BaseLayout
  title={title}
  description={description}
  schemaType="WebSite"
  faqItems={faqItems}
  locale="es"
>
  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="hero-content">
      <h1 class="hero-title">Calculadora IVA de una <span class="gradient-text">Cantidad</span></h1>
      <p class="hero-subtitle">Introduce cualquier importe y descubre al instante la cuota de IVA,<br class="hidden sm:inline" /> la base imponible y el precio final con IVA para los 3 tipos de España.</p>
    </div>
  </section>

  <!-- Calculator Section -->
  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <!-- Mode Toggle -->
        <div class="flex relative bg-[var(--bg-toggle)] border border-[var(--border-subtle)] rounded-xl p-1 mb-8" role="group" aria-label="Modo de cálculo">
          <button type="button" id="modeAdd" data-mode="add" class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg text-sm font-bold text-indigo-600 dark:text-indigo-400 transition-all relative z-10" aria-pressed="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Sumar IVA a cantidad</span>
          </button>
          <button type="button" id="modeRemove" data-mode="remove" class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-lg text-sm font-semibold text-[var(--text-secondary)] transition-all relative z-10" aria-pressed="false">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Extraer IVA de cantidad</span>
          </button>
          <div id="toggleSlider" class="absolute top-1 left-1 w-[calc(50%-4px)] h-[calc(100%-8px)] bg-[var(--bg-pill)] rounded-lg shadow-md transition-transform duration-300 pointer-events-none"></div>
        </div>

        <!-- Input -->
        <div id="calcBody" class="space-y-6">
          <div>
            <label for="amountInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2">
              <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
              <span id="amountLabel" data-label-add="Cantidad sin IVA" data-label-remove="Cantidad con IVA incluido">Cantidad sin IVA</span>
            </label>
            <div class="relative">
              <input type="text" id="amountInput" class="w-full py-4 pl-5 pr-12 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 750,00" inputmode="decimal" autocomplete="off" aria-label="Cantidad" />
              <span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-xl font-bold text-[var(--text-tertiary)]">€</span>
            </div>
          </div>

          <!-- Rate Buttons -->
          <div>
            <label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2">
              <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
              <span>Tipo de IVA</span>
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" role="radiogroup" aria-label="Seleccionar tipo de IVA">
              <button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="4" role="radio" aria-checked="false">
                <span class="font-display font-bold text-base text-[var(--text-primary)]">4%</span>
                <span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Superreducido</span>
              </button>
              <button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="10" role="radio" aria-checked="false">
                <span class="font-display font-bold text-base text-[var(--text-primary)]">10%</span>
                <span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Reducido</span>
              </button>
              <button type="button" class="rate-btn active flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-indigo-500 bg-indigo-500/5 ring-3 ring-indigo-500/15 shadow-sm transition-all" data-rate="21" role="radio" aria-checked="true">
                <span class="font-display font-bold text-base text-[var(--text-primary)]">21%</span>
                <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wide">General</span>
              </button>
              <div class="cursor-pointer rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" id="rateCustomBtn" data-rate="custom" role="radio" aria-checked="false" tabindex="0">
                <span class="font-display font-bold text-base text-[var(--text-primary)] flex items-center">
                  <input type="text" id="customRateInput" aria-label="Tipo de IVA personalizado" class="w-8 text-center bg-transparent border-b border-[var(--text-tertiary)] focus:border-indigo-500 outline-none text-base font-bold text-[var(--text-primary)]" placeholder="?" inputmode="decimal" />%
                </span>
                <span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Personalizado</span>
              </div>
            </div>
          </div>

          <!-- Calculate Button -->
          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group">
            <span class="relative z-10">Calcular IVA de la Cantidad</span>
            <svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            <div class="btn-shine" aria-hidden="true"></div>
          </button>
        </div>

        <!-- Results Panel -->
        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between">
            <p class="font-display font-extrabold text-xl gradient-text">Desglose de tu Cantidad</p>
            <button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
              <span>Modificar</span>
            </button>
          </div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm">
              <span class="text-sm font-semibold text-[var(--text-secondary)]" id="resultBaseLabel">Cantidad neta</span>
              <span class="font-display font-bold text-lg text-[var(--text-primary)]" id="resultBaseValue">0,00 €</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm">
              <span class="text-sm font-semibold text-[var(--text-secondary)]">Cuota de IVA (<span id="resultIvaRate">21</span>%)</span>
              <span class="font-display font-bold text-lg text-[var(--text-primary)]" id="resultIvaValue">0,00 €</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md">
              <span class="text-sm font-bold text-[var(--text-secondary)]" id="resultTotalLabel">Total con IVA</span>
              <span class="font-display font-extrabold text-2xl gradient-text" id="resultTotalValue">0,00 €</span>
            </div>
          </div>

          <!-- Donut Chart -->
          <div class="relative w-[170px] h-[170px] mx-auto flex items-center justify-center">
            <canvas id="breakdownCanvas" class="w-[170px] h-[170px] block drop-shadow-md" width="170" height="170" aria-label="Gráfico de desglose de IVA"></canvas>
            <div class="absolute flex flex-col items-center justify-center pointer-events-none">
              <span id="chartCenterPercent" class="font-display font-extrabold text-2xl text-[var(--text-primary)] leading-none">21%</span>
              <span id="chartCenterLabel" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mt-1">IVA</span>
            </div>
          </div>

          <!-- Bar -->
          <div class="flex h-7 rounded-full overflow-hidden bg-[var(--bg-toggle)] border border-[var(--border-subtle)] shadow-inner">
            <div id="breakdownFill" class="flex items-center justify-center bg-gradient-to-r from-indigo-600 to-indigo-500 text-white font-extrabold text-[10px] uppercase tracking-wider transition-all duration-500 min-w-[36px]">Cantidad</div>
            <div id="breakdownIvaFill" class="flex items-center justify-center bg-gradient-to-r from-pink-500 to-purple-500 text-white font-extrabold text-[10px] uppercase tracking-wider transition-all duration-500 min-w-[28px]">IVA</div>
          </div>

          <!-- Actions -->
          <div class="flex gap-3 pt-2">
            <button type="button" id="copyResult" data-copied-msg="✓ Resultado copiado al portapapeles" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copiar</span>
            </button>
            <button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
              <span>Nueva Cantidad</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Methods Section: 3 Ways to Calculate IVA of an Amount -->
  <section class="content-section" id="calcular-iva">
    <div class="section-container">
      <h2 class="section-title">3 Formas de Calcular el IVA de una <span class="gradient-text">Cantidad</span></h2>
      <p class="section-subtitle">Elige el método que mejor se ajuste a tu necesidad: a partir de la cantidad neta, desde el total bruto, o comparando importes para deducir el IVA aplicado.</p>
      <div class="methods-grid">
        <div class="method-card">
          <div class="method-icon-wrapper">
            <div class="method-icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
            <span class="method-number">01</span>
          </div>
          <h3 class="method-title">Sumar IVA a una cantidad neta</h3>
          <p class="method-desc">Partes de una cantidad sin IVA y le aplicas el porcentaje del impuesto para obtener el importe total a pagar con IVA incluido.</p>
          <div class="method-formula">
            <span class="method-formula-var">Cantidad</span>
            <span class="method-formula-op">×</span>
            <span class="method-formula-var">(1 + IVA/100)</span>
            <span class="method-formula-op">=</span>
            <span class="method-formula-result">Total</span>
          </div>
          <div class="method-example">
            <span class="method-example-label">Ejemplo</span>
            <span>750 € × 1,21 = <strong>907,50 €</strong></span>
          </div>
        </div>

        <div class="method-card">
          <div class="method-icon-wrapper">
            <div class="method-icon method-icon-remove">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </div>
            <span class="method-number">02</span>
          </div>
          <h3 class="method-title">Extraer el IVA de una cantidad bruta</h3>
          <p class="method-desc">Si la cantidad ya incluye el IVA, divide entre el factor (1 + tipo) para separar la base imponible y la cuota de IVA pagada.</p>
          <div class="method-formula">
            <span class="method-formula-var">Cantidad bruta</span>
            <span class="method-formula-op">÷</span>
            <span class="method-formula-var">1,21</span>
            <span class="method-formula-op">=</span>
            <span class="method-formula-result">Base imponible</span>
          </div>
          <div class="method-example">
            <span class="method-example-label">Ejemplo</span>
            <span>907,50 € ÷ 1,21 = <strong>750,00 €</strong></span>
          </div>
        </div>

        <div class="method-card">
          <div class="method-icon-wrapper">
            <div class="method-icon method-icon-desglose">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            </div>
            <span class="method-number">03</span>
          </div>
          <h3 class="method-title">Calcular solo la cuota de IVA</h3>
          <p class="method-desc">Obtén exclusivamente el monto del impuesto multiplicando la cantidad neta por el porcentaje de IVA en decimal, sin sumar al precio.</p>
          <div class="method-formula">
            <span class="method-formula-var">Cantidad</span>
            <span class="method-formula-op">×</span>
            <span class="method-formula-var">0,21</span>
            <span class="method-formula-op">=</span>
            <span class="method-formula-result">Cuota IVA</span>
          </div>
          <div class="method-example">
            <span class="method-example-label">Ejemplo</span>
            <span>750 € × 0,21 = <strong>157,50 €</strong></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Formula Section -->
  <section class="content-section content-section-alt" id="formula-iva">
    <div class="section-container">
      <h2 class="section-title">Fórmula del IVA Aplicada a una <span class="gradient-text">Cantidad</span></h2>
      <p class="section-subtitle">Dos fórmulas esenciales: una para añadir el IVA a cualquier cantidad y otra para extraerlo de un importe que ya lo incluye</p>
      <div class="formula-builder">
        <div class="formula-builder-card">
          <div class="formula-builder-header">
            <div class="formula-builder-badge formula-builder-badge-add">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>IVA sobre cantidad neta</span>
            </div>
          </div>
          <div class="formula-builder-equation">
            <div class="formula-builder-part">
              <span class="formula-builder-label">Cantidad neta</span>
              <span class="formula-builder-value">750 €</span>
            </div>
            <span class="formula-builder-op">×</span>
            <div class="formula-builder-part">
              <span class="formula-builder-label">Factor IVA</span>
              <span class="formula-builder-value">(1 + 21/100)</span>
            </div>
            <span class="formula-builder-op">=</span>
            <div class="formula-builder-part formula-builder-part-result">
              <span class="formula-builder-label">Total con IVA</span>
              <span class="formula-builder-value">907,50 €</span>
            </div>
          </div>
          <div class="formula-builder-breakdown">
            <div class="formula-builder-breakdown-row">
              <span>Cantidad introducida</span>
              <span>750,00 €</span>
            </div>
            <div class="formula-builder-breakdown-row">
              <span>Cuota de IVA (21%)</span>
              <span>157,50 €</span>
            </div>
            <div class="formula-builder-breakdown-row formula-builder-breakdown-total">
              <span>Total a pagar</span>
              <span>907,50 €</span>
            </div>
          </div>
        </div>
        <div class="formula-builder-card">
          <div class="formula-builder-header">
            <div class="formula-builder-badge formula-builder-badge-remove">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <span>IVA desde cantidad bruta</span>
            </div>
          </div>
          <div class="formula-builder-equation">
