</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const elements = {
    modeAdd: document.getElementById('modeAdd'),
    modeRemove: document.getElementById('modeRemove'),
    toggleSlider: document.getElementById('toggleSlider'),
    amountInput: document.getElementById('amountInput'),
    amountLabel: document.getElementById('amountLabel'),
    rateButtons: document.querySelectorAll('.rate-btn'),
    customRateInput: document.getElementById('customRateInput'),
    rateCustomBtn: document.getElementById('rateCustomBtn'),
    calcButton: document.getElementById('calcButton'),
    calcBody: document.getElementById('calcBody'),
    resultsPanel: document.getElementById('resultsPanel'),
    resultsClose: document.getElementById('resultsClose'),
    resultBaseLabel: document.getElementById('resultBaseLabel'),
    resultBaseValue: document.getElementById('resultBaseValue'),
    resultIvaRate: document.getElementById('resultIvaRate'),
    resultIvaValue: document.getElementById('resultIvaValue'),
    resultTotalLabel: document.getElementById('resultTotalLabel'),
    resultTotalValue: document.getElementById('resultTotalValue'),
    breakdownFill: document.getElementById('breakdownFill'),
    breakdownIvaFill: document.getElementById('breakdownIvaFill'),
    breakdownCanvas: document.getElementById('breakdownCanvas'),
    chartCenterPercent: document.getElementById('chartCenterPercent'),
    chartCenterLabel: document.getElementById('chartCenterLabel'),
    copyResult: document.getElementById('copyResult'),
    newCalc: document.getElementById('newCalc'),
    ambientCanvas: document.getElementById('ambientCanvas'),
  };
  let state = { mode: 'add', rate: 21, isCustom: false, lastResult: null };

  function initAmbientCanvas() {
    if (window.innerWidth < 768 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (elements.ambientCanvas) elements.ambientCanvas.style.display = 'none';
      return;
    }
    const canvas = elements.ambientCanvas; if (!canvas) return;
    const ctx = canvas.getContext('2d'); if (!ctx) return;
    let width = 0, height = 0, dpr = window.devicePixelRatio || 1;
    const mouse = { x: null, y: null, radius: 140 };
    window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });
    window.addEventListener('mouseleave', () => { mouse.x = null; mouse.y = null; });
    function resize() { width = window.innerWidth; height = window.innerHeight; dpr = window.devicePixelRatio || 1; canvas.width = width * dpr; canvas.height = height * dpr; canvas.style.width = width + 'px'; canvas.style.height = height + 'px'; ctx.scale(dpr, dpr); }
    window.addEventListener('resize', resize); resize();
    const particles = []; const count = Math.min(Math.floor((width * height) / 22000), 50);
    for (let i = 0; i < count; i++) { particles.push({ x: Math.random() * width, y: Math.random() * height, vx: (Math.random() - 0.5) * 0.6, vy: (Math.random() - 0.5) * 0.6, r: Math.random() * 2.5 + 1.5, colorIdx: Math.floor(Math.random() * 4) }); }
    function render() {
      ctx.clearRect(0, 0, width, height);
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const colors = isDark ? ['rgba(129,140,248,0.5)', 'rgba(192,132,252,0.45)', 'rgba(244,114,182,0.4)', 'rgba(52,211,153,0.35)'] : ['rgba(79,70,229,0.4)', 'rgba(124,58,237,0.35)', 'rgba(236,72,153,0.3)', 'rgba(16,185,129,0.3)'];
      particles.forEach((p) => { p.x += p.vx; p.y += p.vy; if (p.x < 0 || p.x > width) p.vx *= -1; if (p.y < 0 || p.y > height) p.vy *= -1; if (mouse.x !== null && mouse.y !== null) { const dx = mouse.x - p.x; const dy = mouse.y - p.y; const dist = Math.sqrt(dx * dx + dy * dy); if (dist < mouse.radius && dist > 0) { const force = (mouse.radius - dist) / mouse.radius; const angle = Math.atan2(dy, dx); p.x -= Math.cos(angle) * force * 2; p.y -= Math.sin(angle) * force * 2; } } ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fillStyle = colors[p.colorIdx]; ctx.fill(); });
      for (let i = 0; i < particles.length; i++) { for (let j = i + 1; j < particles.length; j++) { const dx = particles[i].x - particles[j].x; const dy = particles[i].y - particles[j].y; const dist = Math.sqrt(dx * dx + dy * dy); if (dist < 125) { const alpha = (1 - dist / 125) * (isDark ? 0.2 : 0.14); ctx.beginPath(); ctx.moveTo(particles[i].x, particles[i].y); ctx.lineTo(particles[j].x, particles[j].y); ctx.strokeStyle = isDark ? `rgba(129,140,248,${alpha})` : `rgba(79,70,229,${alpha})`; ctx.lineWidth = 1; ctx.stroke(); } } }
      requestAnimationFrame(render);
    }
    render();
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initAmbientCanvas, { timeout: 2000 });
  } else {
    setTimeout(initAmbientCanvas, 1200);
  }

  function setMode(mode) {
    state.mode = mode;
    elements.modeAdd.setAttribute('aria-selected', String(mode === 'add'));
    elements.modeRemove.setAttribute('aria-selected', String(mode === 'remove'));
    if (mode === 'add') { elements.modeAdd.classList.add('text-indigo-600', 'dark:text-indigo-400', 'font-bold'); elements.modeAdd.classList.remove('text-[var(--text-secondary)]', 'font-semibold'); elements.modeRemove.classList.remove('text-indigo-600', 'dark:text-indigo-400', 'font-bold'); elements.modeRemove.classList.add('text-[var(--text-secondary)]', 'font-semibold'); elements.toggleSlider.style.transform = 'translateX(0%)'; elements.amountLabel.textContent = elements.amountLabel.getAttribute('data-label-add'); } else { elements.modeRemove.classList.add('text-indigo-600', 'dark:text-indigo-400', 'font-bold'); elements.modeRemove.classList.remove('text-[var(--text-secondary)]', 'font-semibold'); elements.modeAdd.classList.remove('text-indigo-600', 'dark:text-indigo-400', 'font-bold'); elements.modeAdd.classList.add('text-[var(--text-secondary)]', 'font-semibold'); elements.toggleSlider.style.transform = 'translateX(100%)'; elements.amountLabel.textContent = elements.amountLabel.getAttribute('data-label-remove'); }
  }
  elements.modeAdd?.addEventListener('click', () => setMode('add'));
  elements.modeRemove?.addEventListener('click', () => setMode('remove'));

  elements.rateButtons?.forEach((btn) => { btn.addEventListener('click', () => { const rate = btn.dataset.rate; elements.rateButtons.forEach((b) => { b.classList.remove('border-indigo-500', 'bg-indigo-500/5', 'ring-3', 'ring-indigo-500/15'); b.classList.add('border-[var(--border-subtle)]', 'bg-[var(--bg-input)]'); b.setAttribute('aria-checked', 'false'); }); btn.classList.add('border-indigo-500', 'bg-indigo-500/5', 'ring-3', 'ring-indigo-500/15'); btn.classList.remove('border-[var(--border-subtle)]', 'bg-[var(--bg-input)]'); btn.setAttribute('aria-checked', 'true'); if (rate === 'custom') { state.isCustom = true; elements.customRateInput?.focus(); const cv = parseNumber(elements.customRateInput?.value); state.rate = isNaN(cv) ? 0 : cv; } else { state.isCustom = false; state.rate = parseFloat(rate); } }); });
  elements.customRateInput?.addEventListener('input', () => { if (state.isCustom) { const val = parseNumber(elements.customRateInput.value); state.rate = isNaN(val) ? 0 : val; } });
  elements.customRateInput?.addEventListener('focus', () => { elements.rateCustomBtn?.click(); });

  function parseNumber(str) { if (!str) return NaN; str = str.trim(); const lc = str.lastIndexOf(','); const ld = str.lastIndexOf('.'); if (lc > ld) { str = str.replace(/\./g, '').replace(',', '.'); } else if (ld > lc) { str = str.replace(/,/g, ''); } else if (lc !== -1) { str = str.replace(',', '.'); } return parseFloat(str); }
  function formatCurrency(val) { return val.toLocaleString('es-ES', { style: 'currency', currency: 'EUR', minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function formatRate(rate) { return rate % 1 === 0 ? rate.toString() : rate.toFixed(1); }

  function calculate() {
    const raw = elements.amountInput?.value.trim();
    if (!raw) { elements.amountInput?.classList.add('shake'); setTimeout(() => elements.amountInput?.classList.remove('shake'), 400); return; }
    const amount = parseNumber(raw);
    if (isNaN(amount) || amount <= 0) { elements.amountInput?.classList.add('shake'); setTimeout(() => elements.amountInput?.classList.remove('shake'), 400); return; }
    const rate = state.rate; let base, iva, total;
    if (state.mode === 'add') { base = amount; iva = amount * (rate / 100); total = amount + iva; } else { total = amount; base = amount / (1 + rate / 100); iva = total - base; }
    state.lastResult = { base, iva, total, rate, mode: state.mode };
    showResults(base, iva, total, rate);
  }
  elements.calcButton?.addEventListener('click', calculate);
  elements.amountInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); calculate(); } });

  let chartReqId = null;
  function animateChart(base, iva, total) {
    const canvas = elements.breakdownCanvas; if (!canvas) return;
    const ctx = canvas.getContext('2d'); if (!ctx) return;
    if (chartReqId) cancelAnimationFrame(chartReqId);
    const dpr = window.devicePixelRatio || 1; const size = 170; canvas.width = size * dpr; canvas.height = size * dpr; ctx.scale(dpr, dpr);
    const centerX = size / 2, centerY = size / 2, radius = size * 0.38, lineWidth = 16;
    const baseRatio = total > 0 ? base / total : 0.8, ivaRatio = total > 0 ? iva / total : 0.2;
    elements.chartCenterPercent.textContent = `${Math.round(ivaRatio * 100)}%`;
    elements.chartCenterLabel.textContent = `IVA (${formatRate(state.rate)}%)`;
    const startTime = performance.now(), duration = 600;
    function frame(now) {
      const progress = Math.min((now - startTime) / duration, 1); const ease = 1 - Math.pow(1 - progress, 3);
      ctx.clearRect(0, 0, size, size);
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      ctx.beginPath(); ctx.arc(centerX, centerY, radius, 0, Math.PI * 2); ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(15,23,42,0.06)'; ctx.lineWidth = lineWidth; ctx.stroke();
      const startAngle = -Math.PI / 2; const totalAngle = Math.PI * 2 * ease; const bAngle = totalAngle * baseRatio; const iAngle = totalAngle * ivaRatio;
      if (bAngle > 0) { ctx.beginPath(); ctx.arc(centerX, centerY, radius, startAngle, startAngle + bAngle); const bGrad = ctx.createLinearGradient(0, 0, size, size); bGrad.addColorStop(0, '#4f46e5'); bGrad.addColorStop(1, '#6366f1'); ctx.strokeStyle = bGrad; ctx.lineWidth = lineWidth; ctx.lineCap = 'round'; ctx.stroke(); }
      if (iAngle > 0) { ctx.beginPath(); ctx.arc(centerX, centerY, radius, startAngle + bAngle, startAngle + bAngle + iAngle); const iGrad = ctx.createLinearGradient(0, 0, size, size); iGrad.addColorStop(0, '#ec4899'); iGrad.addColorStop(1, '#c084fc'); ctx.strokeStyle = iGrad; ctx.lineWidth = lineWidth; ctx.lineCap = 'round'; ctx.stroke(); }
      if (progress < 1) chartReqId = requestAnimationFrame(frame);
    }
    chartReqId = requestAnimationFrame(frame);
  }

  function showResults(base, iva, total, rate) {
    elements.resultBaseValue.textContent = formatCurrency(base);
    elements.resultIvaValue.textContent = formatCurrency(iva);
    elements.resultTotalValue.textContent = formatCurrency(total);
    elements.resultIvaRate.textContent = formatRate(rate);
    const basePct = (base / total) * 100; const ivaPct = (iva / total) * 100;
    elements.breakdownFill.style.width = `${basePct}%`;
    elements.breakdownIvaFill.style.width = `${ivaPct}%`;
    animateChart(base, iva, total);
    elements.calcBody.classList.add('hidden');
    elements.resultsPanel.classList.remove('hidden');
  }
  elements.resultsClose?.addEventListener('click', () => { elements.resultsPanel.classList.add('hidden'); elements.calcBody.classList.remove('hidden'); });
  elements.newCalc?.addEventListener('click', () => { elements.resultsPanel.classList.add('hidden'); elements.calcBody.classList.remove('hidden'); elements.amountInput.value = ''; elements.amountInput.focus(); });

  elements.copyResult?.addEventListener('click', () => {
    if (!state.lastResult) return;
    const { base, iva, total, rate, mode } = state.lastResult;
    const text = `Calculadora IVA de una Cantidad\nCantidad neta: ${formatCurrency(base)}\nCuota de IVA (${formatRate(rate)}%): ${formatCurrency(iva)}\nTotal con IVA: ${formatCurrency(total)}`;
    navigator.clipboard.writeText(text).then(() => { showToast(elements.copyResult?.getAttribute('data-copied-msg') || '✓ Copiado'); });
  });
  function showToast(msg) { const existing = document.querySelector('.toast'); if (existing) existing.remove(); const toast = document.createElement('div'); toast.className = 'toast show'; toast.textContent = msg; document.body.appendChild(toast); setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 2500); }

  // FAQ accordion
  document.querySelectorAll('.faq-item .faq-question').forEach(button => {
    button.addEventListener('click', () => { const item = button.closest('.faq-item'); if (!item) return; const isOpen = item.classList.contains('open'); document.querySelectorAll('.faq-item').forEach(i => { if (i !== item) { i.classList.remove('open'); const btn = i.querySelector('.faq-question'); if (btn) btn.setAttribute('aria-expanded', 'false'); } }); if (isOpen) { item.classList.remove('open'); button.setAttribute('aria-expanded', 'false'); } else { item.classList.add('open'); button.setAttribute('aria-expanded', 'true'); } });
  });

  // Mini rate buttons
  document.querySelectorAll('.walkthrough-mini-rates .mini-rate-btn').forEach(btn => {
    btn.addEventListener('click', () => { const parent = btn.closest('.walkthrough-mini-rates'); if (parent) { parent.querySelectorAll('.mini-rate-btn').forEach(b => b.classList.remove('mini-rate-active')); btn.classList.add('mini-rate-active'); } });
  });
});
</script>
