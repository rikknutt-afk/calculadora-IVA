---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import IvaCalculator from '../../components/IvaCalculator.astro';
import CalcularIva from '../../components/CalcularIva.astro';
import FormulaIva from '../../components/FormulaIva.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import RateTable from '../../components/RateTable.astro';
import ToolsShowcase from '../../components/ToolsShowcase.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getStaticLocalePaths, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return getStaticLocalePaths();
}

const { locale } = Astro.params;
const currentLocale = locale || 'es';
const { t, faq } = useTranslations(currentLocale);
---

<BaseLayout
  title={t('siteTitle')}
  description={t('siteDescription')}
  schemaType="WebSite"
  faqItems={faq.items}
  locale={currentLocale}
>
  <!-- Hero Section with animated counters & feature checkmarks -->
  <HeroSection locale={currentLocale} />

  <!-- Interactive Calculator Section -->
  <section class="calculator-section" id="calculator">
    <IvaCalculator locale={currentLocale} />
  </section>

  <!-- Section: Calcular IVA (3-method flow diagram) -->
  <CalcularIva locale={currentLocale} />

  <!-- Section: ¿Cuál es la fórmula para calcular el IVA? & IVA soportado vs repercutido -->
  <FormulaIva locale={currentLocale} />

  <!-- Section: ¿Cómo funciona la calculadora de IVA? (4-step interactive walkthrough) -->
  <HowItWorks locale={currentLocale} />

  <!-- Section: IVA Percentage (18-country comparison chart & Spain rate cards) -->
  <RateTable locale={currentLocale} />

  <!-- Section: All Calculator Tools Showcase -->
  <ToolsShowcase locale={currentLocale} />

  <!-- Section: FAQ (6 questions + Quick Reference Table) -->
  <FaqSection locale={currentLocale} />
</BaseLayout>
