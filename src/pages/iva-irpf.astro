---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA e IRPF — Calcula IVA y Retención IRPF para Autónomos";
const description = "Calculadora combinada de IVA e IRPF para autónomos y freelancers en España. Calcula simultáneamente el IVA repercutido y la retención de IRPF en tus facturas trimestrales.";

const faqItems = [
  { question: "¿Qué diferencia hay entre IVA e IRPF?", answer: "El IVA (Impuesto sobre el Valor Añadido) es un impuesto indirecto al consumo que se cobra al cliente (21%, 10% o 4%). El IRPF (Impuesto sobre la Renta de las Personas Físicas) es un impuesto directo sobre los ingresos del autónomo. La retención de IRPF (15% o 7%) es un pago anticipado del IRPF que el cliente retiene y paga a Hacienda.", display: true },
  { question: "¿Cuándo se presenta el modelo 303 de IVA y el 130 de IRPF?", answer: "Ambos se presentan trimestralmente antes del día 20 del mes siguiente al trimestre: 1T → 20 abril, 2T → 20 julio, 3T → 20 octubre, 4T → 30 enero. El modelo 303 liquida el IVA (repercutido − soportado). El modelo 130 liquida el IRPF trimestral (20% de rendimientos netos − retenciones).", display: true },
  { question: "¿Cómo se calcula la liquidación trimestral de IVA?", answer: "IVA a pagar = IVA repercutido (cobrado a clientes) − IVA soportado (pagado a proveedores). Si el resultado es positivo, pagas a Hacienda. Si es negativo, se compensa en el siguiente trimestre o se solicita devolución en el 4T.", display: true, formula: { base: "IVA repercutido", rate: "− IVA soportado", result: "IVA a pagar" } },
  { question: "¿El IRPF trimestral es igual a las retenciones?", answer: "No siempre. El modelo 130 calcula el 20% de los rendimientos netos (ingresos − gastos) y le resta las retenciones ya practicadas por clientes. Si más del 70% de tus ingresos tienen retención, puedes estar exento del modelo 130.", display: true },
  { question: "¿Cómo saber si debo aplicar retención de IRPF en mis facturas?", answer: "Debes aplicar retención de IRPF si facturas a empresas o autónomos (B2B). No aplica retención si facturas a particulares (B2C). La retención estándar es del 15%, reducida al 7% para nuevos autónomos durante los primeros 3 años de actividad.", display: true },
  { question: "¿Qué pasa si no aplico la retención de IRPF?", answer: "Si facturas a empresas sin retención cuando corresponde, el cliente puede exigir la corrección. Hacienda puede sancionar al pagador por no practicar la retención. El autónomo debe declarar igualmente los ingresos completos en su declaración de la renta.", display: true }
];

const quarterlyTable = [
  { ingresos: '3.000 €', ivaRep: '630 €', ivaSop: '120 €', ivaPagar: '510 €', irpfRet: '450 €' },
  { ingresos: '5.000 €', ivaRep: '1.050 €', ivaSop: '200 €', ivaPagar: '850 €', irpfRet: '750 €' },
  { ingresos: '8.000 €', ivaRep: '1.680 €', ivaSop: '320 €', ivaPagar: '1.360 €', irpfRet: '1.200 €' },
  { ingresos: '10.000 €', ivaRep: '2.100 €', ivaSop: '400 €', ivaPagar: '1.700 €', irpfRet: '1.500 €' },
  { ingresos: '15.000 €', ivaRep: '3.150 €', ivaSop: '600 €', ivaPagar: '2.550 €', irpfRet: '2.250 €' },
  { ingresos: '20.000 €', ivaRep: '4.200 €', ivaSop: '800 €', ivaPagar: '3.400 €', irpfRet: '3.000 €' },
  { ingresos: '30.000 €', ivaRep: '6.300 €', ivaSop: '1.200 €', ivaPagar: '5.100 €', irpfRet: '4.500 €' },
];
---

<BaseLayout title={title} description={description} schemaType="WebSite" faqItems={faqItems} locale="es">
  <section class="hero" id="hero"><div class="hero-content"><h1 class="hero-title">Calculadora <span class="gradient-text">IVA e IRPF</span></h1><p class="hero-subtitle">Calcula simultáneamente el IVA repercutido y la retención de IRPF<br class="hidden sm:inline" /> en tus facturas de autónomo. Visualiza base, IVA, IRPF y líquido a cobrar.</p></div></section>

  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <div id="calcBody" class="space-y-6">
          <div><label for="amountInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><span>Ingresos brutos (factura)</span></label><div class="relative"><input type="text" id="amountInput" class="w-full py-4 pl-5 pr-12 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 3.000,00" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-xl font-bold text-[var(--text-tertiary)]">€</span></div></div>

          <div class="grid grid-cols-2 gap-4">
            <div><label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-indigo-500 mb-2"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg><span>IVA %</span></label>
            <div class="grid grid-cols-2 gap-2"><button type="button" class="rate-btn active flex flex-col items-center p-2.5 rounded-xl border-1.5 border-indigo-500 bg-indigo-500/5 ring-3 ring-indigo-500/15 shadow-sm transition-all" data-rate="21" role="radio" aria-checked="true"><span class="font-display font-bold text-sm">21%</span></button><button type="button" class="rate-btn flex flex-col items-center p-2.5 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 shadow-sm transition-all" data-rate="10" role="radio" aria-checked="false"><span class="font-display font-bold text-sm">10%</span></button></div></div>
            <div><label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-amber-500 mb-2"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/></svg><span>IRPF %</span></label>
            <div class="grid grid-cols-2 gap-2"><button type="button" class="irpf-btn active flex flex-col items-center p-2.5 rounded-xl border-1.5 border-amber-500 bg-amber-500/5 ring-3 ring-amber-500/15 shadow-sm transition-all" data-irpf="15" role="radio" aria-checked="true"><span class="font-display font-bold text-sm">15%</span></button><button type="button" class="irpf-btn flex flex-col items-center p-2.5 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-amber-500 shadow-sm transition-all" data-irpf="7" role="radio" aria-checked="false"><span class="font-display font-bold text-sm">7%</span></button></div></div>
          </div>

          <div><label for="gastosInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/></svg><span>Gastos deducibles (IVA soportado — opcional)</span></label><div class="relative"><input type="text" id="gastosInput" class="w-full py-3 pl-5 pr-12 bg-[var(--bg-input)] border border-[var(--border-medium)] rounded-xl text-lg font-semibold text-[var(--text-primary)] outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 500,00" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-lg font-bold text-[var(--text-tertiary)]">€</span></div></div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group"><span class="relative z-10">Calcular IVA e IRPF</span><svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg><div class="btn-shine" aria-hidden="true"></div></button>
        </div>

        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between"><p class="font-display font-extrabold text-xl gradient-text">Desglose IVA + IRPF</p><button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg><span>Modificar</span></button></div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm"><span class="text-sm font-semibold text-[var(--text-secondary)]">Ingresos brutos</span><span class="font-display font-bold text-lg text-[var(--text-primary)]" id="rIngresos">0 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/30 bg-indigo-500/5 shadow-sm"><span class="text-sm font-bold text-indigo-600 dark:text-indigo-400">+ IVA repercutido (<span id="rIvaRate">21</span>%)</span><span class="font-display font-bold text-lg text-indigo-600 dark:text-indigo-400" id="rIvaRep">+0 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-amber-500/30 bg-amber-500/5 shadow-sm"><span class="text-sm font-bold text-amber-600 dark:text-amber-400">− Retención IRPF (<span id="rIrpfRate">15</span>%)</span><span class="font-display font-bold text-lg text-amber-600 dark:text-amber-400" id="rIrpf">−0 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md"><span class="text-sm font-bold text-[var(--text-secondary)]">Líquido a cobrar</span><span class="font-display font-extrabold text-2xl gradient-text" id="rNet">0 €</span></div>
          </div>
          <div id="quarterlySection" class="grid gap-3 pt-3 border-t border-[var(--border-subtle)]">
            <p class="text-sm font-bold text-[var(--text-secondary)]">📊 Estimación trimestral</p>
            <div class="flex items-center justify-between p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-tertiary)]"><span class="text-sm text-[var(--text-secondary)]">IVA a pagar (repercutido − soportado)</span><span class="font-display font-bold text-sm text-[var(--text-primary)]" id="rIvaPagar">0 €</span></div>
            <div class="flex items-center justify-between p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-tertiary)]"><span class="text-sm text-[var(--text-secondary)]">IRPF retenido por cliente</span><span class="font-display font-bold text-sm text-[var(--text-primary)]" id="rIrpfRet">0 €</span></div>
          </div>
          <div class="flex gap-3 pt-2"><button type="button" id="copyResult" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copiar</span></button><button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Nuevo</span></button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="calcular-iva"><div class="section-container"><h2 class="section-title">IVA e IRPF para <span class="gradient-text">3 Perfiles de Autónomo</span></h2><p class="section-subtitle">Cada tipo de autónomo tiene diferentes obligaciones de IVA e IRPF según su actividad y antigüedad</p><div class="methods-grid">
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><span class="method-number">01</span></div><h3 class="method-title">Autónomo establecido (15% IRPF)</h3><p class="method-desc">Profesional con más de 3 años de actividad. Aplica 21% de IVA y 15% de retención de IRPF. Presenta modelos 303 y 130 trimestralmente.</p><div class="method-formula"><span class="method-formula-var">3.000 € + 630 €</span><span class="method-formula-op">−</span><span class="method-formula-var">450 €</span><span class="method-formula-op">=</span><span class="method-formula-result">3.180 €</span></div><div class="method-example"><span class="method-example-label">Líquido</span><span>Ingresos + IVA − IRPF = <strong>3.180 €</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-remove"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 6v6l4 2"/></svg></div><span class="method-number">02</span></div><h3 class="method-title">Autónomo nuevo (7% IRPF)</h3><p class="method-desc">Nuevo autónomo en sus 3 primeros ejercicios. Aplica la retención reducida del 7% para mejorar su liquidez. Mismo 21% de IVA.</p><div class="method-formula"><span class="method-formula-var">3.000 € + 630 €</span><span class="method-formula-op">−</span><span class="method-formula-var">210 €</span><span class="method-formula-op">=</span><span class="method-formula-result">3.420 €</span></div><div class="method-example"><span class="method-example-label">Líquido</span><span>Más liquidez: +240 € que el 15% = <strong>3.420 €</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-desglose"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div><span class="method-number">03</span></div><h3 class="method-title">Estimación directa simplificada</h3><p class="method-desc">Autónomos con ingresos anuales inferiores a 600.000 €. Pueden deducir un 7% de gastos de difícil justificación sobre el rendimiento neto.</p><div class="method-formula"><span class="method-formula-var">Ingresos − Gastos</span><span class="method-formula-op">×</span><span class="method-formula-var">20%</span><span class="method-formula-op">=</span><span class="method-formula-result">IRPF mod. 130</span></div><div class="method-example"><span class="method-example-label">Ejemplo</span><span>(3.000 − 500) × 20% = <strong>500 €</strong></span></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="formula-iva"><div class="section-container"><h2 class="section-title">Fórmulas de <span class="gradient-text">IVA e IRPF</span> Trimestrales</h2><p class="section-subtitle">Las dos fórmulas que necesita todo autónomo para calcular sus impuestos trimestrales</p><div class="formula-builder">
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-add"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/></svg><span>Modelo 303 — IVA trimestral</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">IVA repercutido</span><span class="formula-builder-value">630 €</span></div><span class="formula-builder-op">−</span><div class="formula-builder-part"><span class="formula-builder-label">IVA soportado</span><span class="formula-builder-value">120 €</span></div><span class="formula-builder-op">=</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">IVA a pagar</span><span class="formula-builder-value">510 €</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>IVA cobrado a clientes</span><span>630,00 €</span></div><div class="formula-builder-breakdown-row"><span>IVA pagado a proveedores</span><span>−120,00 €</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>A ingresar en Hacienda</span><span>510,00 €</span></div></div></div>
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-remove"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/></svg><span>Modelo 130 — IRPF trimestral</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">(Ingresos − Gastos)</span><span class="formula-builder-value">(3.000 − 500)</span></div><span class="formula-builder-op">× 20%</span><div class="formula-builder-part"><span class="formula-builder-label">Cuota</span><span class="formula-builder-value">500 €</span></div><span class="formula-builder-op">− Retenciones</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">A pagar</span><span class="formula-builder-value">50 €</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Rendimiento neto</span><span>2.500,00 €</span></div><div class="formula-builder-breakdown-row"><span>20% sobre rendimiento</span><span>500,00 €</span></div><div class="formula-builder-breakdown-row"><span>Retenciones practicadas</span><span>−450,00 €</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>A ingresar (mod. 130)</span><span>50,00 €</span></div></div></div>
  </div></div></section>

  <section class="content-section" id="como-funciona"><div class="section-container"><h2 class="section-title">¿Cómo Calcular <span class="gradient-text">IVA e IRPF</span> en 4 Pasos?</h2><p class="section-subtitle">El proceso completo para calcular tus impuestos de autónomo en España</p><div class="walkthrough-steps">
    <div class="walkthrough-step" data-step="1"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">1</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📄</div><h3 class="walkthrough-step-title">1. Introduce tus ingresos</h3><p class="walkthrough-step-desc">Escribe el importe bruto de la factura o tus ingresos del trimestre antes de impuestos.</p><div class="walkthrough-mini-input"><span class="mini-input-label">Ingresos</span><div class="mini-input-box">3.000,00 <span class="mini-input-currency">€</span></div></div></div></div>
    <div class="walkthrough-step" data-step="2"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">2</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">⚖️</div><h3 class="walkthrough-step-title">2. Elige IVA e IRPF</h3><p class="walkthrough-step-desc">Selecciona tu tipo de IVA (21% o 10%) y tu retención de IRPF (15% general o 7% nuevo autónomo).</p></div></div>
    <div class="walkthrough-step" data-step="3"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">3</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📊</div><h3 class="walkthrough-step-title">3. Añade gastos (opcional)</h3><p class="walkthrough-step-desc">Introduce tus gastos con IVA para calcular el IVA soportado deducible en el modelo 303.</p></div></div>
    <div class="walkthrough-step" data-step="4"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">4</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">✅</div><h3 class="walkthrough-step-title">4. Resultado completo</h3><p class="walkthrough-step-desc">Obtén el líquido a cobrar, la estimación de IVA a pagar y el IRPF retenido para tus modelos 303 y 130.</p><div class="walkthrough-mini-result"><div class="mini-result-row"><span>Ingresos brutos</span><span class="mini-result-value">3.000,00 €</span></div><div class="mini-result-row" style="color:var(--accent-indigo)"><span>+ IVA 21%</span><span class="mini-result-value">+630,00 €</span></div><div class="mini-result-row" style="color:var(--accent-amber)"><span>− IRPF 15%</span><span class="mini-result-value">−450,00 €</span></div><div class="mini-result-row mini-result-total"><span>Líquido</span><span class="mini-result-value"><strong>3.180,00 €</strong></span></div></div></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="tabla-referencia"><div class="section-container section-container-wide"><h2 class="section-title">Tabla Trimestral <span class="gradient-text">IVA + IRPF</span></h2><p class="section-subtitle">Estimación de IVA a pagar y IRPF retenido por ingresos trimestrales con IVA al 21% y IRPF al 15%</p><div class="quick-table-wrapper"><div class="quick-table-container"><table class="quick-table"><thead><tr><th>Ingresos</th><th>IVA repercutido</th><th>IVA soportado*</th><th>IVA a pagar</th><th>IRPF retenido</th></tr></thead><tbody>{quarterlyTable.map((r) => (<tr><td><strong>{r.ingresos}</strong></td><td>{r.ivaRep}</td><td>{r.ivaSop}</td><td>{r.ivaPagar}</td><td>{r.irpfRet}</td></tr>))}</tbody></table><p class="text-xs text-[var(--text-tertiary)] mt-3">* IVA soportado estimado al 4% de gastos sobre ingresos</p></div></div></div></section>

  <section class="faq-section" id="faq"><div class="section-container"><h2 class="section-title">Preguntas sobre <span class="gradient-text">IVA e IRPF</span></h2><p class="section-subtitle">Todo sobre las obligaciones de IVA e IRPF para autónomos en España</p><div class="faq-list" id="faqList">{faqItems.map((item, idx) => (<div class="faq-item" id={`faq${idx + 1}`}><button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button"><span>{item.question}</span><svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></button><div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}><p set:html={item.answer} />{item.formula && (<div class="faq-formula-mini"><div class="faq-formula-equation"><span class="faq-formula-var">{item.formula.base}</span><span class="faq-formula-op">−</span><span class="faq-formula-var">{item.formula.rate}</span><span class="faq-formula-op">=</span><span class="faq-formula-result">{item.formula.result}</span></div></div>)}</div></div>))}</div></div></section>
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded',()=>{const els={amountInput:document.getElementById('amountInput'),gastosInput:document.getElementById('gastosInput'),rateButtons:document.querySelectorAll('.rate-btn'),irpfButtons:document.querySelectorAll('.irpf-btn'),calcButton:document.getElementById('calcButton'),calcBody:document.getElementById('calcBody'),resultsPanel:document.getElementById('resultsPanel'),resultsClose:document.getElementById('resultsClose'),rIngresos:document.getElementById('rIngresos'),rIvaRate:document.getElementById('rIvaRate'),rIvaRep:document.getElementById('rIvaRep'),rIrpfRate:document.getElementById('rIrpfRate'),rIrpf:document.getElementById('rIrpf'),rNet:document.getElementById('rNet'),rIvaPagar:document.getElementById('rIvaPagar'),rIrpfRet:document.getElementById('rIrpfRet'),copyResult:document.getElementById('copyResult'),newCalc:document.getElementById('newCalc'),ambientCanvas:document.getElementById('ambientCanvas')};
let state={rate:21,irpf:15,lastResult:null};
function initAmbient(){
  if(window.innerWidth<768||window.matchMedia('(prefers-reduced-motion: reduce)').matches){if(els.ambientCanvas)els.ambientCanvas.style.display='none';return;}
  const c=els.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0;function rs(){w=window.innerWidth;h=window.innerHeight;const d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];for(let i=0;i<Math.min(Math.floor(w*h/22000),50);i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn()}
if('requestIdleCallback' in window){requestIdleCallback(initAmbient,{timeout:2000});}else{setTimeout(initAmbient,1200);}
els.rateButtons?.forEach(btn=>{btn.addEventListener('click',()=>{els.rateButtons.forEach(b=>{b.classList.remove('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15');b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]');b.setAttribute('aria-checked','false')});btn.classList.add('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15');btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]');btn.setAttribute('aria-checked','true');state.rate=parseFloat(btn.dataset.rate)})});
els.irpfButtons?.forEach(btn=>{btn.addEventListener('click',()=>{els.irpfButtons.forEach(b=>{b.classList.remove('border-amber-500','bg-amber-500/5','ring-3','ring-amber-500/15');b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]');b.setAttribute('aria-checked','false')});btn.classList.add('border-amber-500','bg-amber-500/5','ring-3','ring-amber-500/15');btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]');btn.setAttribute('aria-checked','true');state.irpf=parseFloat(btn.dataset.irpf)})});
function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
function fc(v){return v.toLocaleString('es-ES',{style:'currency',currency:'EUR',minimumFractionDigits:2,maximumFractionDigits:2})}
function fr(r){return r%1===0?r.toString():r.toFixed(1)}
function calculate(){const raw=els.amountInput?.value.trim();if(!raw){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}const ing=pn(raw);if(isNaN(ing)||ing<=0){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}const gastos=pn(els.gastosInput?.value)||0;const ivaRep=ing*(state.rate/100);const irpf=ing*(state.irpf/100);const net=ing+ivaRep-irpf;const ivaSop=gastos*(state.rate/100);const ivaPagar=ivaRep-ivaSop;state.lastResult={ing,ivaRep,irpf,net,gastos,ivaSop,ivaPagar,rate:state.rate,irpfRate:state.irpf};
els.rIngresos.textContent=fc(ing);els.rIvaRate.textContent=fr(state.rate);els.rIvaRep.textContent=`+${fc(ivaRep)}`;els.rIrpfRate.textContent=fr(state.irpf);els.rIrpf.textContent=`−${fc(irpf)}`;els.rNet.textContent=fc(net);els.rIvaPagar.textContent=fc(ivaPagar);els.rIrpfRet.textContent=fc(irpf);
els.calcBody.classList.add('hidden');els.resultsPanel.classList.remove('hidden')}
els.calcButton?.addEventListener('click',calculate);els.amountInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();calculate()}});
els.resultsClose?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden')});
els.newCalc?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden');els.amountInput.value='';els.gastosInput.value='';els.amountInput.focus()});
els.copyResult?.addEventListener('click',()=>{if(!state.lastResult)return;const r=state.lastResult;const t=`IVA e IRPF\nIngresos: ${fc(r.ing)}\n+IVA ${fr(r.rate)}%: ${fc(r.ivaRep)}\n−IRPF ${fr(r.irpfRate)}%: ${fc(r.irpf)}\nLíquido: ${fc(r.net)}\nIVA a pagar: ${fc(r.ivaPagar)}`;navigator.clipboard.writeText(t).then(()=>{const ex=document.querySelector('.toast');if(ex)ex.remove();const toast=document.createElement('div');toast.className='toast show';toast.textContent='✓ Desglose copiado';document.body.appendChild(toast);setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>toast.remove(),300)},2500)})});
document.querySelectorAll('.faq-item .faq-question').forEach(b=>{b.addEventListener('click',()=>{const i=b.closest('.faq-item');if(!i)return;const o=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>{if(x!==i){x.classList.remove('open');const btn=x.querySelector('.faq-question');if(btn)btn.setAttribute('aria-expanded','false')}});if(o){i.classList.remove('open');b.setAttribute('aria-expanded','false')}else{i.classList.add('open');b.setAttribute('aria-expanded','true')}})});
});
</script>
