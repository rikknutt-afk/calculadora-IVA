---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA Porcentaje — Calcular Tipo Aplicado";
const description = "Calculadora de porcentaje de IVA. Introduce la base y el total para calcular qué tasa de IVA se aplicó y compara tipos oficiales del 21%, 10% y 4%.";

const faqItems = [
  {
    question: "¿Cómo saber qué porcentaje de IVA tiene un producto?",
    answer: "Para calcular el porcentaje de IVA aplicado, usa la fórmula: % IVA = ((Total − Base) ÷ Base) × 100. Ejemplo: si la base es 100 € y el total 121 €, entonces ((121 − 100) ÷ 100) × 100 = 21%. El producto tiene un IVA del 21%.",
    display: true,
    formula: { base: "(121 − 100)", rate: "÷ 100 × 100", result: "21%" }
  },
  {
    question: "¿Cuáles son los porcentajes de IVA vigentes en España?",
    answer: "España tiene 3 tipos de IVA: General (21%) para la mayoría de productos y servicios; Reducido (10%) para alimentos, transporte y hostelería; Superreducido (4%) para pan, leche, libros y medicamentos. El tipo 0% aplica a ciertas operaciones exentas.",
    display: true
  },
  {
    question: "¿Cómo calcular el porcentaje de IVA a partir de dos cantidades?",
    answer: "Si conoces el precio sin IVA y el precio con IVA, resta ambas cantidades para obtener la cuota de IVA. Luego divide la cuota entre la base y multiplica por 100. Ejemplo: Base 250 €, Total 302,50 €. IVA = 52,50 €. Porcentaje = (52,50 ÷ 250) × 100 = 21%.",
    display: true,
    formula: { base: "52,50 €", rate: "÷ 250 × 100", result: "21%" }
  },
  {
    question: "¿El porcentaje de IVA cambia según el país?",
    answer: "Sí, cada país establece sus propios tipos de IVA. España aplica el 21%, México el 16%, Argentina el 21%, Chile el 19%, Colombia el 19%, Perú el 18%. Los tipos reducidos y superreducidos también varían entre países.",
    display: true
  },
  {
    question: "¿Cuándo se aplica el 10% de IVA en España?",
    answer: "El IVA reducido del 10% en España se aplica a: alimentos procesados, agua, transporte de viajeros, hostelería, servicios de peluquería, entradas a espectáculos, vivienda nueva, productos sanitarios y servicios funerarios.",
    display: true
  },
  {
    question: "¿Qué productos llevan el 4% de IVA en España?",
    answer: "El IVA superreducido del 4% aplica a: pan, harinas, leche, queso, huevos, frutas y verduras, libros, periódicos, revistas, medicamentos de uso humano, prótesis y sillas de ruedas, y viviendas de protección oficial.",
    display: true
  }
];

const ratesComparison = [
  { producto: 'Electrónica y tecnología', tipo: '21%', categoria: 'General' },
  { producto: 'Ropa y calzado', tipo: '21%', categoria: 'General' },
  { producto: 'Servicios profesionales', tipo: '21%', categoria: 'General' },
  { producto: 'Restaurantes y bares', tipo: '10%', categoria: 'Reducido' },
  { producto: 'Transporte de viajeros', tipo: '10%', categoria: 'Reducido' },
  { producto: 'Alimentos procesados', tipo: '10%', categoria: 'Reducido' },
  { producto: 'Entradas a espectáculos', tipo: '10%', categoria: 'Reducido' },
  { producto: 'Vivienda nueva', tipo: '10%', categoria: 'Reducido' },
  { producto: 'Pan y cereales', tipo: '4%', categoria: 'Superreducido' },
  { producto: 'Leche y derivados', tipo: '4%', categoria: 'Superreducido' },
  { producto: 'Libros y periódicos', tipo: '4%', categoria: 'Superreducido' },
  { producto: 'Medicamentos', tipo: '4%', categoria: 'Superreducido' },
];
---

<BaseLayout title={title} description={description} schemaType="WebSite" faqItems={faqItems} locale="es">
  <section class="hero" id="hero">
    <div class="hero-content">
      <h1 class="hero-title">Calculadora IVA <span class="gradient-text">Porcentaje</span></h1>
      <p class="hero-subtitle">¿No sabes qué tipo de IVA se aplicó? Introduce la base y el total<br class="hidden sm:inline" /> y descubre el porcentaje exacto de IVA al instante.</p>
    </div>
  </section>

  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <div class="mb-6">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-500/10 border border-indigo-500/20">
            <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span class="text-sm font-bold text-indigo-600 dark:text-indigo-400">Detectar porcentaje de IVA</span>
          </div>
        </div>

        <div id="calcBody" class="space-y-6">
          <div>
            <label for="baseInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2">
              <svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <span>Precio sin IVA (Base imponible)</span>
            </label>
            <div class="relative">
              <input type="text" id="baseInput" class="w-full py-4 pl-5 pr-12 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 100,00" inputmode="decimal" autocomplete="off" />
              <span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-xl font-bold text-[var(--text-tertiary)]">€</span>
            </div>
          </div>
          <div>
            <label for="totalInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2">
              <svg class="w-4 h-4 text-pink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              <span>Precio con IVA (Total)</span>
            </label>
            <div class="relative">
              <input type="text" id="totalInput" class="w-full py-4 pl-5 pr-12 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-pink-500 focus:ring-4 focus:ring-pink-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 121,00" inputmode="decimal" autocomplete="off" />
              <span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-xl font-bold text-[var(--text-tertiary)]">€</span>
            </div>
          </div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group">
            <span class="relative z-10">Detectar Porcentaje de IVA</span>
            <svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            <div class="btn-shine" aria-hidden="true"></div>
          </button>
        </div>

        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between">
            <p class="font-display font-extrabold text-xl gradient-text">Porcentaje Detectado</p>
            <button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
              <span>Modificar</span>
            </button>
          </div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md">
              <span class="text-sm font-bold text-[var(--text-secondary)]">Porcentaje de IVA</span>
              <span class="font-display font-extrabold text-3xl gradient-text" id="resultPercent">0%</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm">
              <span class="text-sm font-semibold text-[var(--text-secondary)]">Base imponible</span>
              <span class="font-display font-bold text-lg text-[var(--text-primary)]" id="resultBaseValue">0,00 €</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm">
              <span class="text-sm font-semibold text-[var(--text-secondary)]">Cuota de IVA</span>
              <span class="font-display font-bold text-lg text-[var(--text-primary)]" id="resultIvaValue">0,00 €</span>
            </div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm">
              <span class="text-sm font-semibold text-[var(--text-secondary)]">Total con IVA</span>
              <span class="font-display font-bold text-lg text-[var(--text-primary)]" id="resultTotalValue">0,00 €</span>
            </div>
            <div id="rateMatch" class="hidden p-3 rounded-xl border border-green-500/30 bg-green-500/5 text-center">
              <span class="text-sm font-bold text-green-600 dark:text-green-400" id="rateMatchText"></span>
            </div>
          </div>
          <div class="relative w-[170px] h-[170px] mx-auto flex items-center justify-center">
            <canvas id="breakdownCanvas" class="w-[170px] h-[170px] block drop-shadow-md" width="170" height="170"></canvas>
            <div class="absolute flex flex-col items-center justify-center pointer-events-none">
              <span id="chartCenterPercent" class="font-display font-extrabold text-2xl text-[var(--text-primary)] leading-none">0%</span>
              <span id="chartCenterLabel" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mt-1">IVA</span>
            </div>
          </div>
          <div class="flex gap-3 pt-2">
            <button type="button" id="copyResult" data-copied-msg="✓ Porcentaje copiado" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span>Copiar</span>
            </button>
            <button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
              <span>Nuevo Cálculo</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="calcular-iva">
    <div class="section-container">
      <h2 class="section-title">3 Usos del Cálculo de <span class="gradient-text">Porcentaje de IVA</span></h2>
      <p class="section-subtitle">Descubre el tipo de IVA aplicado en distintas situaciones cotidianas y profesionales</p>
      <div class="methods-grid">
        <div class="method-card">
          <div class="method-icon-wrapper"><div class="method-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></div><span class="method-number">01</span></div>
          <h3 class="method-title">Verificar el IVA de un ticket</h3>
          <p class="method-desc">Comprueba si el comercio aplicó el tipo correcto. Introduce el subtotal y el total del ticket para verificar si es 4%, 10% o 21%.</p>
          <div class="method-formula"><span class="method-formula-var">(Total − Base)</span><span class="method-formula-op">÷</span><span class="method-formula-var">Base</span><span class="method-formula-op">× 100 =</span><span class="method-formula-result">% IVA</span></div>
          <div class="method-example"><span class="method-example-label">Ejemplo</span><span>(110 − 100) ÷ 100 × 100 = <strong>10%</strong></span></div>
        </div>
        <div class="method-card">
          <div class="method-icon-wrapper"><div class="method-icon method-icon-remove"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg></div><span class="method-number">02</span></div>
          <h3 class="method-title">Auditar facturas de proveedores</h3>
          <p class="method-desc">Revisa que tus proveedores apliquen el porcentaje de IVA correcto según el tipo de bien o servicio facturado.</p>
          <div class="method-formula"><span class="method-formula-var">Cuota IVA</span><span class="method-formula-op">÷</span><span class="method-formula-var">Base imponible</span><span class="method-formula-op">× 100 =</span><span class="method-formula-result">% verificado</span></div>
          <div class="method-example"><span class="method-example-label">Ejemplo</span><span>210 ÷ 1.000 × 100 = <strong>21%</strong></span></div>
        </div>
        <div class="method-card">
          <div class="method-icon-wrapper"><div class="method-icon method-icon-desglose"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></div><span class="method-number">03</span></div>
          <h3 class="method-title">Comparar precios internacionales</h3>
          <p class="method-desc">Al comprar en otro país, calcula el porcentaje de IVA local para comparar precios netos. Útil para importaciones y compras intracomunitarias.</p>
          <div class="method-formula"><span class="method-formula-var">(Precio local − Neto)</span><span class="method-formula-op">÷</span><span class="method-formula-var">Neto</span><span class="method-formula-op">× 100 =</span><span class="method-formula-result">IVA del país</span></div>
          <div class="method-example"><span class="method-example-label">Ejemplo</span><span>(119 − 100) ÷ 100 × 100 = <strong>19% (Chile)</strong></span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section content-section-alt" id="formula-iva">
    <div class="section-container">
      <h2 class="section-title">Fórmula para Calcular el <span class="gradient-text">Porcentaje de IVA</span></h2>
      <p class="section-subtitle">La fórmula inversa que te permite descubrir el tipo impositivo a partir de dos cantidades conocidas</p>
      <div class="formula-builder">
        <div class="formula-builder-card">
          <div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-add"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg><span>Detectar % de IVA</span></div></div>
          <div class="formula-builder-equation">
            <div class="formula-builder-part"><span class="formula-builder-label">Total − Base</span><span class="formula-builder-value">121 − 100 = 21</span></div>
            <span class="formula-builder-op">÷</span>
            <div class="formula-builder-part"><span class="formula-builder-label">Base</span><span class="formula-builder-value">100</span></div>
            <span class="formula-builder-op">× 100 =</span>
            <div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Porcentaje</span><span class="formula-builder-value">21%</span></div>
          </div>
          <div class="formula-builder-breakdown">
            <div class="formula-builder-breakdown-row"><span>Diferencia (IVA)</span><span>21,00 €</span></div>
            <div class="formula-builder-breakdown-row"><span>Dividido por la base</span><span>÷ 100,00 €</span></div>
            <div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Porcentaje de IVA</span><span>21,00%</span></div>
          </div>
        </div>
        <div class="formula-builder-card">
          <div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-remove"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>Método alternativo</span></div></div>
          <div class="formula-builder-equation">
            <div class="formula-builder-part"><span class="formula-builder-label">Total</span><span class="formula-builder-value">121</span></div>
            <span class="formula-builder-op">÷</span>
            <div class="formula-builder-part"><span class="formula-builder-label">Base</span><span class="formula-builder-value">100</span></div>
            <span class="formula-builder-op">− 1 =</span>
            <div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Tipo decimal</span><span class="formula-builder-value">0,21 → 21%</span></div>
          </div>
          <div class="formula-builder-breakdown">
            <div class="formula-builder-breakdown-row"><span>Cociente Total/Base</span><span>1,21</span></div>
            <div class="formula-builder-breakdown-row"><span>Menos 1</span><span>0,21</span></div>
            <div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Porcentaje de IVA</span><span>21,00%</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="como-funciona">
    <div class="section-container">
      <h2 class="section-title">¿Cómo Detectar el <span class="gradient-text">Porcentaje de IVA</span>?</h2>
      <p class="section-subtitle">4 pasos para descubrir el tipo impositivo exacto aplicado a cualquier operación</p>
      <div class="walkthrough-steps">
        <div class="walkthrough-step" data-step="1"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">1</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">🧾</div><h3 class="walkthrough-step-title">1. Localiza la base imponible</h3><p class="walkthrough-step-desc">Busca en tu factura o ticket el precio sin IVA (base imponible o subtotal antes de impuestos).</p><div class="walkthrough-mini-input"><span class="mini-input-label">Base</span><div class="mini-input-box">250,00 <span class="mini-input-currency">€</span></div></div></div></div>
        <div class="walkthrough-step" data-step="2"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">2</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">💳</div><h3 class="walkthrough-step-title">2. Localiza el precio total</h3><p class="walkthrough-step-desc">Identifica el importe final pagado con IVA incluido. Es la cantidad que aparece como «Total» en la factura.</p><div class="walkthrough-mini-input"><span class="mini-input-label">Total</span><div class="mini-input-box">302,50 <span class="mini-input-currency">€</span></div></div></div></div>
        <div class="walkthrough-step" data-step="3"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">3</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">🔢</div><h3 class="walkthrough-step-title">3. La calculadora detecta el %</h3><p class="walkthrough-step-desc">Aplicamos la fórmula ((Total − Base) ÷ Base) × 100 y comparamos con los tipos oficiales para confirmar la coincidencia.</p></div></div>
        <div class="walkthrough-step" data-step="4"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">4</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">✅</div><h3 class="walkthrough-step-title">4. Resultado con verificación</h3><p class="walkthrough-step-desc">Obtienes el porcentaje exacto y una confirmación de si coincide con los tipos oficiales de España (4%, 10% o 21%).</p><div class="walkthrough-mini-result"><div class="mini-result-row"><span>Base imponible</span><span class="mini-result-value">250,00 €</span></div><div class="mini-result-row mini-result-iva"><span>Cuota de IVA</span><span class="mini-result-value">52,50 €</span></div><div class="mini-result-row mini-result-total"><span>Porcentaje detectado</span><span class="mini-result-value"><strong>21% ✓</strong></span></div></div></div></div>
      </div>
    </div>
  </section>

  <section class="content-section content-section-alt" id="tabla-referencia">
    <div class="section-container section-container-wide">
      <h2 class="section-title">Porcentajes de IVA por <span class="gradient-text">Tipo de Producto</span></h2>
      <p class="section-subtitle">Referencia rápida del porcentaje de IVA aplicable según el tipo de producto o servicio en España</p>
      <div class="quick-table-wrapper">
        <div class="quick-table-container">
          <table class="quick-table">
            <thead><tr><th>Producto / Servicio</th><th>% IVA</th><th>Categoría</th></tr></thead>
            <tbody>
              {ratesComparison.map((row) => (
                <tr>
                  <td>{row.producto}</td>
                  <td><strong>{row.tipo}</strong></td>
                  <td>{row.categoria}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="faq-section" id="faq">
    <div class="section-container">
      <h2 class="section-title">Preguntas sobre el <span class="gradient-text">Porcentaje de IVA</span></h2>
      <p class="section-subtitle">Todo lo que necesitas saber sobre los tipos de IVA, cómo detectarlos y cuándo aplica cada porcentaje</p>
      <div class="faq-list" id="faqList">
        {faqItems.map((item, idx) => (
          <div class="faq-item" id={`faq${idx + 1}`}>
            <button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button">
              <span>{item.question}</span>
              <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}>
              <p set:html={item.answer} />
              {item.formula && (
                <div class="faq-formula-mini"><div class="faq-formula-equation"><span class="faq-formula-var">{item.formula.base}</span><span class="faq-formula-op">{item.formula.rate.includes('÷') ? '÷' : '×'}</span><span class="faq-formula-var">{item.formula.rate.replace(/[÷×] /,'')}</span><span class="faq-formula-op">=</span><span class="faq-formula-result">{item.formula.result}</span></div></div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const els = { baseInput: document.getElementById('baseInput'), totalInput: document.getElementById('totalInput'), calcButton: document.getElementById('calcButton'), calcBody: document.getElementById('calcBody'), resultsPanel: document.getElementById('resultsPanel'), resultsClose: document.getElementById('resultsClose'), resultPercent: document.getElementById('resultPercent'), resultBaseValue: document.getElementById('resultBaseValue'), resultIvaValue: document.getElementById('resultIvaValue'), resultTotalValue: document.getElementById('resultTotalValue'), rateMatch: document.getElementById('rateMatch'), rateMatchText: document.getElementById('rateMatchText'), breakdownCanvas: document.getElementById('breakdownCanvas'), chartCenterPercent: document.getElementById('chartCenterPercent'), chartCenterLabel: document.getElementById('chartCenterLabel'), copyResult: document.getElementById('copyResult'), newCalc: document.getElementById('newCalc'), ambientCanvas: document.getElementById('ambientCanvas') };
  let lastResult = null;

  // Ambient canvas
  function initAmbient(){
    if (window.innerWidth < 768 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if (els.ambientCanvas) els.ambientCanvas.style.display = 'none';
      return;
    }
    const c=els.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0,d=window.devicePixelRatio||1;const m={x:null,y:null,r:140};window.addEventListener('mousemove',e=>{m.x=e.clientX;m.y=e.clientY});window.addEventListener('mouseleave',()=>{m.x=null;m.y=null});function rs(){w=window.innerWidth;h=window.innerHeight;d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];const n=Math.min(Math.floor((w*h)/22000),50);for(let i=0;i<n;i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;if(m.x!==null){const dx=m.x-p.x,dy=m.y-p.y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<m.r&&ds>0){const f=(m.r-ds)/m.r,a=Math.atan2(dy,dx);p.x-=Math.cos(a)*f*2;p.y-=Math.sin(a)*f*2}}x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn();
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(initAmbient, { timeout: 2000 });
  } else {
    setTimeout(initAmbient, 1200);
  }

  function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
  function fc(v){return v.toLocaleString('es-ES',{style:'currency',currency:'EUR',minimumFractionDigits:2,maximumFractionDigits:2})}

  function calculate() {
    const baseRaw = els.baseInput?.value.trim();
    const totalRaw = els.totalInput?.value.trim();
    if (!baseRaw || !totalRaw) { (els.baseInput || els.totalInput)?.classList.add('shake'); setTimeout(() => { els.baseInput?.classList.remove('shake'); els.totalInput?.classList.remove('shake'); }, 400); return; }
    const base = pn(baseRaw); const total = pn(totalRaw);
    if (isNaN(base) || isNaN(total) || base <= 0 || total <= base) { els.baseInput?.classList.add('shake'); els.totalInput?.classList.add('shake'); setTimeout(() => { els.baseInput?.classList.remove('shake'); els.totalInput?.classList.remove('shake'); }, 400); return; }
    const iva = total - base;
    const percent = (iva / base) * 100;
    lastResult = { base, iva, total, percent };

    els.resultPercent.textContent = `${percent % 1 === 0 ? percent : percent.toFixed(2)}%`;
    els.resultBaseValue.textContent = fc(base);
    els.resultIvaValue.textContent = fc(iva);
    els.resultTotalValue.textContent = fc(total);

    // Check official rates
    const officialRates = [4, 10, 21];
    const roundedPct = Math.round(percent * 100) / 100;
    const match = officialRates.find(r => Math.abs(roundedPct - r) < 0.01);
    if (match) {
      const names = { 4: 'Superreducido', 10: 'Reducido', 21: 'General' };
      els.rateMatch.classList.remove('hidden');
      els.rateMatchText.textContent = `✓ Coincide con el tipo ${names[match]} de España (${match}%)`;
    } else { els.rateMatch.classList.add('hidden'); }

    // Chart
    const cv = els.breakdownCanvas; if (cv) {
      const ctx = cv.getContext('2d'); if (ctx) {
        const dp = window.devicePixelRatio || 1, sz = 170; cv.width = sz * dp; cv.height = sz * dp; ctx.scale(dp, dp);
        const cx = sz/2, cy = sz/2, rd = sz*.38, lw = 16;
        const br = base / total, ir = iva / total;
        els.chartCenterPercent.textContent = `${percent % 1 === 0 ? percent : percent.toFixed(1)}%`;
        els.chartCenterLabel.textContent = 'IVA detectado';
        const st = performance.now(), du = 600;
        let crid;
        function f(now) {
          const p = Math.min((now - st) / du, 1), e = 1 - Math.pow(1 - p, 3);
          ctx.clearRect(0, 0, sz, sz);
          const dk = document.documentElement.getAttribute('data-theme') === 'dark';
          ctx.beginPath(); ctx.arc(cx, cy, rd, 0, Math.PI * 2); ctx.strokeStyle = dk ? 'rgba(255,255,255,0.08)' : 'rgba(15,23,42,0.06)'; ctx.lineWidth = lw; ctx.stroke();
          const sa = -Math.PI / 2, ta = Math.PI * 2 * e, ba = ta * br, ia = ta * ir;
          if (ba > 0) { ctx.beginPath(); ctx.arc(cx, cy, rd, sa, sa + ba); const g = ctx.createLinearGradient(0, 0, sz, sz); g.addColorStop(0, '#4f46e5'); g.addColorStop(1, '#6366f1'); ctx.strokeStyle = g; ctx.lineWidth = lw; ctx.lineCap = 'round'; ctx.stroke(); }
          if (ia > 0) { ctx.beginPath(); ctx.arc(cx, cy, rd, sa + ba, sa + ba + ia); const g = ctx.createLinearGradient(0, 0, sz, sz); g.addColorStop(0, '#ec4899'); g.addColorStop(1, '#c084fc'); ctx.strokeStyle = g; ctx.lineWidth = lw; ctx.lineCap = 'round'; ctx.stroke(); }
          if (p < 1) crid = requestAnimationFrame(f);
        }
        crid = requestAnimationFrame(f);
      }
    }

    els.calcBody.classList.add('hidden');
    els.resultsPanel.classList.remove('hidden');
  }

  els.calcButton?.addEventListener('click', calculate);
  els.baseInput?.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); els.totalInput?.focus(); } });
  els.totalInput?.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); calculate(); } });
  els.resultsClose?.addEventListener('click', () => { els.resultsPanel.classList.add('hidden'); els.calcBody.classList.remove('hidden'); });
  els.newCalc?.addEventListener('click', () => { els.resultsPanel.classList.add('hidden'); els.calcBody.classList.remove('hidden'); els.baseInput.value = ''; els.totalInput.value = ''; els.baseInput.focus(); });
  els.copyResult?.addEventListener('click', () => { if (!lastResult) return; const { base, iva, total, percent } = lastResult; const t = `Calculadora IVA Porcentaje\nBase imponible: ${fc(base)}\nCuota de IVA: ${fc(iva)}\nTotal: ${fc(total)}\nPorcentaje de IVA: ${percent % 1 === 0 ? percent : percent.toFixed(2)}%`; navigator.clipboard.writeText(t).then(() => { const ex = document.querySelector('.toast'); if (ex) ex.remove(); const toast = document.createElement('div'); toast.className = 'toast show'; toast.textContent = '✓ Porcentaje copiado'; document.body.appendChild(toast); setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 300); }, 2500); }); });

  document.querySelectorAll('.faq-item .faq-question').forEach(button => { button.addEventListener('click', () => { const item = button.closest('.faq-item'); if (!item) return; const isOpen = item.classList.contains('open'); document.querySelectorAll('.faq-item').forEach(i => { if (i !== item) { i.classList.remove('open'); const b = i.querySelector('.faq-question'); if (b) b.setAttribute('aria-expanded', 'false'); } }); if (isOpen) { item.classList.remove('open'); button.setAttribute('aria-expanded', 'false'); } else { item.classList.add('open'); button.setAttribute('aria-expanded', 'true'); } }); });
});
</script>
