---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import IvaCalculator from '../components/IvaCalculator.astro';
import DefinicionIva from '../components/DefinicionIva.astro';
import EjemplosIva from '../components/EjemplosIva.astro';
import FormulaIva from '../components/FormulaIva.astro';
import HowItWorks from '../components/HowItWorks.astro';
import RateTable from '../components/RateTable.astro';
import ToolsShowcase from '../components/ToolsShowcase.astro';
import BlogSection from '../components/BlogSection.astro';
import FaqSection from '../components/FaqSection.astro';
import { defaultLocale, useTranslations } from '../i18n/utils';

const locale = defaultLocale;
const { t, faq } = useTranslations(locale);
---

<BaseLayout
  title={t('siteTitle')}
  description={t('siteDescription')}
  schemaType="WebSite"
  isCalculator={true}
  faqItems={faq.items}
  locale={locale}
>
  <!-- Hero Section with animated counters & feature checkmarks -->
  <HeroSection locale={locale} />

  <!-- Interactive Calculator Section -->
  <section class="calculator-section" id="calculator">
    <IvaCalculator locale={locale} />
  </section>

  <!-- Section: ¿Qué es el IVA? (Short definition) -->
  <DefinicionIva locale={locale} />

  <!-- Section: Ejemplos de Cálculo de IVA -->
  <EjemplosIva locale={locale} />

  <!-- Section: ¿Cuál es la fórmula para calcular el IVA? & IVA soportado vs repercutido -->
  <FormulaIva locale={locale} />

  <!-- Section: ¿Cómo funciona la calculadora de IVA? (4-step interactive walkthrough) -->
  <HowItWorks locale={locale} />

  <!-- Section: IVA Percentage (18-country comparison chart & Spain rate cards) -->
  <RateTable locale={locale} />

  <!-- Section: All Calculator Tools Showcase -->
  <ToolsShowcase locale={locale} />

  <!-- Section: Blog & Guides Showcase -->
  <BlogSection locale={locale} />

  <!-- Section: FAQ (6 questions + Quick Reference Table) -->
  <FaqSection locale={locale} />
</BaseLayout>
