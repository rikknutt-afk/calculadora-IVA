---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA e ISR — Facturas y Honorarios México";
const description = "Calculadora de IVA e ISR para México. Calcula el IVA al 16% y la retención de ISR en recibos de honorarios, CFDI y facturas de servicios profesionales.";

const faqItems = [
  { question: "¿Qué es el ISR y cómo se diferencia del IVA en México?", answer: "El ISR (Impuesto Sobre la Renta) es un impuesto directo sobre los ingresos que se aplica a personas físicas y morales en México. El IVA (Impuesto al Valor Agregado) es un impuesto indirecto al consumo del 16%. El ISR grava las ganancias, el IVA grava las transacciones comerciales.", display: true },
  { question: "¿Cuánto es la retención de ISR en servicios profesionales?", answer: "Para personas físicas que prestan servicios profesionales (honorarios), la retención de ISR es del 10% sobre el monto antes de IVA. La persona moral que paga los servicios retiene este 10% y lo entera al SAT. El profesional acredita estas retenciones en su declaración anual.", display: true, formula: { base: "10.000 MXN", rate: "× 10%", result: "1.000 MXN ISR" } },
  { question: "¿Cómo se calcula la retención de IVA e ISR en un CFDI?", answer: "En un CFDI de servicios: Base × 16% = IVA. Base × 10% = Retención ISR. Base × 10.6667% = Retención IVA (2/3 del IVA). Total = Base + IVA − Retención ISR − Retención IVA. Ejemplo: 10.000 + 1.600 − 1.000 − 1.066,67 = 9.533,33 MXN.", display: true },
  { question: "¿Cuándo se retiene el IVA además del ISR?", answer: "Se retiene IVA cuando una persona moral paga a una persona física por: servicios profesionales independientes (2/3 del IVA), uso o goce temporal de bienes (2/3 del IVA), servicios de autotransporte (4%), o comisionistas (2/3 del IVA). La retención de IVA es adicional a la de ISR.", display: true },
  { question: "¿Cómo funciona el ISR para asalariados vs independientes?", answer: "Los asalariados tienen retención de ISR sobre su nómina según tablas progresivas (1.92% a 35%). Los independientes (personas físicas con actividad empresarial) pagan ISR provisional mensual sobre sus ingresos menos deducciones, y aplican retenciones del 10% cuando facturan a personas morales.", display: true },
  { question: "¿Qué es la retención de dos tercios del IVA?", answer: "Cuando una persona moral paga servicios profesionales a una persona física, debe retener 2/3 (66.67%) del IVA causado. Si el IVA es 1.600 MXN, la retención es 1.600 × 2/3 = 1.066,67 MXN. Esta retención se declara en el CFDI y se entera al SAT mensualmente.", display: true, formula: { base: "1.600 MXN IVA", rate: "× 2/3", result: "1.066,67 MXN ret." } }
];

const isrTable = [
  { ingreso: '5.000 MXN', iva16: '800 MXN', isr10: '500 MXN', retIva: '533,33 MXN', liquido: '4.766,67 MXN' },
  { ingreso: '10.000 MXN', iva16: '1.600 MXN', isr10: '1.000 MXN', retIva: '1.066,67 MXN', liquido: '9.533,33 MXN' },
  { ingreso: '15.000 MXN', iva16: '2.400 MXN', isr10: '1.500 MXN', retIva: '1.600,00 MXN', liquido: '14.300,00 MXN' },
  { ingreso: '20.000 MXN', iva16: '3.200 MXN', isr10: '2.000 MXN', retIva: '2.133,33 MXN', liquido: '19.066,67 MXN' },
  { ingreso: '30.000 MXN', iva16: '4.800 MXN', isr10: '3.000 MXN', retIva: '3.200,00 MXN', liquido: '28.600,00 MXN' },
  { ingreso: '50.000 MXN', iva16: '8.000 MXN', isr10: '5.000 MXN', retIva: '5.333,33 MXN', liquido: '47.666,67 MXN' },
  { ingreso: '100.000 MXN', iva16: '16.000 MXN', isr10: '10.000 MXN', retIva: '10.666,67 MXN', liquido: '95.333,33 MXN' },
];
---

<BaseLayout title={title} description={description} schemaType="WebSite" faqItems={faqItems} locale="es">
  <section class="hero" id="hero"><div class="hero-content"><h1 class="hero-title">Calculadora <span class="gradient-text">IVA e ISR</span></h1><p class="hero-subtitle">Calcula el IVA al 16% y la retención de ISR para tus facturas CFDI en México.<br class="hidden sm:inline" /> Incluye retención de IVA (⅔) para servicios profesionales entre personas morales y físicas.</p></div></section>

  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <div class="mb-6"><div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20"><svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span class="text-sm font-bold text-emerald-600 dark:text-emerald-400">CFDI — México</span></div></div>

        <div id="calcBody" class="space-y-6">
          <div><label for="amountInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><span>Importe antes de impuestos</span></label><div class="relative"><input type="text" id="amountInput" class="w-full py-4 pl-5 pr-16 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 10.000" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-lg font-bold text-[var(--text-tertiary)]">MXN</span></div></div>

          <div><label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg><span>Tasa de IVA</span></label>
          <div class="grid grid-cols-3 gap-2.5"><button type="button" class="rate-btn active flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-indigo-500 bg-indigo-500/5 ring-3 ring-indigo-500/15 shadow-sm transition-all" data-rate="16" role="radio" aria-checked="true"><span class="font-display font-bold text-base text-[var(--text-primary)]">16%</span><span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wide">General México</span></button><button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="8" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">8%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Frontera</span></button><button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="0" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">0%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Tasa 0%</span></button></div></div>

          <div><label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Retención ISR</span></label>
          <div class="grid grid-cols-3 gap-2.5"><button type="button" class="isr-btn active flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-rose-500 bg-rose-500/5 ring-3 ring-rose-500/15 shadow-sm transition-all" data-isr="10" role="radio" aria-checked="true"><span class="font-display font-bold text-base text-[var(--text-primary)]">10%</span><span class="text-[10px] font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wide">Honorarios</span></button><button type="button" class="isr-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-rose-500 hover:-translate-y-0.5 shadow-sm transition-all" data-isr="1.25" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">1.25%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Arrendamiento</span></button><button type="button" class="isr-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-rose-500 hover:-translate-y-0.5 shadow-sm transition-all" data-isr="4" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">4%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Autotransporte</span></button></div></div>

          <div class="flex items-center gap-3 p-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-tertiary)]"><input type="checkbox" id="retIvaCheck" class="w-4 h-4 rounded accent-indigo-600" checked /><label for="retIvaCheck" class="text-sm font-semibold text-[var(--text-secondary)] cursor-pointer">Aplicar retención de IVA (⅔ del IVA)</label></div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group"><span class="relative z-10">Calcular IVA e ISR</span><svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg><div class="btn-shine" aria-hidden="true"></div></button>
        </div>

        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between"><p class="font-display font-extrabold text-xl gradient-text">Desglose CFDI</p><button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg><span>Modificar</span></button></div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm"><span class="text-sm font-semibold text-[var(--text-secondary)]">Subtotal</span><span class="font-display font-bold text-lg text-[var(--text-primary)]" id="rSubtotal">$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/30 bg-indigo-500/5 shadow-sm"><span class="text-sm font-bold text-indigo-600 dark:text-indigo-400">+ IVA (<span id="rIvaRate">16</span>%)</span><span class="font-display font-bold text-lg text-indigo-600 dark:text-indigo-400" id="rIva">+$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-rose-500/30 bg-rose-500/5 shadow-sm"><span class="text-sm font-bold text-rose-600 dark:text-rose-400">− Retención ISR (<span id="rIsrRate">10</span>%)</span><span class="font-display font-bold text-lg text-rose-600 dark:text-rose-400" id="rIsr">−$0</span></div>
            <div id="retIvaRow" class="flex items-center justify-between p-4 rounded-xl border border-purple-500/30 bg-purple-500/5 shadow-sm"><span class="text-sm font-bold text-purple-600 dark:text-purple-400">− Retención IVA (⅔)</span><span class="font-display font-bold text-lg text-purple-600 dark:text-purple-400" id="rRetIva">−$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md"><span class="text-sm font-bold text-[var(--text-secondary)]">Total a cobrar</span><span class="font-display font-extrabold text-2xl gradient-text" id="rTotal">$0</span></div>
          </div>
          <div class="relative w-[170px] h-[170px] mx-auto flex items-center justify-center"><canvas id="breakdownCanvas" class="w-[170px] h-[170px] block drop-shadow-md" width="170" height="170"></canvas><div class="absolute flex flex-col items-center justify-center pointer-events-none"><span id="chartCenterPercent" class="font-display font-extrabold text-lg text-[var(--text-primary)] leading-none">$0</span><span id="chartCenterLabel" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mt-1">Total</span></div></div>
          <div class="flex gap-3 pt-2"><button type="button" id="copyResult" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copiar</span></button><button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Nuevo</span></button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="calcular-iva"><div class="section-container"><h2 class="section-title">3 Escenarios de <span class="gradient-text">IVA e ISR en México</span></h2><p class="section-subtitle">Retenciones de IVA e ISR según el tipo de operación en el sistema fiscal mexicano (SAT)</p><div class="methods-grid">
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div><span class="method-number">01</span></div><h3 class="method-title">Servicios profesionales (honorarios)</h3><p class="method-desc">Persona física que presta servicios a persona moral. ISR retenido: 10%. IVA: 16%. Retención IVA: ⅔ del IVA (10.6667%).</p><div class="method-formula"><span class="method-formula-var">10.000 + 1.600</span><span class="method-formula-op">−</span><span class="method-formula-var">1.000 − 1.067</span><span class="method-formula-op">=</span><span class="method-formula-result">9.533 MXN</span></div><div class="method-example"><span class="method-example-label">CFDI</span><span>Subtotal + IVA − ISR − Ret. IVA = <strong>$9.533</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-remove"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg></div><span class="method-number">02</span></div><h3 class="method-title">Arrendamiento de inmuebles</h3><p class="method-desc">Persona moral que renta a persona física. ISR retenido: 10%. IVA: 16%. Retención IVA: ⅔ del IVA. Aplica solo en renta de inmuebles.</p><div class="method-formula"><span class="method-formula-var">20.000 + 3.200</span><span class="method-formula-op">−</span><span class="method-formula-var">2.000 − 2.133</span><span class="method-formula-op">=</span><span class="method-formula-result">19.067 MXN</span></div><div class="method-example"><span class="method-example-label">CFDI</span><span>Renta + IVA − retenciones = <strong>$19.067</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-desglose"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M8 12h8"/></svg></div><span class="method-number">03</span></div><h3 class="method-title">Autotransporte terrestre</h3><p class="method-desc">Servicios de transporte terrestre de carga. ISR retenido: 4%. IVA: 16%. Retención IVA: 4%. Regulado por RMF del SAT.</p><div class="method-formula"><span class="method-formula-var">50.000 + 8.000</span><span class="method-formula-op">−</span><span class="method-formula-var">2.000 − 2.000</span><span class="method-formula-op">=</span><span class="method-formula-result">54.000 MXN</span></div><div class="method-example"><span class="method-example-label">CFDI</span><span>Flete + IVA − retenciones = <strong>$54.000</strong></span></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="formula-iva"><div class="section-container"><h2 class="section-title">Fórmulas de <span class="gradient-text">IVA e ISR</span> para CFDI</h2><p class="section-subtitle">Las fórmulas fiscales para calcular retenciones de IVA e ISR en facturas CFDI de México</p><div class="formula-builder">
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-add"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/></svg><span>CFDI con retenciones (honorarios)</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">Subtotal + IVA</span><span class="formula-builder-value">10.000 + 1.600</span></div><span class="formula-builder-op">−</span><div class="formula-builder-part"><span class="formula-builder-label">ISR + Ret. IVA</span><span class="formula-builder-value">1.000 + 1.067</span></div><span class="formula-builder-op">=</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Total</span><span class="formula-builder-value">$9.533</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Subtotal</span><span>$10.000,00</span></div><div class="formula-builder-breakdown-row"><span>+ IVA 16%</span><span>+$1.600,00</span></div><div class="formula-builder-breakdown-row"><span>− Retención ISR 10%</span><span>−$1.000,00</span></div><div class="formula-builder-breakdown-row"><span>− Retención IVA ⅔</span><span>−$1.066,67</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Total CFDI</span><span>$9.533,33</span></div></div></div>
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-remove"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>Sin retención IVA</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">Subtotal + IVA</span><span class="formula-builder-value">10.000 + 1.600</span></div><span class="formula-builder-op">−</span><div class="formula-builder-part"><span class="formula-builder-label">ISR 10%</span><span class="formula-builder-value">1.000</span></div><span class="formula-builder-op">=</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Total</span><span class="formula-builder-value">$10.600</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Subtotal</span><span>$10.000,00</span></div><div class="formula-builder-breakdown-row"><span>+ IVA 16%</span><span>+$1.600,00</span></div><div class="formula-builder-breakdown-row"><span>− Retención ISR 10%</span><span>−$1.000,00</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Total CFDI</span><span>$10.600,00</span></div></div></div>
  </div></div></section>

  <section class="content-section" id="como-funciona"><div class="section-container"><h2 class="section-title">¿Cómo Calcular <span class="gradient-text">IVA e ISR</span> en tu CFDI?</h2><p class="section-subtitle">4 pasos para generar el cálculo correcto de IVA e ISR en facturas mexicanas</p><div class="walkthrough-steps">
    <div class="walkthrough-step" data-step="1"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">1</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">💵</div><h3 class="walkthrough-step-title">1. Ingresa el subtotal</h3><p class="walkthrough-step-desc">Escribe el monto de tus servicios o productos antes de impuestos (subtotal del CFDI).</p><div class="walkthrough-mini-input"><span class="mini-input-label">Subtotal</span><div class="mini-input-box">10.000 <span class="mini-input-currency">MXN</span></div></div></div></div>
    <div class="walkthrough-step" data-step="2"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">2</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">🏛️</div><h3 class="walkthrough-step-title">2. Selecciona tasas y retenciones</h3><p class="walkthrough-step-desc">Elige la tasa de IVA (16%, 8% frontera, 0%) y la retención de ISR según el tipo de operación (10%, 1.25% o 4%).</p></div></div>
    <div class="walkthrough-step" data-step="3"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">3</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📋</div><h3 class="walkthrough-step-title">3. Retención IVA ⅔ (opcional)</h3><p class="walkthrough-step-desc">Para servicios profesionales persona física → moral, marca la casilla de retención de ⅔ del IVA (10.6667% sobre subtotal).</p></div></div>
    <div class="walkthrough-step" data-step="4"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">4</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">✅</div><h3 class="walkthrough-step-title">4. Obtén el total del CFDI</h3><p class="walkthrough-step-desc">Visualiza el desglose completo: subtotal, IVA, retención ISR, retención IVA y total a cobrar.</p><div class="walkthrough-mini-result"><div class="mini-result-row"><span>Subtotal</span><span class="mini-result-value">$10.000</span></div><div class="mini-result-row" style="color:var(--accent-indigo)"><span>+ IVA 16%</span><span class="mini-result-value">+$1.600</span></div><div class="mini-result-row" style="color:#e11d48"><span>− ISR 10%</span><span class="mini-result-value">−$1.000</span></div><div class="mini-result-row" style="color:#9333ea"><span>− Ret. IVA ⅔</span><span class="mini-result-value">−$1.067</span></div><div class="mini-result-row mini-result-total"><span>Total CFDI</span><span class="mini-result-value"><strong>$9.533</strong></span></div></div></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="tabla-referencia"><div class="section-container section-container-wide"><h2 class="section-title">Tabla de <span class="gradient-text">IVA e ISR</span> para Honorarios</h2><p class="section-subtitle">Desglose de IVA (16%), ISR (10%) y retención de IVA (⅔) para importes habituales en México</p><div class="quick-table-wrapper"><div class="quick-table-container"><table class="quick-table"><thead><tr><th>Ingreso</th><th>IVA 16%</th><th>ISR 10%</th><th>Ret. IVA ⅔</th><th>Total a cobrar</th></tr></thead><tbody>{isrTable.map((r) => (<tr><td><strong>{r.ingreso}</strong></td><td>{r.iva16}</td><td>{r.isr10}</td><td>{r.retIva}</td><td><strong>{r.liquido}</strong></td></tr>))}</tbody></table></div></div></div></section>

  <section class="faq-section" id="faq"><div class="section-container"><h2 class="section-title">Preguntas sobre <span class="gradient-text">IVA e ISR</span></h2><p class="section-subtitle">Todo sobre las retenciones de IVA e ISR en el sistema fiscal mexicano (SAT)</p><div class="faq-list" id="faqList">{faqItems.map((item, idx) => (<div class="faq-item" id={`faq${idx + 1}`}><button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button"><span>{item.question}</span><svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></button><div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}><p set:html={item.answer} />{item.formula && (<div class="faq-formula-mini"><div class="faq-formula-equation"><span class="faq-formula-var">{item.formula.base}</span><span class="faq-formula-op">×</span><span class="faq-formula-var">{item.formula.rate}</span><span class="faq-formula-op">=</span><span class="faq-formula-result">{item.formula.result}</span></div></div>)}</div></div>))}</div></div></section>
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded',()=>{const els={amountInput:document.getElementById('amountInput'),rateButtons:document.querySelectorAll('.rate-btn'),isrButtons:document.querySelectorAll('.isr-btn'),retIvaCheck:document.getElementById('retIvaCheck'),calcButton:document.getElementById('calcButton'),calcBody:document.getElementById('calcBody'),resultsPanel:document.getElementById('resultsPanel'),resultsClose:document.getElementById('resultsClose'),rSubtotal:document.getElementById('rSubtotal'),rIvaRate:document.getElementById('rIvaRate'),rIva:document.getElementById('rIva'),rIsrRate:document.getElementById('rIsrRate'),rIsr:document.getElementById('rIsr'),rRetIva:document.getElementById('rRetIva'),retIvaRow:document.getElementById('retIvaRow'),rTotal:document.getElementById('rTotal'),breakdownCanvas:document.getElementById('breakdownCanvas'),chartCenterPercent:document.getElementById('chartCenterPercent'),chartCenterLabel:document.getElementById('chartCenterLabel'),copyResult:document.getElementById('copyResult'),newCalc:document.getElementById('newCalc'),ambientCanvas:document.getElementById('ambientCanvas')};
let state={rate:16,isr:10,lastResult:null};
function initAmbient(){
  if(window.innerWidth<768||window.matchMedia('(prefers-reduced-motion: reduce)').matches){if(els.ambientCanvas)els.ambientCanvas.style.display='none';return;}
  const c=els.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0;function rs(){w=window.innerWidth;h=window.innerHeight;const d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];for(let i=0;i<Math.min(Math.floor(w*h/22000),50);i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn()}
if('requestIdleCallback' in window){requestIdleCallback(initAmbient,{timeout:2000});}else{setTimeout(initAmbient,1200);}
els.rateButtons?.forEach(btn=>{btn.addEventListener('click',()=>{els.rateButtons.forEach(b=>{b.classList.remove('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15');b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]');b.setAttribute('aria-checked','false')});btn.classList.add('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15');btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]');btn.setAttribute('aria-checked','true');state.rate=parseFloat(btn.dataset.rate)})});
els.isrButtons?.forEach(btn=>{btn.addEventListener('click',()=>{els.isrButtons.forEach(b=>{b.classList.remove('border-rose-500','bg-rose-500/5','ring-3','ring-rose-500/15');b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]');b.setAttribute('aria-checked','false')});btn.classList.add('border-rose-500','bg-rose-500/5','ring-3','ring-rose-500/15');btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]');btn.setAttribute('aria-checked','true');state.isr=parseFloat(btn.dataset.isr)})});
function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
function fm(v){return '$'+v.toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2})}
function fr(r){return r%1===0?r.toString():r.toFixed(2)}
function calculate(){const raw=els.amountInput?.value.trim();if(!raw){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}const sub=pn(raw);if(isNaN(sub)||sub<=0){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}const iva=sub*(state.rate/100);const isr=sub*(state.isr/100);const applyRetIva=els.retIvaCheck?.checked;const retIva=applyRetIva?iva*(2/3):0;const total=sub+iva-isr-retIva;state.lastResult={sub,iva,isr,retIva,total,rate:state.rate,isrRate:state.isr,applyRetIva};
els.rSubtotal.textContent=fm(sub);els.rIvaRate.textContent=fr(state.rate);els.rIva.textContent=`+${fm(iva)}`;els.rIsrRate.textContent=fr(state.isr);els.rIsr.textContent=`−${fm(isr)}`;if(applyRetIva){els.retIvaRow.classList.remove('hidden');els.rRetIva.textContent=`−${fm(retIva)}`}else{els.retIvaRow.classList.add('hidden')}els.rTotal.textContent=fm(total);
// Chart
const cv=els.breakdownCanvas;if(cv){const ctx=cv.getContext('2d');if(ctx){const dp=window.devicePixelRatio||1,sz=170;cv.width=sz*dp;cv.height=sz*dp;ctx.scale(dp,dp);const cx=sz/2,cy=sz/2,rd=sz*.38,lw=16;const gt=sub+iva;const sR=sub/gt,iR=iva/gt;els.chartCenterPercent.textContent=fm(total).replace('$','');els.chartCenterLabel.textContent='Total MXN';const st=performance.now(),du=600;let crid;function f(now){const p=Math.min((now-st)/du,1),e=1-Math.pow(1-p,3);ctx.clearRect(0,0,sz,sz);const dk=document.documentElement.getAttribute('data-theme')==='dark';ctx.beginPath();ctx.arc(cx,cy,rd,0,Math.PI*2);ctx.strokeStyle=dk?'rgba(255,255,255,0.08)':'rgba(15,23,42,0.06)';ctx.lineWidth=lw;ctx.stroke();const sa=-Math.PI/2,ta=Math.PI*2*e,a1=ta*sR,a2=ta*iR;if(a1>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa,sa+a1);const g=ctx.createLinearGradient(0,0,sz,sz);g.addColorStop(0,'#4f46e5');g.addColorStop(1,'#6366f1');ctx.strokeStyle=g;ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(a2>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa+a1,sa+a1+a2);const g=ctx.createLinearGradient(0,0,sz,sz);g.addColorStop(0,'#10b981');g.addColorStop(1,'#34d399');ctx.strokeStyle=g;ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(p<1)crid=requestAnimationFrame(f)}crid=requestAnimationFrame(f)}}
els.calcBody.classList.add('hidden');els.resultsPanel.classList.remove('hidden')}
els.calcButton?.addEventListener('click',calculate);els.amountInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();calculate()}});
els.resultsClose?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden')});
els.newCalc?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden');els.amountInput.value='';els.amountInput.focus()});
els.copyResult?.addEventListener('click',()=>{if(!state.lastResult)return;const r=state.lastResult;let t=`CFDI — IVA e ISR\nSubtotal: ${fm(r.sub)}\n+IVA ${fr(r.rate)}%: ${fm(r.iva)}\n−ISR ${fr(r.isrRate)}%: ${fm(r.isr)}`;if(r.applyRetIva)t+=`\n−Ret. IVA ⅔: ${fm(r.retIva)}`;t+=`\nTotal: ${fm(r.total)}`;navigator.clipboard.writeText(t).then(()=>{const ex=document.querySelector('.toast');if(ex)ex.remove();const toast=document.createElement('div');toast.className='toast show';toast.textContent='✓ CFDI copiado';document.body.appendChild(toast);setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>toast.remove(),300)},2500)})});
document.querySelectorAll('.faq-item .faq-question').forEach(b=>{b.addEventListener('click',()=>{const i=b.closest('.faq-item');if(!i)return;const o=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>{if(x!==i){x.classList.remove('open');const btn=x.querySelector('.faq-question');if(btn)btn.setAttribute('aria-expanded','false')}});if(o){i.classList.remove('open');b.setAttribute('aria-expanded','false')}else{i.classList.add('open');b.setAttribute('aria-expanded','true')}})});
});
</script>
