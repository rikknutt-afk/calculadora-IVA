---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA Honorarios — IVA e IRPF para Profesionales";
const description = "Calculadora de IVA para honorarios profesionales. Calcula el IVA y la retención de IRPF en facturas de autónomos, abogados, médicos y consultores en España.";

const faqItems = [
  { question: "¿Cómo se calcula el IVA en los honorarios profesionales?", answer: "El IVA se aplica sobre el importe bruto de los honorarios. Para un autónomo en España: Honorarios × 0,21 = Cuota de IVA. Los honorarios de 1.500 € al 21% generan 315 € de IVA. El total de la factura sería 1.815 €, menos la retención de IRPF si corresponde.", display: true, formula: { base: "1.500 €", rate: "× 0,21", result: "315 € IVA" } },
  { question: "¿Qué retención de IRPF aplica a los honorarios?", answer: "La retención de IRPF estándar para autónomos profesionales es del 15%. Para nuevos autónomos en los 3 primeros ejercicios, se aplica el 7% reducido. Actividades agrícolas y ganaderas: 2%. Artistas: 15%. La retención se calcula sobre los honorarios brutos (base imponible).", display: true },
  { question: "¿Cuál es la diferencia entre IVA e IRPF en honorarios?", answer: "El IVA (21%) se suma a los honorarios y lo paga el cliente como impuesto al consumo. El IRPF (15%) se resta de los honorarios como anticipo del Impuesto sobre la Renta del profesional. Fórmula: Total = Honorarios + IVA − IRPF.", display: true },
  { question: "¿Cómo se calcula el líquido a cobrar en una factura de honorarios?", answer: "Líquido = Honorarios + IVA − Retención IRPF. Ejemplo: 2.000 € de honorarios → IVA 21%: +420 € → IRPF 15%: −300 €. Líquido a cobrar: 2.000 + 420 − 300 = 2.120 €.", display: true, formula: { base: "2.000 + 420", rate: "− 300", result: "2.120 € líquido" } },
  { question: "¿Están exentos de IVA algunos honorarios profesionales?", answer: "Sí. Están exentos de IVA: servicios sanitarios (médicos, dentistas, psicólogos), enseñanza y formación reglada, operaciones de seguros, servicios sociales, y servicios artísticos subvencionados por el Estado. Deben facturar sin IVA pero con retención de IRPF.", display: true },
  { question: "¿Cuánto IRPF retiene un autónomo nuevo?", answer: "Los autónomos nuevos aplican una retención reducida del 7% de IRPF durante el año de alta y los 2 siguientes. A partir del 4º año, la retención sube al 15% general. Esta reducción incentiva el emprendimiento y mejora la liquidez inicial.", display: true }
];

const honorariosTable = [
  { honorarios: '500 €', iva21: '105,00 €', irpf15: '75,00 €', liquido15: '530,00 €', irpf7: '35,00 €', liquido7: '570,00 €' },
  { honorarios: '1.000 €', iva21: '210,00 €', irpf15: '150,00 €', liquido15: '1.060,00 €', irpf7: '70,00 €', liquido7: '1.140,00 €' },
  { honorarios: '1.500 €', iva21: '315,00 €', irpf15: '225,00 €', liquido15: '1.590,00 €', irpf7: '105,00 €', liquido7: '1.710,00 €' },
  { honorarios: '2.000 €', iva21: '420,00 €', irpf15: '300,00 €', liquido15: '2.120,00 €', irpf7: '140,00 €', liquido7: '2.280,00 €' },
  { honorarios: '3.000 €', iva21: '630,00 €', irpf15: '450,00 €', liquido15: '3.180,00 €', irpf7: '210,00 €', liquido7: '3.420,00 €' },
  { honorarios: '5.000 €', iva21: '1.050,00 €', irpf15: '750,00 €', liquido15: '5.300,00 €', irpf7: '350,00 €', liquido7: '5.700,00 €' },
  { honorarios: '10.000 €', iva21: '2.100,00 €', irpf15: '1.500,00 €', liquido15: '10.600,00 €', irpf7: '700,00 €', liquido7: '11.400,00 €' },
];
---

<BaseLayout title={title} description={description} schemaType="WebSite" faqItems={faqItems} locale="es">
  <section class="hero" id="hero"><div class="hero-content"><h1 class="hero-title">Calculadora IVA <span class="gradient-text">Honorarios</span></h1><p class="hero-subtitle">Calcula el IVA y la retención de IRPF de tus honorarios profesionales.<br class="hidden sm:inline" /> Obtén el líquido a cobrar en tu factura de autónomo al instante.</p></div></section>

  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <div id="calcBody" class="space-y-6">
          <div><label for="amountInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><span>Honorarios brutos</span></label><div class="relative"><input type="text" id="amountInput" class="w-full py-4 pl-5 pr-12 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 2.000,00" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-xl font-bold text-[var(--text-tertiary)]">€</span></div></div>

          <div><label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg><span>IVA de los honorarios</span></label>
          <div class="grid grid-cols-3 gap-2.5" role="radiogroup"><button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="0" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">0%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Exento</span></button><button type="button" class="rate-btn active flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-indigo-500 bg-indigo-500/5 ring-3 ring-indigo-500/15 shadow-sm transition-all" data-rate="21" role="radio" aria-checked="true"><span class="font-display font-bold text-base text-[var(--text-primary)]">21%</span><span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wide">General</span></button><button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" id="rateCustomBtn" data-rate="custom" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)] flex items-center"><input type="text" id="customRateInput" aria-label="Tipo de IVA personalizado" class="w-8 text-center bg-transparent border-b border-[var(--text-tertiary)] focus:border-indigo-500 outline-none text-base font-bold text-[var(--text-primary)]" placeholder="?" inputmode="decimal" />%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Otro</span></button></div></div>

          <div><label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/></svg><span>Retención IRPF</span></label>
          <div class="grid grid-cols-3 gap-2.5" role="radiogroup"><button type="button" class="irpf-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-amber-500 hover:-translate-y-0.5 shadow-sm transition-all" data-irpf="7" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">7%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Nuevo autónomo</span></button><button type="button" class="irpf-btn active flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-amber-500 bg-amber-500/5 ring-3 ring-amber-500/15 shadow-sm transition-all" data-irpf="15" role="radio" aria-checked="true"><span class="font-display font-bold text-base text-[var(--text-primary)]">15%</span><span class="text-[10px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wide">General</span></button><button type="button" class="irpf-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-amber-500 hover:-translate-y-0.5 shadow-sm transition-all" data-irpf="0" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">0%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Sin retención</span></button></div></div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group"><span class="relative z-10">Calcular Honorarios</span><svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg><div class="btn-shine" aria-hidden="true"></div></button>
        </div>

        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between"><p class="font-display font-extrabold text-xl gradient-text">Factura de Honorarios</p><button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg><span>Modificar</span></button></div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm"><span class="text-sm font-semibold text-[var(--text-secondary)]">Honorarios brutos</span><span class="font-display font-bold text-lg text-[var(--text-primary)]" id="resultHon">0,00 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm"><span class="text-sm font-semibold text-[var(--text-secondary)]">IVA (<span id="resultIvaRate">21</span>%)</span><span class="font-display font-bold text-lg text-indigo-600 dark:text-indigo-400" id="resultIva">+0,00 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-amber-500/30 bg-amber-500/5 shadow-sm"><span class="text-sm font-bold text-amber-600 dark:text-amber-400">IRPF (<span id="resultIrpfRate">15</span>%)</span><span class="font-display font-bold text-lg text-amber-600 dark:text-amber-400" id="resultIrpf">−0,00 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md"><span class="text-sm font-bold text-[var(--text-secondary)]">Líquido a cobrar</span><span class="font-display font-extrabold text-2xl gradient-text" id="resultNet">0,00 €</span></div>
          </div>
          <div class="relative w-[170px] h-[170px] mx-auto flex items-center justify-center"><canvas id="breakdownCanvas" class="w-[170px] h-[170px] block drop-shadow-md" width="170" height="170"></canvas><div class="absolute flex flex-col items-center justify-center pointer-events-none"><span id="chartCenterPercent" class="font-display font-extrabold text-2xl text-[var(--text-primary)] leading-none">0 €</span><span id="chartCenterLabel" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mt-1">Líquido</span></div></div>
          <div class="flex gap-3 pt-2"><button type="button" id="copyResult" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copiar</span></button><button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Nuevo Cálculo</span></button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="calcular-iva"><div class="section-container"><h2 class="section-title">IVA en Honorarios para <span class="gradient-text">3 Perfiles Profesionales</span></h2><p class="section-subtitle">Cada perfil profesional tiene particularidades en la aplicación del IVA y la retención de IRPF</p><div class="methods-grid">
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div><span class="method-number">01</span></div><h3 class="method-title">Autónomo profesional</h3><p class="method-desc">Consultores, diseñadores, programadores. Facturan con 21% de IVA y 15% de retención de IRPF (7% los 3 primeros años).</p><div class="method-formula"><span class="method-formula-var">2.000 € + 420 €</span><span class="method-formula-op">−</span><span class="method-formula-var">300 €</span><span class="method-formula-op">=</span><span class="method-formula-result">2.120 €</span></div><div class="method-example"><span class="method-example-label">Líquido</span><span>Honorarios + IVA − IRPF = <strong>2.120 €</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-remove"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div><span class="method-number">02</span></div><h3 class="method-title">Profesional sanitario</h3><p class="method-desc">Médicos, dentistas, psicólogos. Sus servicios están exentos de IVA (0%) pero aplican retención de IRPF del 15%.</p><div class="method-formula"><span class="method-formula-var">1.500 € + 0 €</span><span class="method-formula-op">−</span><span class="method-formula-var">225 €</span><span class="method-formula-op">=</span><span class="method-formula-result">1.275 €</span></div><div class="method-example"><span class="method-example-label">Líquido</span><span>Honorarios − IRPF 15% = <strong>1.275 €</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-desglose"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div><span class="method-number">03</span></div><h3 class="method-title">Abogado o asesor</h3><p class="method-desc">Servicios jurídicos y de asesoría fiscal. Facturan con 21% de IVA y 15% de IRPF. Costes judiciales (suplidos) van sin IVA.</p><div class="method-formula"><span class="method-formula-var">3.000 € + 630 €</span><span class="method-formula-op">−</span><span class="method-formula-var">450 €</span><span class="method-formula-op">=</span><span class="method-formula-result">3.180 €</span></div><div class="method-example"><span class="method-example-label">Líquido</span><span>Honorarios + IVA − IRPF = <strong>3.180 €</strong></span></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="formula-iva"><div class="section-container"><h2 class="section-title">Fórmula de <span class="gradient-text">Honorarios con IVA e IRPF</span></h2><p class="section-subtitle">La fórmula completa para calcular el líquido a cobrar en una factura de honorarios profesionales</p><div class="formula-builder"><div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-add"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span>Factura de honorarios</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">Honorarios</span><span class="formula-builder-value">2.000 €</span></div><span class="formula-builder-op">+ IVA − IRPF</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Líquido</span><span class="formula-builder-value">2.120 €</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Honorarios brutos</span><span>2.000,00 €</span></div><div class="formula-builder-breakdown-row"><span>+ IVA (21%)</span><span>+420,00 €</span></div><div class="formula-builder-breakdown-row"><span>− IRPF (15%)</span><span>−300,00 €</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Líquido a cobrar</span><span>2.120,00 €</span></div></div></div><div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-remove"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>Nuevo autónomo (7%)</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">Honorarios</span><span class="formula-builder-value">2.000 €</span></div><span class="formula-builder-op">+ IVA − IRPF 7%</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Líquido</span><span class="formula-builder-value">2.280 €</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Honorarios brutos</span><span>2.000,00 €</span></div><div class="formula-builder-breakdown-row"><span>+ IVA (21%)</span><span>+420,00 €</span></div><div class="formula-builder-breakdown-row"><span>− IRPF (7% nuevo)</span><span>−140,00 €</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Líquido a cobrar</span><span>2.280,00 €</span></div></div></div></div></div></section>

  <section class="content-section" id="como-funciona"><div class="section-container"><h2 class="section-title">¿Cómo Calcular <span class="gradient-text">Honorarios con IVA</span>?</h2><p class="section-subtitle">4 pasos para generar una factura de honorarios con IVA e IRPF correctamente</p><div class="walkthrough-steps">
    <div class="walkthrough-step" data-step="1"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">1</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">💼</div><h3 class="walkthrough-step-title">1. Introduce tus honorarios</h3><p class="walkthrough-step-desc">Escribe el importe bruto de tus honorarios profesionales. Es la cantidad que cobras por tus servicios antes de impuestos.</p><div class="walkthrough-mini-input"><span class="mini-input-label">Honorarios</span><div class="mini-input-box">2.000,00 <span class="mini-input-currency">€</span></div></div></div></div>
    <div class="walkthrough-step" data-step="2"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">2</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📊</div><h3 class="walkthrough-step-title">2. Selecciona IVA e IRPF</h3><p class="walkthrough-step-desc">Elige el tipo de IVA (21% general o 0% exento) y la retención de IRPF (15% general o 7% nuevo autónomo).</p></div></div>
    <div class="walkthrough-step" data-step="3"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">3</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">⚡</div><h3 class="walkthrough-step-title">3. Calcula al instante</h3><p class="walkthrough-step-desc">La calculadora aplica Honorarios + IVA − IRPF y muestra el desglose completo con gráfico visual.</p></div></div>
    <div class="walkthrough-step" data-step="4"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">4</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">💰</div><h3 class="walkthrough-step-title">4. Copia tu factura</h3><p class="walkthrough-step-desc">Obtén los honorarios, IVA, IRPF y el líquido a cobrar. Copia el desglose para tu software de facturación.</p><div class="walkthrough-mini-result"><div class="mini-result-row"><span>Honorarios</span><span class="mini-result-value">2.000,00 €</span></div><div class="mini-result-row" style="color:var(--accent-indigo)"><span>+ IVA (21%)</span><span class="mini-result-value">+420,00 €</span></div><div class="mini-result-row" style="color:var(--accent-amber)"><span>− IRPF (15%)</span><span class="mini-result-value">−300,00 €</span></div><div class="mini-result-row mini-result-total"><span>Líquido</span><span class="mini-result-value"><strong>2.120,00 €</strong></span></div></div></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="tabla-referencia"><div class="section-container section-container-wide"><h2 class="section-title">Tabla de <span class="gradient-text">Honorarios con IVA e IRPF</span></h2><p class="section-subtitle">Líquido a cobrar para honorarios habituales con IVA al 21% y retención de IRPF al 15% y 7%</p><div class="quick-table-wrapper"><div class="quick-table-container"><table class="quick-table"><thead><tr><th>Honorarios</th><th>IVA 21%</th><th>IRPF 15%</th><th>Líquido 15%</th><th>IRPF 7%</th><th>Líquido 7%</th></tr></thead><tbody>{honorariosTable.map((r) => (<tr><td><strong>{r.honorarios}</strong></td><td>{r.iva21}</td><td>{r.irpf15}</td><td>{r.liquido15}</td><td>{r.irpf7}</td><td><strong>{r.liquido7}</strong></td></tr>))}</tbody></table></div></div></div></section>

  <section class="faq-section" id="faq"><div class="section-container"><h2 class="section-title">Preguntas sobre <span class="gradient-text">IVA en Honorarios</span></h2><p class="section-subtitle">Todo sobre el IVA y la retención de IRPF en facturas de profesionales autónomos</p><div class="faq-list" id="faqList">{faqItems.map((item, idx) => (<div class="faq-item" id={`faq${idx + 1}`}><button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button"><span>{item.question}</span><svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></button><div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}><p set:html={item.answer} />{item.formula && (<div class="faq-formula-mini"><div class="faq-formula-equation"><span class="faq-formula-var">{item.formula.base}</span><span class="faq-formula-op">{item.formula.rate.startsWith('−') ? '−' : '×'}</span><span class="faq-formula-var">{item.formula.rate.replace(/^[−×] ?/,'')}</span><span class="faq-formula-op">=</span><span class="faq-formula-result">{item.formula.result}</span></div></div>)}</div></div>))}</div></div></section>
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded',()=>{const els={amountInput:document.getElementById('amountInput'),rateButtons:document.querySelectorAll('.rate-btn'),customRateInput:document.getElementById('customRateInput'),rateCustomBtn:document.getElementById('rateCustomBtn'),irpfButtons:document.querySelectorAll('.irpf-btn'),calcButton:document.getElementById('calcButton'),calcBody:document.getElementById('calcBody'),resultsPanel:document.getElementById('resultsPanel'),resultsClose:document.getElementById('resultsClose'),resultHon:document.getElementById('resultHon'),resultIvaRate:document.getElementById('resultIvaRate'),resultIva:document.getElementById('resultIva'),resultIrpfRate:document.getElementById('resultIrpfRate'),resultIrpf:document.getElementById('resultIrpf'),resultNet:document.getElementById('resultNet'),breakdownCanvas:document.getElementById('breakdownCanvas'),chartCenterPercent:document.getElementById('chartCenterPercent'),chartCenterLabel:document.getElementById('chartCenterLabel'),copyResult:document.getElementById('copyResult'),newCalc:document.getElementById('newCalc'),ambientCanvas:document.getElementById('ambientCanvas')};
let state={rate:21,irpf:15,isCustom:false,lastResult:null};
function initAmbient(){
  if(window.innerWidth<768||window.matchMedia('(prefers-reduced-motion: reduce)').matches){if(els.ambientCanvas)els.ambientCanvas.style.display='none';return;}
  const c=els.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0;function rs(){w=window.innerWidth;h=window.innerHeight;const d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];for(let i=0;i<Math.min(Math.floor(w*h/22000),50);i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn()}
if('requestIdleCallback' in window){requestIdleCallback(initAmbient,{timeout:2000});}else{setTimeout(initAmbient,1200);}
els.rateButtons?.forEach(btn=>{btn.addEventListener('click',()=>{const r=btn.dataset.rate;els.rateButtons.forEach(b=>{b.classList.remove('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15');b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]');b.setAttribute('aria-checked','false')});btn.classList.add('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15');btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]');btn.setAttribute('aria-checked','true');if(r==='custom'){state.isCustom=true;els.customRateInput?.focus();const v=pn(els.customRateInput?.value);state.rate=isNaN(v)?0:v}else{state.isCustom=false;state.rate=parseFloat(r)}})});
els.customRateInput?.addEventListener('input',()=>{if(state.isCustom){const v=pn(els.customRateInput.value);state.rate=isNaN(v)?0:v}});
els.customRateInput?.addEventListener('focus',()=>{els.rateCustomBtn?.click()});
els.irpfButtons?.forEach(btn=>{btn.addEventListener('click',()=>{els.irpfButtons.forEach(b=>{b.classList.remove('border-amber-500','bg-amber-500/5','ring-3','ring-amber-500/15');b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]');b.setAttribute('aria-checked','false')});btn.classList.add('border-amber-500','bg-amber-500/5','ring-3','ring-amber-500/15');btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]');btn.setAttribute('aria-checked','true');state.irpf=parseFloat(btn.dataset.irpf)})});
function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
function fc(v){return v.toLocaleString('es-ES',{style:'currency',currency:'EUR',minimumFractionDigits:2,maximumFractionDigits:2})}
function fr(r){return r%1===0?r.toString():r.toFixed(1)}
function calculate(){const raw=els.amountInput?.value.trim();if(!raw){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}const hon=pn(raw);if(isNaN(hon)||hon<=0){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}const iva=hon*(state.rate/100);const irpf=hon*(state.irpf/100);const net=hon+iva-irpf;state.lastResult={hon,iva,irpf,net,rate:state.rate,irpfRate:state.irpf};els.resultHon.textContent=fc(hon);els.resultIvaRate.textContent=fr(state.rate);els.resultIva.textContent=`+${fc(iva)}`;els.resultIrpfRate.textContent=fr(state.irpf);els.resultIrpf.textContent=`−${fc(irpf)}`;els.resultNet.textContent=fc(net);
const cv=els.breakdownCanvas;if(cv){const ctx=cv.getContext('2d');if(ctx){const dp=window.devicePixelRatio||1,sz=170;cv.width=sz*dp;cv.height=sz*dp;ctx.scale(dp,dp);const cx=sz/2,cy=sz/2,rd=sz*.38,lw=16;const total=hon+iva;const hR=hon/total,iR=iva/total;els.chartCenterPercent.textContent=fc(net).replace(/[^\d,.]/g,'');els.chartCenterLabel.textContent='Líquido';const st=performance.now(),du=600;let crid;function f(now){const p=Math.min((now-st)/du,1),e=1-Math.pow(1-p,3);ctx.clearRect(0,0,sz,sz);const dk=document.documentElement.getAttribute('data-theme')==='dark';ctx.beginPath();ctx.arc(cx,cy,rd,0,Math.PI*2);ctx.strokeStyle=dk?'rgba(255,255,255,0.08)':'rgba(15,23,42,0.06)';ctx.lineWidth=lw;ctx.stroke();const sa=-Math.PI/2,ta=Math.PI*2*e,a1=ta*hR,a2=ta*iR;if(a1>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa,sa+a1);const g=ctx.createLinearGradient(0,0,sz,sz);g.addColorStop(0,'#4f46e5');g.addColorStop(1,'#6366f1');ctx.strokeStyle=g;ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(a2>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa+a1,sa+a1+a2);const g=ctx.createLinearGradient(0,0,sz,sz);g.addColorStop(0,'#10b981');g.addColorStop(1,'#34d399');ctx.strokeStyle=g;ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(p<1)crid=requestAnimationFrame(f)}crid=requestAnimationFrame(f)}}
els.calcBody.classList.add('hidden');els.resultsPanel.classList.remove('hidden')}
els.calcButton?.addEventListener('click',calculate);els.amountInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();calculate()}});
els.resultsClose?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden')});
els.newCalc?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden');els.amountInput.value='';els.amountInput.focus()});
els.copyResult?.addEventListener('click',()=>{if(!state.lastResult)return;const{hon,iva,irpf,net,rate,irpfRate}=state.lastResult;const t=`Factura Honorarios\nHonorarios: ${fc(hon)}\n+IVA (${fr(rate)}%): ${fc(iva)}\n−IRPF (${fr(irpfRate)}%): ${fc(irpf)}\nLíquido: ${fc(net)}`;navigator.clipboard.writeText(t).then(()=>{const ex=document.querySelector('.toast');if(ex)ex.remove();const toast=document.createElement('div');toast.className='toast show';toast.textContent='✓ Honorarios copiados';document.body.appendChild(toast);setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>toast.remove(),300)},2500)})});
document.querySelectorAll('.faq-item .faq-question').forEach(b=>{b.addEventListener('click',()=>{const i=b.closest('.faq-item');if(!i)return;const o=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>{if(x!==i){x.classList.remove('open');const btn=x.querySelector('.faq-question');if(btn)btn.setAttribute('aria-expanded','false')}});if(o){i.classList.remove('open');b.setAttribute('aria-expanded','false')}else{i.classList.add('open');b.setAttribute('aria-expanded','true')}})});
});
</script>
