---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA RESICO — ISR e IVA para Régimen Simplificado de Confianza";
const description = "Calculadora de IVA e ISR para RESICO en México. Calcula tus impuestos mensuales bajo el Régimen Simplificado de Confianza con tasas de ISR del 1% al 2.5% e IVA al 16%.";

const faqItems = [
  { question: "¿Qué es el RESICO y quién puede tributar en este régimen?", answer: "El RESICO (Régimen Simplificado de Confianza) es un régimen fiscal mexicano para personas físicas con ingresos anuales de hasta $3.500.000 MXN. Aplica tasas de ISR reducidas (1% a 2.5%) sobre ingresos cobrados, sin necesidad de calcular deducciones. Pueden tributar quienes tengan actividad empresarial, servicios profesionales o arrendamiento.", display: true },
  { question: "¿Cuáles son las tasas de ISR en RESICO por tramo de ingresos?", answer: "Las tasas mensuales de ISR RESICO son progresivas: hasta $25.000 → 1,00%; de $25.001 a $50.000 → 1,10%; de $50.001 a $83.333 → 1,50%; de $83.334 a $208.333 → 2,00%; de $208.334 a $291.666 → 2,50%. Se aplican sobre los ingresos efectivamente cobrados.", display: true, formula: { base: "50.000 MXN", rate: "× 1,10%", result: "550 MXN ISR" } },
  { question: "¿Cómo se calcula el IVA en RESICO?", answer: "El IVA en RESICO se calcula igual que en cualquier régimen: 16% sobre el valor de los bienes o servicios. La diferencia es que en RESICO se puede optar por facturar con IVA incluido en ventas al público general. El IVA trasladado menos el IVA acreditable determina el IVA a pagar.", display: true, formula: { base: "50.000 MXN", rate: "× 16%", result: "8.000 MXN IVA" } },
  { question: "¿Qué pasa si supero el límite de $3.5 millones en RESICO?", answer: "Si tus ingresos anuales superan $3.500.000 MXN, el SAT te cambia automáticamente al Régimen de Actividad Empresarial y Profesional (régimen general) a partir del siguiente ejercicio fiscal. Perderás las tasas reducidas de ISR y deberás calcular deducciones.", display: true },
  { question: "¿Cuándo se presentan las declaraciones mensuales de RESICO?", answer: "Las declaraciones mensuales de ISR e IVA en RESICO se presentan a más tardar el día 17 del mes siguiente al que corresponda. Se utiliza la plataforma del SAT con el aplicativo de Declaraciones y Pagos. No se requiere presentar contabilidad electrónica.", display: true },
  { question: "¿Puedo deducir gastos en RESICO?", answer: "No. En RESICO no se aplican deducciones para el cálculo del ISR — la tasa se aplica directamente sobre los ingresos cobrados. Sin embargo, sí puedes acreditar el IVA de tus compras (IVA acreditable) contra el IVA que cobras a tus clientes, reduciendo así el IVA a pagar mensualmente.", display: true }
];

const resicoTable = [
  { ingreso: '10.000 MXN', tasa: '1,00%', isr: '100 MXN', iva: '1.600 MXN', total: '1.700 MXN', neto: '8.300 MXN' },
  { ingreso: '25.000 MXN', tasa: '1,00%', isr: '250 MXN', iva: '4.000 MXN', total: '4.250 MXN', neto: '20.750 MXN' },
  { ingreso: '40.000 MXN', tasa: '1,10%', isr: '440 MXN', iva: '6.400 MXN', total: '6.840 MXN', neto: '33.160 MXN' },
  { ingreso: '50.000 MXN', tasa: '1,10%', isr: '550 MXN', iva: '8.000 MXN', total: '8.550 MXN', neto: '41.450 MXN' },
  { ingreso: '75.000 MXN', tasa: '1,50%', isr: '1.125 MXN', iva: '12.000 MXN', total: '13.125 MXN', neto: '61.875 MXN' },
  { ingreso: '100.000 MXN', tasa: '2,00%', isr: '2.000 MXN', iva: '16.000 MXN', total: '18.000 MXN', neto: '82.000 MXN' },
  { ingreso: '200.000 MXN', tasa: '2,00%', isr: '4.000 MXN', iva: '32.000 MXN', total: '36.000 MXN', neto: '164.000 MXN' },
  { ingreso: '291.666 MXN', tasa: '2,50%', isr: '7.292 MXN', iva: '46.667 MXN', total: '53.958 MXN', neto: '237.708 MXN' },
];
---

<BaseLayout title={title} description={description} schemaType="WebSite" faqItems={faqItems} locale="es">
  <section class="hero" id="hero"><div class="hero-content"><h1 class="hero-title">Calculadora IVA <span class="gradient-text">RESICO</span></h1><p class="hero-subtitle">Calcula tu ISR e IVA mensual bajo el Régimen Simplificado de Confianza.<br class="hidden sm:inline" /> Tasas de ISR del 1% al 2,5% según tus ingresos. Sin deducciones.</p></div></section>

  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <div class="mb-6"><div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20"><svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span class="text-sm font-bold text-emerald-600 dark:text-emerald-400">RESICO — México</span></div></div>

        <div id="calcBody" class="space-y-6">
          <div><label for="amountInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><span>Ingresos mensuales cobrados</span></label><div class="relative"><input type="text" id="amountInput" class="w-full py-4 pl-5 pr-16 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 50.000" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-lg font-bold text-[var(--text-tertiary)]">MXN</span></div></div>

          <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-tertiary)]">
            <div class="flex items-center justify-between mb-2"><span class="text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)]">Tasa ISR RESICO</span><span class="font-display font-extrabold text-lg text-emerald-600 dark:text-emerald-400" id="rateDisplay">1,00%</span></div>
            <div class="w-full h-2 bg-[var(--bg-input)] rounded-full overflow-hidden"><div id="rateBar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full transition-all duration-500" style="width:20%"></div></div>
            <div class="flex justify-between mt-1"><span class="text-[10px] text-[var(--text-tertiary)]">1,00%</span><span class="text-[10px] text-[var(--text-tertiary)]">2,50%</span></div>
          </div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group"><span class="relative z-10">Calcular ISR e IVA RESICO</span><svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg><div class="btn-shine" aria-hidden="true"></div></button>
        </div>

        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between"><h3 class="font-display font-extrabold text-xl gradient-text">Desglose RESICO</h3><button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg><span>Modificar</span></button></div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm"><span class="text-sm font-semibold text-[var(--text-secondary)]">Ingresos cobrados</span><span class="font-display font-bold text-lg text-[var(--text-primary)]" id="rIngreso">$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-emerald-500/30 bg-emerald-500/5 shadow-sm"><span class="text-sm font-bold text-emerald-600 dark:text-emerald-400">ISR RESICO (<span id="rIsrRate">1,00</span>%)</span><span class="font-display font-bold text-lg text-emerald-600 dark:text-emerald-400" id="rIsr">−$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/30 bg-indigo-500/5 shadow-sm"><span class="text-sm font-bold text-indigo-600 dark:text-indigo-400">IVA trasladado (16%)</span><span class="font-display font-bold text-lg text-indigo-600 dark:text-indigo-400" id="rIva">$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-rose-500/30 bg-rose-500/5 shadow-sm"><span class="text-sm font-bold text-rose-600 dark:text-rose-400">Total impuestos</span><span class="font-display font-bold text-lg text-rose-600 dark:text-rose-400" id="rTotalImp">$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md"><span class="text-sm font-bold text-[var(--text-secondary)]">Ingreso neto</span><span class="font-display font-extrabold text-2xl gradient-text" id="rNeto">$0</span></div>
          </div>
          <div class="relative w-[170px] h-[170px] mx-auto flex items-center justify-center"><canvas id="breakdownCanvas" class="w-[170px] h-[170px] block drop-shadow-md" width="170" height="170"></canvas><div class="absolute flex flex-col items-center justify-center pointer-events-none"><span id="chartCenterPercent" class="font-display font-extrabold text-lg text-[var(--text-primary)] leading-none">$0</span><span id="chartCenterLabel" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mt-1">Neto</span></div></div>
          <div class="flex gap-3 pt-2"><button type="button" id="copyResult" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copiar</span></button><button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Nuevo</span></button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="calcular-iva"><div class="section-container"><h2 class="section-title">3 Perfiles de <span class="gradient-text">Contribuyente RESICO</span></h2><p class="section-subtitle">El RESICO aplica a diferentes tipos de personas físicas con actividades económicas en México</p><div class="methods-grid">
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div><span class="method-number">01</span></div><h3 class="method-title">Actividad empresarial RESICO</h3><p class="method-desc">Comerciantes, tiendas, restaurantes y negocios con ingresos anuales de hasta $3,5M MXN. ISR sobre ingresos cobrados sin deducciones complejas.</p><div class="method-formula"><span class="method-formula-var">50.000 MXN</span><span class="method-formula-op">×</span><span class="method-formula-var">1,10%</span><span class="method-formula-op">=</span><span class="method-formula-result">550 MXN ISR</span></div><div class="method-example"><span class="method-example-label">ISR</span><span>Tasa directa sobre ingresos = <strong>$550</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-remove"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div><span class="method-number">02</span></div><h3 class="method-title">Servicios profesionales RESICO</h3><p class="method-desc">Freelancers, consultores y profesionales independientes. ISR sobre honorarios cobrados. Si facturan a personas morales, les retienen IVA e ISR.</p><div class="method-formula"><span class="method-formula-var">75.000 MXN</span><span class="method-formula-op">×</span><span class="method-formula-var">1,50%</span><span class="method-formula-op">=</span><span class="method-formula-result">1.125 MXN ISR</span></div><div class="method-example"><span class="method-example-label">ISR</span><span>Tramo $50.001–$83.333 = <strong>$1.125</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-desglose"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div><span class="method-number">03</span></div><h3 class="method-title">Arrendamiento RESICO</h3><p class="method-desc">Personas físicas que rentan inmuebles. El RESICO permite tributar con tasas bajas sin calcular depreciación ni gastos. IVA aplica solo a locales comerciales.</p><div class="method-formula"><span class="method-formula-var">25.000 MXN</span><span class="method-formula-op">×</span><span class="method-formula-var">1,00%</span><span class="method-formula-op">=</span><span class="method-formula-result">250 MXN ISR</span></div><div class="method-example"><span class="method-example-label">ISR</span><span>Renta mensual con ISR mínimo = <strong>$250</strong></span></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="formula-iva"><div class="section-container"><h2 class="section-title">Fórmulas del <span class="gradient-text">ISR RESICO e IVA</span></h2><p class="section-subtitle">Las fórmulas simplificadas del Régimen Simplificado de Confianza para tus declaraciones mensuales</p><div class="formula-builder">
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-add"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/></svg><span>ISR RESICO mensual</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">Ingresos cobrados</span><span class="formula-builder-value">$50.000</span></div><span class="formula-builder-op">× Tasa</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">ISR a pagar</span><span class="formula-builder-value">$550</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Ingresos cobrados en el mes</span><span>$50.000,00</span></div><div class="formula-builder-breakdown-row"><span>Tasa RESICO (tramo $25.001–$50.000)</span><span>1,10%</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>ISR a pagar al SAT</span><span>$550,00</span></div></div></div>
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-remove"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg><span>IVA mensual RESICO</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">IVA trasladado</span><span class="formula-builder-value">$8.000</span></div><span class="formula-builder-op">−</span><div class="formula-builder-part"><span class="formula-builder-label">IVA acreditable</span><span class="formula-builder-value">$1.600</span></div><span class="formula-builder-op">=</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">IVA a pagar</span><span class="formula-builder-value">$6.400</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>IVA cobrado a clientes (16%)</span><span>$8.000,00</span></div><div class="formula-builder-breakdown-row"><span>IVA pagado en compras</span><span>−$1.600,00</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>IVA neto a pagar al SAT</span><span>$6.400,00</span></div></div></div>
  </div></div></section>

  <section class="content-section" id="como-funciona"><div class="section-container"><h2 class="section-title">¿Cómo Calcular tus <span class="gradient-text">Impuestos RESICO</span>?</h2><p class="section-subtitle">4 pasos para determinar tu ISR e IVA mensual en el Régimen Simplificado de Confianza</p><div class="walkthrough-steps">
    <div class="walkthrough-step" data-step="1"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">1</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">💰</div><h3 class="walkthrough-step-title">1. Suma tus ingresos cobrados</h3><p class="walkthrough-step-desc">En RESICO solo cuentan los ingresos efectivamente cobrados en el mes, no los facturados. Suma todos los pagos recibidos.</p><div class="walkthrough-mini-input"><span class="mini-input-label">Ingresos</span><div class="mini-input-box">50.000 <span class="mini-input-currency">MXN</span></div></div></div></div>
    <div class="walkthrough-step" data-step="2"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">2</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📊</div><h3 class="walkthrough-step-title">2. Identifica tu tramo de ISR</h3><p class="walkthrough-step-desc">Según tus ingresos mensuales, se aplica una tasa fija: 1,00%, 1,10%, 1,50%, 2,00% o 2,50%. No hay deducciones que calcular.</p></div></div>
    <div class="walkthrough-step" data-step="3"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">3</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">🧮</div><h3 class="walkthrough-step-title">3. Calcula ISR e IVA</h3><p class="walkthrough-step-desc">ISR = Ingresos × Tasa RESICO. IVA = IVA cobrado a clientes − IVA pagado en compras. Son dos cálculos independientes.</p></div></div>
    <div class="walkthrough-step" data-step="4"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">4</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">✅</div><h3 class="walkthrough-step-title">4. Presenta tu declaración</h3><p class="walkthrough-step-desc">Declara y paga antes del día 17 del mes siguiente en el portal del SAT. Sin contabilidad electrónica ni DIOT.</p><div class="walkthrough-mini-result"><div class="mini-result-row"><span>Ingresos</span><span class="mini-result-value">$50.000</span></div><div class="mini-result-row" style="color:var(--accent-emerald,#10b981)"><span>ISR RESICO 1,10%</span><span class="mini-result-value">−$550</span></div><div class="mini-result-row" style="color:var(--accent-indigo)"><span>IVA 16%</span><span class="mini-result-value">$8.000</span></div><div class="mini-result-row mini-result-total"><span>Neto</span><span class="mini-result-value"><strong>$49.450</strong></span></div></div></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="tabla-referencia"><div class="section-container section-container-wide"><h2 class="section-title">Tabla de <span class="gradient-text">ISR RESICO e IVA</span></h2><p class="section-subtitle">ISR e IVA mensual estimado por nivel de ingresos en el Régimen Simplificado de Confianza</p><div class="quick-table-wrapper"><div class="quick-table-container"><table class="quick-table"><thead><tr><th>Ingresos</th><th>Tasa ISR</th><th>ISR</th><th>IVA 16%</th><th>Total impuestos</th><th>Ingreso neto</th></tr></thead><tbody>{resicoTable.map((r) => (<tr><td><strong>{r.ingreso}</strong></td><td>{r.tasa}</td><td>{r.isr}</td><td>{r.iva}</td><td>{r.total}</td><td><strong>{r.neto}</strong></td></tr>))}</tbody></table></div></div></div></section>

  <section class="faq-section" id="faq"><div class="section-container"><h2 class="section-title">Preguntas sobre <span class="gradient-text">IVA RESICO</span></h2><p class="section-subtitle">Todo sobre el Régimen Simplificado de Confianza y el IVA en México</p><div class="faq-list" id="faqList">{faqItems.map((item, idx) => (<div class="faq-item" id={`faq${idx + 1}`}><button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button"><span>{item.question}</span><svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></button><div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}><p set:html={item.answer} />{item.formula && (<div class="faq-formula-mini"><div class="faq-formula-equation"><span class="faq-formula-var">{item.formula.base}</span><span class="faq-formula-op">×</span><span class="faq-formula-var">{item.formula.rate}</span><span class="faq-formula-op">=</span><span class="faq-formula-result">{item.formula.result}</span></div></div>)}</div></div>))}</div></div></section>
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded',()=>{const els={amountInput:document.getElementById('amountInput'),rateDisplay:document.getElementById('rateDisplay'),rateBar:document.getElementById('rateBar'),calcButton:document.getElementById('calcButton'),calcBody:document.getElementById('calcBody'),resultsPanel:document.getElementById('resultsPanel'),resultsClose:document.getElementById('resultsClose'),rIngreso:document.getElementById('rIngreso'),rIsrRate:document.getElementById('rIsrRate'),rIsr:document.getElementById('rIsr'),rIva:document.getElementById('rIva'),rTotalImp:document.getElementById('rTotalImp'),rNeto:document.getElementById('rNeto'),breakdownCanvas:document.getElementById('breakdownCanvas'),chartCenterPercent:document.getElementById('chartCenterPercent'),copyResult:document.getElementById('copyResult'),newCalc:document.getElementById('newCalc'),ambientCanvas:document.getElementById('ambientCanvas')};
let state={lastResult:null};
function getResicoRate(ing){if(ing<=25000)return 1.00;if(ing<=50000)return 1.10;if(ing<=83333.33)return 1.50;if(ing<=208333.33)return 2.00;return 2.50}
els.amountInput?.addEventListener('input',()=>{const v=pn(els.amountInput.value);if(!isNaN(v)&&v>0){const r=getResicoRate(v);els.rateDisplay.textContent=r.toFixed(2).replace('.',',')+'%';els.rateBar.style.width=((r-1)/1.5*80+20)+'%'}});
function initAmbient(){
  if(window.innerWidth<768||window.matchMedia('(prefers-reduced-motion: reduce)').matches){if(els.ambientCanvas)els.ambientCanvas.style.display='none';return;}
  const c=els.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0;function rs(){w=window.innerWidth;h=window.innerHeight;const d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];for(let i=0;i<Math.min(Math.floor(w*h/22000),50);i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn()}
if('requestIdleCallback' in window){requestIdleCallback(initAmbient,{timeout:2000});}else{setTimeout(initAmbient,1200);}
function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
function fm(v){return '$'+v.toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2})}
function calculate(){const raw=els.amountInput?.value.trim();if(!raw){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}const ing=pn(raw);if(isNaN(ing)||ing<=0){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}
const rate=getResicoRate(ing);const isr=ing*(rate/100);const iva=ing*0.16;const totalImp=isr+iva;const neto=ing-isr;state.lastResult={ing,rate,isr,iva,totalImp,neto};
els.rIngreso.textContent=fm(ing);els.rIsrRate.textContent=rate.toFixed(2).replace('.',',');els.rIsr.textContent='−'+fm(isr);els.rIva.textContent=fm(iva);els.rTotalImp.textContent=fm(totalImp);els.rNeto.textContent=fm(neto);
const cv=els.breakdownCanvas;if(cv){const ctx=cv.getContext('2d');if(ctx){const dp=window.devicePixelRatio||1,sz=170;cv.width=sz*dp;cv.height=sz*dp;ctx.scale(dp,dp);const cx=sz/2,cy=sz/2,rd=sz*.38,lw=16;const total=ing;const nR=neto/total,iR=isr/total;els.chartCenterPercent.textContent=fm(neto).replace('$','');const st=performance.now(),du=600;function f(now){const p=Math.min((now-st)/du,1),e=1-Math.pow(1-p,3);ctx.clearRect(0,0,sz,sz);const dk=document.documentElement.getAttribute('data-theme')==='dark';ctx.beginPath();ctx.arc(cx,cy,rd,0,Math.PI*2);ctx.strokeStyle=dk?'rgba(255,255,255,0.08)':'rgba(15,23,42,0.06)';ctx.lineWidth=lw;ctx.stroke();const sa=-Math.PI/2,ta=Math.PI*2*e,a1=ta*nR,a2=ta*iR;if(a1>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa,sa+a1);const g=ctx.createLinearGradient(0,0,sz,sz);g.addColorStop(0,'#4f46e5');g.addColorStop(1,'#6366f1');ctx.strokeStyle=g;ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(a2>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa+a1,sa+a1+a2);const g=ctx.createLinearGradient(0,0,sz,sz);g.addColorStop(0,'#10b981');g.addColorStop(1,'#34d399');ctx.strokeStyle=g;ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(p<1)requestAnimationFrame(f)}requestAnimationFrame(f)}}
els.calcBody.classList.add('hidden');els.resultsPanel.classList.remove('hidden')}
els.calcButton?.addEventListener('click',calculate);els.amountInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();calculate()}});
els.resultsClose?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden')});
els.newCalc?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden');els.amountInput.value='';els.amountInput.focus()});
els.copyResult?.addEventListener('click',()=>{if(!state.lastResult)return;const r=state.lastResult;const t=`RESICO — ISR e IVA\nIngresos: ${fm(r.ing)}\nISR ${r.rate.toFixed(2)}%: ${fm(r.isr)}\nIVA 16%: ${fm(r.iva)}\nNeto: ${fm(r.neto)}`;navigator.clipboard.writeText(t).then(()=>{const ex=document.querySelector('.toast');if(ex)ex.remove();const toast=document.createElement('div');toast.className='toast show';toast.textContent='✓ RESICO copiado';document.body.appendChild(toast);setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>toast.remove(),300)},2500)})});
document.querySelectorAll('.faq-item .faq-question').forEach(b=>{b.addEventListener('click',()=>{const i=b.closest('.faq-item');if(!i)return;const o=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>{if(x!==i){x.classList.remove('open');const btn=x.querySelector('.faq-question');if(btn)btn.setAttribute('aria-expanded','false')}});if(o){i.classList.remove('open');b.setAttribute('aria-expanded','false')}else{i.classList.add('open');b.setAttribute('aria-expanded','true')}})});
});
</script>
