---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config/site.json';
---

<BaseLayout
  title={`404 - Page Not Found — ${siteConfig.siteName}`}
  description="The page you are looking for does not exist or has been moved."
  noindex={true}
>
  <div class="max-w-lg mx-auto py-20 text-center">
    <div class="w-20 h-20 mx-auto rounded-3xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center font-display font-black text-4xl gradient-text mb-6">
      404
    </div>

    <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-[var(--text-primary)] mb-3">
      Página no encontrada
    </h1>
    <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-8 max-w-sm mx-auto">
      Lo sentimos, la página que buscas no existe o ha sido trasladada.
    </p>

    <a
      href="/"
      class="inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-bold text-sm shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:-translate-y-0.5 transition-all"
    >
      <span>&larr; Volver al inicio</span>
    </a>
  </div>
</BaseLayout>
