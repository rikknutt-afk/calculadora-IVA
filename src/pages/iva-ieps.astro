---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA e IEPS — Impuesto Especial en México";
const description = "Calculadora de IVA e IEPS para México. Calcula el Impuesto Especial sobre Producción y Servicios en bebidas alcohólicas, tabaco, bebidas azucaradas y combustibles, más IVA al 16%.";

const faqItems = [
  { question: "¿Qué es el IEPS y en qué productos se aplica?", answer: "El IEPS (Impuesto Especial sobre Producción y Servicios) es un impuesto indirecto mexicano que grava productos específicos: bebidas alcohólicas (26,5%–53%), tabaco (160%), bebidas azucaradas ($1,4523/litro), alimentos calóricos de alta densidad (8%), combustibles fósiles y plaguicidas. Se cobra además del IVA.", display: true },
  { question: "¿Cómo se calcula el IEPS junto con el IVA?", answer: "El IEPS se calcula sobre el precio base del producto. Luego, el IVA del 16% se calcula sobre la base MÁS el IEPS. Fórmula: Total = Base + IEPS + IVA. Donde IEPS = Base × Tasa IEPS, y IVA = (Base + IEPS) × 16%. El IVA grava la base con IEPS incluido.", display: true, formula: { base: "100 + 53 IEPS", rate: "× 16%", result: "24,48 IVA" } },
  { question: "¿Cuánto IEPS tiene una botella de tequila?", answer: "El tequila tiene más de 20° GL de alcohol, por lo que aplica una tasa de IEPS del 53%. Si una botella cuesta $200 MXN antes de impuestos: IEPS = 200 × 53% = $106. IVA = (200 + 106) × 16% = $48,96. Precio final: 200 + 106 + 48,96 = $354,96 MXN.", display: true, formula: { base: "200 MXN", rate: "× 53%", result: "106 MXN IEPS" } },
  { question: "¿Qué tasas de IEPS aplican a bebidas alcohólicas?", answer: "Las tasas de IEPS para alcohol dependen de la graduación: hasta 14° GL (cerveza, vino) → 26,5%; de 14° a 20° GL (licores suaves) → 30%; más de 20° GL (tequila, whisky, ron, vodka) → 53%. Las bebidas saborizadas con azúcar pagan $1,4523 por litro.", display: true },
  { question: "¿Por qué el tabaco tiene un IEPS del 160%?", answer: "México aplica un IEPS del 160% al tabaco como medida de salud pública para desincentivar el consumo. Además del IEPS ad valorem, se aplica una cuota fija de $0,6078 por cigarro. Esto convierte al tabaco en uno de los productos con mayor carga fiscal en México.", display: true },
  { question: "¿El IEPS se acredita como el IVA?", answer: "No. A diferencia del IVA, el IEPS no es acreditable para el consumidor final. Solo los productores e importadores pueden acreditar el IEPS de sus insumos contra el IEPS que trasladan. Los comercializadores no pueden acreditar IEPS pagado en sus compras.", display: true }
];

const iepsTable = [
  { producto: 'Cerveza (6-pack)', base: '120 MXN', tasa: '26,5%', ieps: '31,80 MXN', iva: '24,29 MXN', total: '176,09 MXN' },
  { producto: 'Vino tinto (750ml)', base: '250 MXN', tasa: '26,5%', ieps: '66,25 MXN', iva: '50,60 MXN', total: '366,85 MXN' },
  { producto: 'Tequila (750ml)', base: '300 MXN', tasa: '53%', ieps: '159,00 MXN', iva: '73,44 MXN', total: '532,44 MXN' },
  { producto: 'Whisky (750ml)', base: '500 MXN', tasa: '53%', ieps: '265,00 MXN', iva: '122,40 MXN', total: '887,40 MXN' },
  { producto: 'Cajetilla cigarros', base: '30 MXN', tasa: '160%', ieps: '48,00 MXN', iva: '12,48 MXN', total: '90,48 MXN' },
  { producto: 'Refresco (2L)', base: '18 MXN', tasa: '$2,90/L', ieps: '2,90 MXN', iva: '3,34 MXN', total: '24,24 MXN' },
  { producto: 'Bebida energética', base: '35 MXN', tasa: '25%', ieps: '8,75 MXN', iva: '7,00 MXN', total: '50,75 MXN' },
];
---

<BaseLayout title={title} description={description} schemaType="WebSite" faqItems={faqItems} locale="es">
  <section class="hero" id="hero"><div class="hero-content"><h1 class="hero-title">Calculadora <span class="gradient-text">IVA e IEPS</span></h1><p class="hero-subtitle">Calcula el Impuesto Especial sobre Producción y Servicios junto con el IVA.<br class="hidden sm:inline" /> Alcohol, tabaco, bebidas azucaradas, energéticos y combustibles en México.</p></div></section>

  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <div class="mb-6"><div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-500/20"><svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span class="text-sm font-bold text-amber-600 dark:text-amber-400">IEPS — México</span></div></div>

        <div id="calcBody" class="space-y-6">
          <div><label for="amountInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><span>Precio base del producto</span></label><div class="relative"><input type="text" id="amountInput" class="w-full py-4 pl-5 pr-16 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 300,00" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-lg font-bold text-[var(--text-tertiary)]">MXN</span></div></div>

          <div><label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Categoría IEPS</span></label>
          <div class="grid grid-cols-2 gap-2.5" role="radiogroup">
            <button type="button" class="ieps-btn active flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-amber-500 bg-amber-500/5 ring-3 ring-amber-500/15 shadow-sm transition-all" data-ieps="53" data-label="Licor >20° GL" role="radio" aria-checked="true"><span class="font-display font-bold text-base text-[var(--text-primary)]">53%</span><span class="text-[10px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wide">Licor >20° GL</span></button>
            <button type="button" class="ieps-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-amber-500 hover:-translate-y-0.5 shadow-sm transition-all" data-ieps="26.5" data-label="Cerveza/Vino" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">26,5%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Cerveza/Vino</span></button>
            <button type="button" class="ieps-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-amber-500 hover:-translate-y-0.5 shadow-sm transition-all" data-ieps="160" data-label="Tabaco" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">160%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Tabaco</span></button>
            <button type="button" class="ieps-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-amber-500 hover:-translate-y-0.5 shadow-sm transition-all" data-ieps="25" data-label="Energéticos" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">25%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Energéticos</span></button>
            <button type="button" class="ieps-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-amber-500 hover:-translate-y-0.5 shadow-sm transition-all" data-ieps="30" data-label="Licor 14°-20°" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">30%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Licor 14°-20°</span></button>
            <button type="button" class="ieps-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-amber-500 hover:-translate-y-0.5 shadow-sm transition-all" data-ieps="8" data-label="Alim. calóricos" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">8%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Alim. calóricos</span></button>
          </div></div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group"><span class="relative z-10">Calcular IEPS + IVA</span><svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg><div class="btn-shine" aria-hidden="true"></div></button>
        </div>

        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between"><p class="font-display font-extrabold text-xl gradient-text">Desglose IEPS + IVA</p><button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg><span>Modificar</span></button></div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm"><span class="text-sm font-semibold text-[var(--text-secondary)]">Precio base</span><span class="font-display font-bold text-lg text-[var(--text-primary)]" id="rBase">$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-amber-500/30 bg-amber-500/5 shadow-sm"><span class="text-sm font-bold text-amber-600 dark:text-amber-400">+ IEPS (<span id="rIepsRate">53</span>%)</span><span class="font-display font-bold text-lg text-amber-600 dark:text-amber-400" id="rIeps">+$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/30 bg-indigo-500/5 shadow-sm"><span class="text-sm font-bold text-indigo-600 dark:text-indigo-400">+ IVA 16% (sobre base + IEPS)</span><span class="font-display font-bold text-lg text-indigo-600 dark:text-indigo-400" id="rIva">+$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-rose-500/30 bg-rose-500/5 shadow-sm"><span class="text-sm font-bold text-rose-600 dark:text-rose-400">Carga fiscal total</span><span class="font-display font-bold text-lg text-rose-600 dark:text-rose-400" id="rCarga">$0</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md"><span class="text-sm font-bold text-[var(--text-secondary)]">Precio final</span><span class="font-display font-extrabold text-2xl gradient-text" id="rTotal">$0</span></div>
          </div>
          <div class="relative w-[170px] h-[170px] mx-auto flex items-center justify-center"><canvas id="breakdownCanvas" class="w-[170px] h-[170px] block drop-shadow-md" width="170" height="170"></canvas><div class="absolute flex flex-col items-center justify-center pointer-events-none"><span id="chartCenterPercent" class="font-display font-extrabold text-lg text-[var(--text-primary)] leading-none">$0</span><span id="chartCenterLabel" class="text-[11px] font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider mt-1">Impuestos</span></div></div>
          <div class="flex gap-3 pt-2"><button type="button" id="copyResult" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copiar</span></button><button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Nuevo</span></button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="calcular-iva"><div class="section-container"><h2 class="section-title">IEPS en <span class="gradient-text">3 Categorías Principales</span></h2><p class="section-subtitle">Los productos con mayor carga de IEPS en México y cómo se combinan con el IVA</p><div class="methods-grid">
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 2h8l4 10H4L8 2z"/><path d="M12 12v6"/><path d="M6 18h12"/></svg></div><span class="method-number">01</span></div><h3 class="method-title">Bebidas alcohólicas</h3><p class="method-desc">Cerveza y vino (≤14° GL): 26,5%. Licores medios (14°-20°): 30%. Destilados (>20° GL): 53%. El IVA se calcula sobre el precio con IEPS incluido.</p><div class="method-formula"><span class="method-formula-var">300 MXN</span><span class="method-formula-op">×</span><span class="method-formula-var">53% IEPS</span><span class="method-formula-op">=</span><span class="method-formula-result">159 MXN</span></div><div class="method-example"><span class="method-example-label">Tequila</span><span>300 + 159 + 73,44 IVA = <strong>$532,44</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-remove"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></div><span class="method-number">02</span></div><h3 class="method-title">Tabaco y cigarros</h3><p class="method-desc">IEPS del 160% ad valorem + cuota fija de $0,6078 por cigarro. Es la tasa más alta de IEPS. Un producto de $30 MXN acumula $48 MXN solo de IEPS.</p><div class="method-formula"><span class="method-formula-var">30 MXN</span><span class="method-formula-op">×</span><span class="method-formula-var">160%</span><span class="method-formula-op">=</span><span class="method-formula-result">48 MXN IEPS</span></div><div class="method-example"><span class="method-example-label">Cigarros</span><span>30 + 48 + 12,48 IVA = <strong>$90,48</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-desglose"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 6v6l4 2"/></svg></div><span class="method-number">03</span></div><h3 class="method-title">Bebidas azucaradas y energéticos</h3><p class="method-desc">Refrescos y jugos con azúcar: $1,4523/litro (cuota fija). Bebidas energéticas: 25%. Alimentos con alta densidad calórica (>275 kcal/100g): 8%.</p><div class="method-formula"><span class="method-formula-var">35 MXN</span><span class="method-formula-op">×</span><span class="method-formula-var">25%</span><span class="method-formula-op">=</span><span class="method-formula-result">8,75 MXN IEPS</span></div><div class="method-example"><span class="method-example-label">Energético</span><span>35 + 8,75 + 7 IVA = <strong>$50,75</strong></span></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="formula-iva"><div class="section-container"><h2 class="section-title">Fórmula del <span class="gradient-text">IEPS + IVA</span></h2><p class="section-subtitle">Cómo se acumulan el IEPS y el IVA en el precio final del producto</p><div class="formula-builder">
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-add"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/></svg><span>IEPS ad valorem (porcentaje)</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">Base</span><span class="formula-builder-value">$300</span></div><span class="formula-builder-op">+ IEPS 53%</span><div class="formula-builder-part"><span class="formula-builder-label">+ IVA 16%</span><span class="formula-builder-value">$73,44</span></div><span class="formula-builder-op">=</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Total</span><span class="formula-builder-value">$532,44</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Precio base</span><span>$300,00</span></div><div class="formula-builder-breakdown-row"><span>IEPS 53% sobre base</span><span>+$159,00</span></div><div class="formula-builder-breakdown-row"><span>IVA 16% sobre (base + IEPS)</span><span>+$73,44</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Precio final al consumidor</span><span>$532,44</span></div></div></div>
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-remove"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>Carga fiscal comparada</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">Sin IEPS</span><span class="formula-builder-value">$300 + IVA</span></div><span class="formula-builder-op">vs</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Con IEPS 53%</span><span class="formula-builder-value">$532,44</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Solo IVA 16%</span><span>$348,00 (16% impuestos)</span></div><div class="formula-builder-breakdown-row"><span>IEPS 53% + IVA 16%</span><span>$532,44 (77,5% impuestos)</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Diferencia fiscal por IEPS</span><span>+$184,44</span></div></div></div>
  </div></div></section>

  <section class="content-section" id="como-funciona"><div class="section-container"><h2 class="section-title">¿Cómo Calcular <span class="gradient-text">IEPS + IVA</span> en 4 Pasos?</h2><p class="section-subtitle">El proceso para determinar el precio final con IEPS e IVA de cualquier producto gravado</p><div class="walkthrough-steps">
    <div class="walkthrough-step" data-step="1"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">1</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">🏷️</div><h3 class="walkthrough-step-title">1. Identifica el precio base</h3><p class="walkthrough-step-desc">El precio base es el valor del producto antes de impuestos. Es el precio de fábrica o de importación sin IEPS ni IVA.</p><div class="walkthrough-mini-input"><span class="mini-input-label">Precio base</span><div class="mini-input-box">300,00 <span class="mini-input-currency">MXN</span></div></div></div></div>
    <div class="walkthrough-step" data-step="2"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">2</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📋</div><h3 class="walkthrough-step-title">2. Selecciona la categoría IEPS</h3><p class="walkthrough-step-desc">Elige la categoría del producto: alcohol por graduación, tabaco, bebidas azucaradas, energéticos o alimentos calóricos.</p></div></div>
    <div class="walkthrough-step" data-step="3"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">3</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">🧮</div><h3 class="walkthrough-step-title">3. Calcula IEPS primero, IVA después</h3><p class="walkthrough-step-desc">IEPS = Base × Tasa IEPS. Luego el IVA se calcula sobre (Base + IEPS). El orden es crucial: el IVA grava el precio con IEPS.</p></div></div>
    <div class="walkthrough-step" data-step="4"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">4</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">💰</div><h3 class="walkthrough-step-title">4. Obtén el precio final</h3><p class="walkthrough-step-desc">Precio final = Base + IEPS + IVA. Visualiza el desglose completo y la carga fiscal total sobre el producto.</p><div class="walkthrough-mini-result"><div class="mini-result-row"><span>Base</span><span class="mini-result-value">$300,00</span></div><div class="mini-result-row" style="color:#d97706"><span>+ IEPS 53%</span><span class="mini-result-value">+$159,00</span></div><div class="mini-result-row" style="color:var(--accent-indigo)"><span>+ IVA 16%</span><span class="mini-result-value">+$73,44</span></div><div class="mini-result-row mini-result-total"><span>Total</span><span class="mini-result-value"><strong>$532,44</strong></span></div></div></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="tabla-referencia"><div class="section-container section-container-wide"><h2 class="section-title">Tabla de <span class="gradient-text">IEPS + IVA</span> por Producto</h2><p class="section-subtitle">Desglose de IEPS e IVA para productos habituales gravados con impuesto especial en México</p><div class="quick-table-wrapper"><div class="quick-table-container"><table class="quick-table"><thead><tr><th>Producto</th><th>Base</th><th>Tasa IEPS</th><th>IEPS</th><th>IVA</th><th>Total</th></tr></thead><tbody>{iepsTable.map((r) => (<tr><td><strong>{r.producto}</strong></td><td>{r.base}</td><td>{r.tasa}</td><td>{r.ieps}</td><td>{r.iva}</td><td><strong>{r.total}</strong></td></tr>))}</tbody></table></div></div></div></section>

  <section class="faq-section" id="faq"><div class="section-container"><h2 class="section-title">Preguntas sobre <span class="gradient-text">IVA e IEPS</span></h2><p class="section-subtitle">Todo sobre el Impuesto Especial sobre Producción y Servicios y su interacción con el IVA</p><div class="faq-list" id="faqList">{faqItems.map((item, idx) => (<div class="faq-item" id={`faq${idx + 1}`}><button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button"><span>{item.question}</span><svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></button><div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}><p set:html={item.answer} />{item.formula && (<div class="faq-formula-mini"><div class="faq-formula-equation"><span class="faq-formula-var">{item.formula.base}</span><span class="faq-formula-op">×</span><span class="faq-formula-var">{item.formula.rate}</span><span class="faq-formula-op">=</span><span class="faq-formula-result">{item.formula.result}</span></div></div>)}</div></div>))}</div></div></section>
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded',()=>{const els={amountInput:document.getElementById('amountInput'),iepsButtons:document.querySelectorAll('.ieps-btn'),calcButton:document.getElementById('calcButton'),calcBody:document.getElementById('calcBody'),resultsPanel:document.getElementById('resultsPanel'),resultsClose:document.getElementById('resultsClose'),rBase:document.getElementById('rBase'),rIepsRate:document.getElementById('rIepsRate'),rIeps:document.getElementById('rIeps'),rIva:document.getElementById('rIva'),rCarga:document.getElementById('rCarga'),rTotal:document.getElementById('rTotal'),breakdownCanvas:document.getElementById('breakdownCanvas'),chartCenterPercent:document.getElementById('chartCenterPercent'),copyResult:document.getElementById('copyResult'),newCalc:document.getElementById('newCalc'),ambientCanvas:document.getElementById('ambientCanvas')};
let state={iepsRate:53,iepsLabel:'Licor >20° GL',lastResult:null};
els.iepsButtons?.forEach(btn=>{btn.addEventListener('click',()=>{els.iepsButtons.forEach(b=>{b.classList.remove('border-amber-500','bg-amber-500/5','ring-3','ring-amber-500/15');b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]');b.setAttribute('aria-checked','false')});btn.classList.add('border-amber-500','bg-amber-500/5','ring-3','ring-amber-500/15');btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]');btn.setAttribute('aria-checked','true');state.iepsRate=parseFloat(btn.dataset.ieps);state.iepsLabel=btn.dataset.label})});
function initAmbient(){
  if(window.innerWidth<768||window.matchMedia('(prefers-reduced-motion: reduce)').matches){if(els.ambientCanvas)els.ambientCanvas.style.display='none';return;}
  const c=els.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0;function rs(){w=window.innerWidth;h=window.innerHeight;const d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];for(let i=0;i<Math.min(Math.floor(w*h/22000),50);i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn()}
if('requestIdleCallback' in window){requestIdleCallback(initAmbient,{timeout:2000});}else{setTimeout(initAmbient,1200);}
function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
function fm(v){return '$'+v.toLocaleString('es-MX',{minimumFractionDigits:2,maximumFractionDigits:2})}
function calculate(){const raw=els.amountInput?.value.trim();if(!raw){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}const base=pn(raw);if(isNaN(base)||base<=0){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}
const ieps=base*(state.iepsRate/100);const iva=(base+ieps)*0.16;const carga=ieps+iva;const total=base+carga;state.lastResult={base,iepsRate:state.iepsRate,iepsLabel:state.iepsLabel,ieps,iva,carga,total};
els.rBase.textContent=fm(base);els.rIepsRate.textContent=state.iepsRate%1===0?state.iepsRate.toString():state.iepsRate.toFixed(1);els.rIeps.textContent='+'+fm(ieps);els.rIva.textContent='+'+fm(iva);els.rCarga.textContent=fm(carga);els.rTotal.textContent=fm(total);
els.chartCenterPercent.textContent=((carga/base)*100).toFixed(1)+'%';
const cv=els.breakdownCanvas;if(cv){const ctx=cv.getContext('2d');if(ctx){const dp=window.devicePixelRatio||1,sz=170;cv.width=sz*dp;cv.height=sz*dp;ctx.scale(dp,dp);const cx=sz/2,cy=sz/2,rd=sz*.38,lw=16;const bR=base/total,eR=ieps/total,vR=iva/total;const st=performance.now(),du=600;function f(now){const p=Math.min((now-st)/du,1),e=1-Math.pow(1-p,3);ctx.clearRect(0,0,sz,sz);const dk=document.documentElement.getAttribute('data-theme')==='dark';ctx.beginPath();ctx.arc(cx,cy,rd,0,Math.PI*2);ctx.strokeStyle=dk?'rgba(255,255,255,0.08)':'rgba(15,23,42,0.06)';ctx.lineWidth=lw;ctx.stroke();const sa=-Math.PI/2,ta=Math.PI*2*e,a1=ta*bR,a2=ta*eR,a3=ta*vR;if(a1>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa,sa+a1);ctx.strokeStyle='#4f46e5';ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(a2>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa+a1,sa+a1+a2);ctx.strokeStyle='#d97706';ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(a3>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa+a1+a2,sa+a1+a2+a3);ctx.strokeStyle='#10b981';ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(p<1)requestAnimationFrame(f)}requestAnimationFrame(f)}}
els.calcBody.classList.add('hidden');els.resultsPanel.classList.remove('hidden')}
els.calcButton?.addEventListener('click',calculate);els.amountInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();calculate()}});
els.resultsClose?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden')});
els.newCalc?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden');els.amountInput.value='';els.amountInput.focus()});
els.copyResult?.addEventListener('click',()=>{if(!state.lastResult)return;const r=state.lastResult;const t=`IEPS + IVA\nBase: ${fm(r.base)}\nIEPS ${r.iepsRate}% (${r.iepsLabel}): ${fm(r.ieps)}\nIVA 16%: ${fm(r.iva)}\nTotal: ${fm(r.total)}`;navigator.clipboard.writeText(t).then(()=>{const ex=document.querySelector('.toast');if(ex)ex.remove();const toast=document.createElement('div');toast.className='toast show';toast.textContent='✓ IEPS copiado';document.body.appendChild(toast);setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>toast.remove(),300)},2500)})});
document.querySelectorAll('.faq-item .faq-question').forEach(b=>{b.addEventListener('click',()=>{const i=b.closest('.faq-item');if(!i)return;const o=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>{if(x!==i){x.classList.remove('open');const btn=x.querySelector('.faq-question');if(btn)btn.setAttribute('aria-expanded','false')}});if(o){i.classList.remove('open');b.setAttribute('aria-expanded','false')}else{i.classList.add('open');b.setAttribute('aria-expanded','true')}})});
});
</script>
