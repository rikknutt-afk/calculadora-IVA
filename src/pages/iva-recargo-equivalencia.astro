---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Calculadora IVA Recargo de Equivalencia — IVA + Recargo para Comerciantes";
const description = "Calculadora de IVA con recargo de equivalencia para comerciantes minoristas en España. Calcula el IVA y el recargo (5,2%, 1,4% o 0,5%) de forma automática según el tipo de IVA.";

const faqItems = [
  { question: "¿Qué es el recargo de equivalencia?", answer: "El recargo de equivalencia es un régimen especial de IVA obligatorio para comerciantes minoristas persona física en España. El proveedor añade un recargo adicional al IVA en sus facturas: 5,2% con IVA 21%, 1,4% con IVA 10%, y 0,5% con IVA 4%. A cambio, el minorista no presenta declaraciones de IVA.", display: true },
  { question: "¿Quién está obligado a aplicar el recargo de equivalencia?", answer: "Están obligados los comerciantes minoristas que sean personas físicas (autónomos), vendan productos sin transformación al consumidor final, y que las ventas a consumidores finales superen el 80% de su facturación. Quedan excluidas las sociedades (SL, SA) y los comerciantes de vehículos, joyería, maquinaria o arte.", display: true },
  { question: "¿Cuáles son los tipos de recargo de equivalencia?", answer: "Los recargos están vinculados al tipo de IVA: IVA general 21% → Recargo 5,2%. IVA reducido 10% → Recargo 1,4%. IVA superreducido 4% → Recargo 0,5%. No existe recargo para operaciones exentas de IVA (0%).", display: true, formula: { base: "1.000 € base", rate: "× (21% + 5,2%)", result: "262 € total imp." } },
  { question: "¿El recargo de equivalencia se paga aparte del IVA?", answer: "No se paga aparte. El recargo lo cobra el proveedor junto con el IVA en sus facturas al minorista. Es decir, el proveedor factura: Base + IVA + Recargo. El minorista paga el recargo en sus compras pero NO presenta modelos de IVA (303, 390) ni lleva libro de IVA.", display: true },
  { question: "¿Puedo deducir el IVA si estoy en recargo de equivalencia?", answer: "No. Los comerciantes en recargo de equivalencia no pueden deducir el IVA soportado en sus compras, ya que no presentan declaración de IVA. El recargo de equivalencia sustituye la obligación de presentar el modelo 303 y liquidar el IVA trimestral.", display: true },
  { question: "¿Cómo se refleja el recargo de equivalencia en una factura?", answer: "La factura del proveedor debe desglosar: base imponible, tipo y cuota de IVA, y tipo y cuota de recargo de equivalencia, todo por separado. Ejemplo: Base 500 €, IVA 21% = 105 €, Recargo 5,2% = 26 €, Total = 631 €.", display: true, formula: { base: "500 €", rate: "IVA 105 + RE 26", result: "631 € total" } }
];

const recargoTable = [
  { base: '100 €', iva21: '21,00 €', re52: '5,20 €', total21: '126,20 €', iva10: '10,00 €', re14: '1,40 €', total10: '111,40 €' },
  { base: '250 €', iva21: '52,50 €', re52: '13,00 €', total21: '315,50 €', iva10: '25,00 €', re14: '3,50 €', total10: '278,50 €' },
  { base: '500 €', iva21: '105,00 €', re52: '26,00 €', total21: '631,00 €', iva10: '50,00 €', re14: '7,00 €', total10: '557,00 €' },
  { base: '1.000 €', iva21: '210,00 €', re52: '52,00 €', total21: '1.262,00 €', iva10: '100,00 €', re14: '14,00 €', total10: '1.114,00 €' },
  { base: '2.500 €', iva21: '525,00 €', re52: '130,00 €', total21: '3.155,00 €', iva10: '250,00 €', re14: '35,00 €', total10: '2.785,00 €' },
  { base: '5.000 €', iva21: '1.050,00 €', re52: '260,00 €', total21: '6.310,00 €', iva10: '500,00 €', re14: '70,00 €', total10: '5.570,00 €' },
  { base: '10.000 €', iva21: '2.100,00 €', re52: '520,00 €', total21: '12.620,00 €', iva10: '1.000,00 €', re14: '140,00 €', total10: '11.140,00 €' },
];
---

<BaseLayout title={title} description={description} schemaType="WebSite" faqItems={faqItems} locale="es">
  <section class="hero" id="hero"><div class="hero-content"><h1 class="hero-title">Calculadora <span class="gradient-text">Recargo de Equivalencia</span></h1><p class="hero-subtitle">Calcula el IVA y el recargo de equivalencia para comerciantes minoristas en España.<br class="hidden sm:inline" /> Selecciona el tipo de IVA y obtén el recargo automáticamente (5,2%, 1,4% o 0,5%).</p></div></section>

  <section class="calculator-section" id="calculator">
    <div class="relative w-full max-w-xl mx-auto z-10">
      <canvas class="ambient-canvas" id="ambientCanvas" aria-hidden="true"></canvas>
      <div class="glass-card p-6 sm:p-8 md:p-10 relative overflow-hidden transition-all duration-300">
        <div class="absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle_at_30%_40%,rgba(79,70,229,0.06)_0%,transparent_50%),radial-gradient(circle_at_70%_60%,rgba(236,72,153,0.05)_0%,transparent_50%)] pointer-events-none animate-[spin_25s_linear_infinite]" aria-hidden="true"></div>

        <div id="calcBody" class="space-y-6">
          <div><label for="amountInput" class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><span>Base imponible</span></label><div class="relative"><input type="text" id="amountInput" class="w-full py-4 pl-5 pr-12 bg-[var(--bg-input)] border-1.5 border-[var(--border-medium)] rounded-xl font-display text-2xl font-bold text-[var(--text-primary)] outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/15 shadow-sm transition-all placeholder:text-[var(--text-tertiary)] placeholder:opacity-50" placeholder="Ej: 1.000,00" inputmode="decimal" autocomplete="off" /><span class="absolute right-5 top-1/2 -translate-y-1/2 font-display text-xl font-bold text-[var(--text-tertiary)]">€</span></div></div>

          <div><label class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] mb-2"><svg class="w-4 h-4 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg><span>Tipo de IVA → Recargo automático</span></label>
          <div class="grid grid-cols-3 gap-2.5" role="radiogroup">
            <button type="button" class="rate-btn active flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-indigo-500 bg-indigo-500/5 ring-3 ring-indigo-500/15 shadow-sm transition-all" data-rate="21" data-recargo="5.2" role="radio" aria-checked="true"><span class="font-display font-bold text-base text-[var(--text-primary)]">21% + 5,2%</span><span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wide">General</span></button>
            <button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="10" data-recargo="1.4" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">10% + 1,4%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Reducido</span></button>
            <button type="button" class="rate-btn flex flex-col items-center justify-center p-3 rounded-xl border-1.5 border-[var(--border-subtle)] bg-[var(--bg-input)] hover:border-indigo-500 hover:-translate-y-0.5 shadow-sm transition-all" data-rate="4" data-recargo="0.5" role="radio" aria-checked="false"><span class="font-display font-bold text-base text-[var(--text-primary)]">4% + 0,5%</span><span class="text-[10px] font-semibold text-[var(--text-tertiary)] uppercase tracking-wide">Superreducido</span></button>
          </div></div>

          <button type="button" id="calcButton" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white font-bold text-base flex items-center justify-center gap-2 shadow-lg shadow-indigo-500/30 hover:shadow-indigo-500/45 hover:-translate-y-0.5 active:translate-y-0 relative overflow-hidden transition-all group"><span class="relative z-10">Calcular IVA + Recargo</span><svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg><div class="btn-shine" aria-hidden="true"></div></button>
        </div>

        <div id="resultsPanel" class="hidden space-y-6 animate-[fadeIn_0.4s_ease-out]">
          <div class="flex items-center justify-between"><h3 class="font-display font-extrabold text-xl gradient-text">IVA + Recargo Equivalencia</h3><button type="button" id="resultsClose" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 transition-colors shadow-sm"><svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg><span>Modificar</span></button></div>
          <div class="grid gap-3">
            <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-input)] shadow-sm"><span class="text-sm font-semibold text-[var(--text-secondary)]">Base imponible</span><span class="font-display font-bold text-lg text-[var(--text-primary)]" id="rBase">0 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/30 bg-indigo-500/5 shadow-sm"><span class="text-sm font-bold text-indigo-600 dark:text-indigo-400">IVA (<span id="rIvaRate">21</span>%)</span><span class="font-display font-bold text-lg text-indigo-600 dark:text-indigo-400" id="rIva">+0 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-purple-500/30 bg-purple-500/5 shadow-sm"><span class="text-sm font-bold text-purple-600 dark:text-purple-400">Recargo equivalencia (<span id="rRecargoRate">5,2</span>%)</span><span class="font-display font-bold text-lg text-purple-600 dark:text-purple-400" id="rRecargo">+0 €</span></div>
            <div class="flex items-center justify-between p-4 rounded-xl border border-indigo-500/40 bg-[var(--gradient-card)] shadow-md"><span class="text-sm font-bold text-[var(--text-secondary)]">Total factura</span><span class="font-display font-extrabold text-2xl gradient-text" id="rTotal">0 €</span></div>
          </div>
          <div class="relative w-[170px] h-[170px] mx-auto flex items-center justify-center"><canvas id="breakdownCanvas" class="w-[170px] h-[170px] block drop-shadow-md" width="170" height="170"></canvas><div class="absolute flex flex-col items-center justify-center pointer-events-none"><span id="chartCenterPercent" class="font-display font-extrabold text-2xl text-[var(--text-primary)] leading-none">0 €</span><span id="chartCenterLabel" class="text-[11px] font-bold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mt-1">Total</span></div></div>
          <div class="flex gap-3 pt-2"><button type="button" id="copyResult" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>Copiar</span></button><button type="button" id="newCalc" class="flex-1 py-3 px-4 rounded-xl border border-[var(--border-medium)] bg-[var(--bg-secondary)] text-sm font-semibold text-[var(--text-secondary)] hover:text-indigo-600 hover:border-indigo-500 flex items-center justify-center gap-2 shadow-sm transition-all"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>Nuevo</span></button></div>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section" id="calcular-iva"><div class="section-container"><h2 class="section-title">Recargo de Equivalencia en <span class="gradient-text">3 Escenarios</span></h2><p class="section-subtitle">Cómo afecta el recargo de equivalencia a diferentes tipos de comerciantes minoristas</p><div class="methods-grid">
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/></svg></div><span class="method-number">01</span></div><h3 class="method-title">Tienda de ropa (IVA 21%)</h3><p class="method-desc">El proveedor factura con IVA 21% + recargo 5,2%. El comerciante paga un 26,2% sobre la base. No presenta modelo 303 ni libros de IVA.</p><div class="method-formula"><span class="method-formula-var">1.000 €</span><span class="method-formula-op">×</span><span class="method-formula-var">26,2%</span><span class="method-formula-op">=</span><span class="method-formula-result">262 € impuestos</span></div><div class="method-example"><span class="method-example-label">Factura</span><span>1.000 + 210 IVA + 52 RE = <strong>1.262 €</strong></span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-remove"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></div><span class="method-number">02</span></div><h3 class="method-title">Tienda de alimentación (IVA mixto)</h3><p class="method-desc">Productos con IVA 10% (recargo 1,4%) y productos con IVA 4% (recargo 0,5%). Cada línea de factura tiene su propio tipo de recargo.</p><div class="method-formula"><span class="method-formula-var">500 € al 10%</span><span class="method-formula-op">+</span><span class="method-formula-var">200 € al 4%</span><span class="method-formula-op">=</span><span class="method-formula-result">Recargos mixtos</span></div><div class="method-example"><span class="method-example-label">Factura</span><span>IVA mixto + Recargo mixto por línea</span></div></div>
    <div class="method-card"><div class="method-icon-wrapper"><div class="method-icon method-icon-desglose"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div><span class="method-number">03</span></div><h3 class="method-title">Inicio o cese de actividad</h3><p class="method-desc">Al darse de alta en recargo de equivalencia, se debe regularizar el stock existente: presentar declaración-liquidación del IVA + recargo sobre las existencias. Al cesar, operación inversa.</p><div class="method-formula"><span class="method-formula-var">Stock 5.000 €</span><span class="method-formula-op">×</span><span class="method-formula-var">5,2%</span><span class="method-formula-op">=</span><span class="method-formula-result">260 € regularización</span></div><div class="method-example"><span class="method-example-label">Alta/Baja</span><span>Regularización por stock existente</span></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="formula-iva"><div class="section-container"><h2 class="section-title">Fórmula del <span class="gradient-text">IVA + Recargo</span></h2><p class="section-subtitle">Cómo se calculan el IVA y el recargo de equivalencia en una factura de proveedor</p><div class="formula-builder">
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-add"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/></svg><span>IVA general + Recargo 5,2%</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">Base</span><span class="formula-builder-value">1.000 €</span></div><span class="formula-builder-op">+ IVA + RE</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Total</span><span class="formula-builder-value">1.262 €</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Base imponible</span><span>1.000,00 €</span></div><div class="formula-builder-breakdown-row"><span>IVA 21%</span><span>+210,00 €</span></div><div class="formula-builder-breakdown-row"><span>Recargo equivalencia 5,2%</span><span>+52,00 €</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Total factura</span><span>1.262,00 €</span></div></div></div>
    <div class="formula-builder-card"><div class="formula-builder-header"><div class="formula-builder-badge formula-builder-badge-remove"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg><span>IVA reducido + Recargo 1,4%</span></div></div><div class="formula-builder-equation"><div class="formula-builder-part"><span class="formula-builder-label">Base</span><span class="formula-builder-value">500 €</span></div><span class="formula-builder-op">+ IVA + RE</span><div class="formula-builder-part formula-builder-part-result"><span class="formula-builder-label">Total</span><span class="formula-builder-value">557 €</span></div></div><div class="formula-builder-breakdown"><div class="formula-builder-breakdown-row"><span>Base imponible</span><span>500,00 €</span></div><div class="formula-builder-breakdown-row"><span>IVA 10%</span><span>+50,00 €</span></div><div class="formula-builder-breakdown-row"><span>Recargo equivalencia 1,4%</span><span>+7,00 €</span></div><div class="formula-builder-breakdown-row formula-builder-breakdown-total"><span>Total factura</span><span>557,00 €</span></div></div></div>
  </div></div></section>

  <section class="content-section" id="como-funciona"><div class="section-container"><h2 class="section-title">¿Cómo Funciona el <span class="gradient-text">Recargo de Equivalencia</span>?</h2><p class="section-subtitle">4 pasos para entender y calcular el recargo de equivalencia en tus facturas de compra</p><div class="walkthrough-steps">
    <div class="walkthrough-step" data-step="1"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">1</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">🏪</div><h3 class="walkthrough-step-title">1. Introduce la base imponible</h3><p class="walkthrough-step-desc">Escribe el importe neto de tu factura de proveedor (antes de IVA y recargo). Es el precio de los productos que compras para revender.</p><div class="walkthrough-mini-input"><span class="mini-input-label">Base</span><div class="mini-input-box">1.000,00 <span class="mini-input-currency">€</span></div></div></div></div>
    <div class="walkthrough-step" data-step="2"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">2</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">📊</div><h3 class="walkthrough-step-title">2. Selecciona el tipo de IVA</h3><p class="walkthrough-step-desc">El recargo se asigna automáticamente: 21% IVA → 5,2% recargo, 10% IVA → 1,4% recargo, 4% IVA → 0,5% recargo.</p></div></div>
    <div class="walkthrough-step" data-step="3"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">3</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">⚡</div><h3 class="walkthrough-step-title">3. Calcula al instante</h3><p class="walkthrough-step-desc">IVA y recargo se calculan por separado sobre la misma base. Total = Base + IVA + Recargo. Ambos aparecen desglosados en la factura.</p></div></div>
    <div class="walkthrough-step" data-step="4"><div class="walkthrough-step-connector"></div><div class="walkthrough-step-number">4</div><div class="walkthrough-step-content"><div class="walkthrough-step-icon">✅</div><h3 class="walkthrough-step-title">4. Sin declaraciones de IVA</h3><p class="walkthrough-step-desc">Con recargo de equivalencia, no presentas modelo 303, 390 ni libros de IVA. Tu proveedor ingresa el recargo a Hacienda por ti.</p><div class="walkthrough-mini-result"><div class="mini-result-row"><span>Base imponible</span><span class="mini-result-value">1.000,00 €</span></div><div class="mini-result-row" style="color:var(--accent-indigo)"><span>IVA 21%</span><span class="mini-result-value">+210,00 €</span></div><div class="mini-result-row" style="color:#9333ea"><span>Recargo 5,2%</span><span class="mini-result-value">+52,00 €</span></div><div class="mini-result-row mini-result-total"><span>Total</span><span class="mini-result-value"><strong>1.262,00 €</strong></span></div></div></div></div>
  </div></div></section>

  <section class="content-section content-section-alt" id="tabla-referencia"><div class="section-container section-container-wide"><h2 class="section-title">Tabla de <span class="gradient-text">IVA + Recargo</span></h2><p class="section-subtitle">Desglose de IVA y recargo de equivalencia para importes habituales de compra a proveedores</p><div class="quick-table-wrapper"><div class="quick-table-container"><table class="quick-table"><thead><tr><th>Base</th><th>IVA 21%</th><th>RE 5,2%</th><th>Total 21%</th><th>IVA 10%</th><th>RE 1,4%</th><th>Total 10%</th></tr></thead><tbody>{recargoTable.map((r) => (<tr><td><strong>{r.base}</strong></td><td>{r.iva21}</td><td>{r.re52}</td><td>{r.total21}</td><td>{r.iva10}</td><td>{r.re14}</td><td><strong>{r.total10}</strong></td></tr>))}</tbody></table></div></div></div></section>

  <section class="faq-section" id="faq"><div class="section-container"><h2 class="section-title">Preguntas sobre <span class="gradient-text">Recargo de Equivalencia</span></h2><p class="section-subtitle">Todo sobre el régimen especial de IVA para comerciantes minoristas en España</p><div class="faq-list" id="faqList">{faqItems.map((item, idx) => (<div class="faq-item" id={`faq${idx + 1}`}><button class="faq-question" id={`faqBtn${idx + 1}`} aria-expanded="false" aria-controls={`faqAnswer${idx + 1}`} type="button"><span>{item.question}</span><svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg></button><div class="faq-answer" id={`faqAnswer${idx + 1}`} role="region" aria-labelledby={`faqBtn${idx + 1}`}><p set:html={item.answer} />{item.formula && (<div class="faq-formula-mini"><div class="faq-formula-equation"><span class="faq-formula-var">{item.formula.base}</span><span class="faq-formula-op">×</span><span class="faq-formula-var">{item.formula.rate}</span><span class="faq-formula-op">=</span><span class="faq-formula-result">{item.formula.result}</span></div></div>)}</div></div>))}</div></div></section>
</BaseLayout>

<script is:inline>
document.addEventListener('DOMContentLoaded',()=>{const els={amountInput:document.getElementById('amountInput'),rateButtons:document.querySelectorAll('.rate-btn'),calcButton:document.getElementById('calcButton'),calcBody:document.getElementById('calcBody'),resultsPanel:document.getElementById('resultsPanel'),resultsClose:document.getElementById('resultsClose'),rBase:document.getElementById('rBase'),rIvaRate:document.getElementById('rIvaRate'),rIva:document.getElementById('rIva'),rRecargoRate:document.getElementById('rRecargoRate'),rRecargo:document.getElementById('rRecargo'),rTotal:document.getElementById('rTotal'),breakdownCanvas:document.getElementById('breakdownCanvas'),chartCenterPercent:document.getElementById('chartCenterPercent'),copyResult:document.getElementById('copyResult'),newCalc:document.getElementById('newCalc'),ambientCanvas:document.getElementById('ambientCanvas')};
let state={rate:21,recargo:5.2,lastResult:null};
els.rateButtons?.forEach(btn=>{btn.addEventListener('click',()=>{els.rateButtons.forEach(b=>{b.classList.remove('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15');b.classList.add('border-[var(--border-subtle)]','bg-[var(--bg-input)]');b.setAttribute('aria-checked','false')});btn.classList.add('border-indigo-500','bg-indigo-500/5','ring-3','ring-indigo-500/15');btn.classList.remove('border-[var(--border-subtle)]','bg-[var(--bg-input)]');btn.setAttribute('aria-checked','true');state.rate=parseFloat(btn.dataset.rate);state.recargo=parseFloat(btn.dataset.recargo)})});
!function(){const c=els.ambientCanvas;if(!c)return;const x=c.getContext('2d');if(!x)return;let w=0,h=0;function rs(){w=window.innerWidth;h=window.innerHeight;const d=window.devicePixelRatio||1;c.width=w*d;c.height=h*d;c.style.width=w+'px';c.style.height=h+'px';x.scale(d,d)}window.addEventListener('resize',rs);rs();const ps=[];for(let i=0;i<Math.min(Math.floor(w*h/22000),50);i++)ps.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.6,vy:(Math.random()-.5)*.6,r:Math.random()*2.5+1.5,ci:Math.floor(Math.random()*4)});function rn(){x.clearRect(0,0,w,h);const dk=document.documentElement.getAttribute('data-theme')==='dark';const cl=dk?['rgba(129,140,248,0.5)','rgba(192,132,252,0.45)','rgba(244,114,182,0.4)','rgba(52,211,153,0.35)']:['rgba(79,70,229,0.4)','rgba(124,58,237,0.35)','rgba(236,72,153,0.3)','rgba(16,185,129,0.3)'];ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;x.beginPath();x.arc(p.x,p.y,p.r,0,Math.PI*2);x.fillStyle=cl[p.ci];x.fill()});for(let i=0;i<ps.length;i++)for(let j=i+1;j<ps.length;j++){const dx=ps[i].x-ps[j].x,dy=ps[i].y-ps[j].y,ds=Math.sqrt(dx*dx+dy*dy);if(ds<125){const a=(1-ds/125)*(dk?.2:.14);x.beginPath();x.moveTo(ps[i].x,ps[i].y);x.lineTo(ps[j].x,ps[j].y);x.strokeStyle=dk?`rgba(129,140,248,${a})`:`rgba(79,70,229,${a})`;x.lineWidth=1;x.stroke()}}requestAnimationFrame(rn)}rn()}();
function pn(s){if(!s)return NaN;s=s.trim();const lc=s.lastIndexOf(','),ld=s.lastIndexOf('.');if(lc>ld)s=s.replace(/\./g,'').replace(',','.');else if(ld>lc)s=s.replace(/,/g,'');else if(lc!==-1)s=s.replace(',','.');return parseFloat(s)}
function fc(v){return v.toLocaleString('es-ES',{style:'currency',currency:'EUR',minimumFractionDigits:2,maximumFractionDigits:2})}
function fr(r){return r%1===0?r.toString():r.toFixed(1).replace('.',',')}
function calculate(){const raw=els.amountInput?.value.trim();if(!raw){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}const base=pn(raw);if(isNaN(base)||base<=0){els.amountInput?.classList.add('shake');setTimeout(()=>els.amountInput?.classList.remove('shake'),400);return}
const iva=base*(state.rate/100);const recargo=base*(state.recargo/100);const total=base+iva+recargo;state.lastResult={base,rate:state.rate,recargo:state.recargo,iva,recargoAmt:recargo,total};
els.rBase.textContent=fc(base);els.rIvaRate.textContent=fr(state.rate);els.rIva.textContent='+'+fc(iva);els.rRecargoRate.textContent=state.recargo.toFixed(1).replace('.',',');els.rRecargo.textContent='+'+fc(recargo);els.rTotal.textContent=fc(total);els.chartCenterPercent.textContent=fc(total).replace(/[^0-9,.]/g,'');
const cv=els.breakdownCanvas;if(cv){const ctx=cv.getContext('2d');if(ctx){const dp=window.devicePixelRatio||1,sz=170;cv.width=sz*dp;cv.height=sz*dp;ctx.scale(dp,dp);const cx=sz/2,cy=sz/2,rd=sz*.38,lw=16;const bR=base/total,iR=iva/total,rR=recargo/total;const st=performance.now(),du=600;function f(now){const p=Math.min((now-st)/du,1),e=1-Math.pow(1-p,3);ctx.clearRect(0,0,sz,sz);const dk=document.documentElement.getAttribute('data-theme')==='dark';ctx.beginPath();ctx.arc(cx,cy,rd,0,Math.PI*2);ctx.strokeStyle=dk?'rgba(255,255,255,0.08)':'rgba(15,23,42,0.06)';ctx.lineWidth=lw;ctx.stroke();const sa=-Math.PI/2,ta=Math.PI*2*e,a1=ta*bR,a2=ta*iR,a3=ta*rR;if(a1>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa,sa+a1);ctx.strokeStyle='#4f46e5';ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(a2>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa+a1,sa+a1+a2);ctx.strokeStyle='#6366f1';ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(a3>0){ctx.beginPath();ctx.arc(cx,cy,rd,sa+a1+a2,sa+a1+a2+a3);ctx.strokeStyle='#9333ea';ctx.lineWidth=lw;ctx.lineCap='round';ctx.stroke()}if(p<1)requestAnimationFrame(f)}requestAnimationFrame(f)}}
els.calcBody.classList.add('hidden');els.resultsPanel.classList.remove('hidden')}
els.calcButton?.addEventListener('click',calculate);els.amountInput?.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();calculate()}});
els.resultsClose?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden')});
els.newCalc?.addEventListener('click',()=>{els.resultsPanel.classList.add('hidden');els.calcBody.classList.remove('hidden');els.amountInput.value='';els.amountInput.focus()});
els.copyResult?.addEventListener('click',()=>{if(!state.lastResult)return;const r=state.lastResult;const t=`Recargo de Equivalencia\nBase: ${fc(r.base)}\nIVA ${fr(r.rate)}%: ${fc(r.iva)}\nRecargo ${r.recargo.toFixed(1)}%: ${fc(r.recargoAmt)}\nTotal: ${fc(r.total)}`;navigator.clipboard.writeText(t).then(()=>{const ex=document.querySelector('.toast');if(ex)ex.remove();const toast=document.createElement('div');toast.className='toast show';toast.textContent='✓ Recargo copiado';document.body.appendChild(toast);setTimeout(()=>{toast.classList.remove('show');setTimeout(()=>toast.remove(),300)},2500)})});
document.querySelectorAll('.faq-item .faq-question').forEach(b=>{b.addEventListener('click',()=>{const i=b.closest('.faq-item');if(!i)return;const o=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>{if(x!==i){x.classList.remove('open');const btn=x.querySelector('.faq-question');if(btn)btn.setAttribute('aria-expanded','false')}});if(o){i.classList.remove('open');b.setAttribute('aria-expanded','false')}else{i.classList.add('open');b.setAttribute('aria-expanded','true')}})});
});
</script>
